@inherits ProductComponent
<details class="report-box">
    <summary>@T("Uygunsuz içeriği raporla", "Report inappropriate content")</summary>
    <form @onsubmit="SubmitAsync" @onsubmit:preventDefault>
        <label>@T("Sorun nedir?", "What is the issue?")<textarea @bind="Reason" required minlength="8" maxlength="300"></textarea></label>
        <p>@T("Gerekçe sunucuda saklanır. Kişisel bilgi yazma. Aynı ağ adresinden gelen raporlar tek sayılır.", "The reason is stored on the server. Do not include personal information. Reports from the same network address count once.")</p>
        <button type="submit" disabled="@Busy">@T("Raporu gönder", "Send report")</button>
    </form>
    @if (!string.IsNullOrEmpty(Status)) { <p role="status">@Status</p> }
</details>
@code {
    [Parameter, EditorRequired] public string Kind { get; set; } = "";
    [Parameter, EditorRequired] public string TargetId { get; set; } = "";
    [Parameter] public string Endpoint { get; set; } = "reports";
    string Reason = "";

    /// <summary>Records an anonymous report; no moderation or review completion is asserted.</summary>
    Task SubmitAsync() => ExecuteAsync(async () => { await Api.PostAsync<ReportResponse>(Endpoint, new { kind = Kind, id = TargetId, reason = Reason }); Reason = ""; }, T("Raporun kaydedildi.", "Your report was recorded."));
}
