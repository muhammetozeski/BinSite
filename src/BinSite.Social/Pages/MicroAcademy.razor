@page "/mikro-akademi/"
@inherits CollaborationComponent
<PageTitle>@T("Mikro Akademi — Küçük ders, gerçek ilerleme", "Micro Academy")</PageTitle>
<PageSurface>
<div class="academy-page"><header><div class="topline"><LanguageSwitch /></div><h1>@T("Mikro Akademi", "Micro Academy")</h1><p>Create a short course with a quiz after each lesson.</p></header>
@if(Status.Length>0){<p class="status" role="status">@Status</p>}
<main><aside><h2>@T("Ders oluştur", "Create a course")</h2><form @onsubmit="CreateAsync" @onsubmit:preventDefault><label>@T("Ders adı", "Course title")<input @bind="Title" minlength="4" maxlength="140" required></label><label>@T("Öğrenme hedefi", "Learning goal")<textarea @bind="Intro" minlength="30" maxlength="1600" required></textarea></label><button type="submit" disabled="@Busy">@T("Yazar taslağı aç", "Create course")</button></form><button class="quiet" @onclick="ListAsync" disabled="@Busy">@T("Dersleri yenile", "Refresh courses")</button>@foreach(var item in Items){<button class="course-link" @onclick="()=>OpenAsync(item.Id)" disabled="@Busy">@item.Title</button>}@if(Current is null || Current.Mine==1&&Current.State.Status=="draft"){<details><summary>@T("3 editoryal bölüm taslağı", "Lesson ideas")</summary><p class="small">@T("Bunlar Türkçe özgün öğretim örnekleridir. Seçmek formu doldurur; yayımlanmış kullanıcı dersi değildir.","Choose an idea to fill the section form.")</p>@foreach(var draft in CollaborationEditorial.Lessons){<button class="course-link" @onclick="()=>UseDraft(draft)">@draft.Title</button>}</details>}</aside><section>
@if(Current is null){<div class="sample"><span class="eyebrow">@T("EDİTORYAL ÖRNEK", "EXAMPLE")</span><h2>@LessonTitle</h2><p>@LessonText</p></div>}
else{<h2>@Current.Title</h2><p>@Current.State.Intro</p><div class="toolbar"><span>@Current.State.StudentCount @T("kayıtlı kimlik", "learners") · @Current.State.Completed.Count / @Current.State.Lessons.Count @T("tamamlanan bölüm", "completed sections")</span><button class="quiet" @onclick="ReloadAsync" disabled="@Busy">@T("Yenile", "Refresh")</button><button class="quiet" @onclick="()=>CopyAsync(SpaceLink(Kind,Current.Id))">@T("Ders bağlantısı", "Copy course link")</button></div>@if(CopyFallback is not null){<input readonly value="@CopyFallback">}
@if(Current.State.Status=="draft"&&Current.Mine==1){<section class="author-panel"><h3>@T("Dersin henüz taslak", "Add a section")</h3><p class="small">@T("Bölümler eklendikten sonra yayımla. Yayımlanan dersin soruları bu sürümde değiştirilmez; öğrenci ilerlemesi aynı içerik üzerinde kalır.","Add sections, then publish. Published questions cannot be changed.")</p><form @onsubmit="AddLessonAsync" @onsubmit:preventDefault><label>@T("Bölüm başlığı", "Section title")<input @bind="LessonTitle" minlength="4" maxlength="100" required></label><label>@T("Özgün ders metni", "Lesson text")<textarea @bind="LessonText" minlength="60" maxlength="4000" required></textarea></label><label>@T("Kontrol sorusu", "Quiz question")<input @bind="Question" minlength="8" maxlength="300" required></label><div class="options">@for(var index=0;index<4;index++){var choice=index;<label>@(choice+1). @T("seçenek", "option")<input @bind="Options[choice]" minlength="1" maxlength="200" required></label>}</div><label>@T("Doğru seçenek", "Correct option")<select @bind="Correct">@for(var index=0;index<4;index++){<option value="@index">@(index+1)</option>}</select></label><label>@T("Doğru yanıttan sonra görünen açıklama", "Explanation shown after a correct answer")<textarea @bind="Explanation" minlength="20" maxlength="1200" required></textarea></label><button type="submit" disabled="@(Busy || Current.State.Lessons.Count >= 12)">@T("Bölümü taslağa ekle", "Add section")</button></form><button class="publish" disabled="@(Busy||Current.State.Lessons.Count==0)" @onclick="PublishAsync">@T("Dersi yayımla", "Publish course")</button></section>}
@if(Current.State.Status=="published"&&Current.MemberId is null){<form class="enroll" @onsubmit="EnrollAsync" @onsubmit:preventDefault><label>@T("Öğrenci takma adın", "Your name")<input @bind="Name" minlength="2" maxlength="24" required></label><button type="submit" disabled="@Busy">@T("Öğrenmeye katıl", "Enroll to learn")</button></form>}
@foreach(var lesson in Current.State.Lessons){var complete=Current.State.Completed.Contains(lesson.Id);var lessonIndex=Current.State.Lessons.IndexOf(lesson);var unlocked=lessonIndex==0||Current.State.Completed.Contains(Current.State.Lessons[lessonIndex-1].Id);<article class="lesson"><span class="badge">@(complete?T("TAMAMLANDI", "COMPLETED"):T("BÖLÜM", "SECTION"))</span><h3>@lesson.Title</h3><p>@lesson.Text</p><h4>@lesson.Question</h4>@for(var index=0;index<lesson.Options.Length;index++){var choice=index;<label class="answer"><input type="radio" name="@lesson.Id" value="@choice" disabled="@(Busy||Current.MemberId is null||Current.State.Status!="published"||complete||!unlocked)" checked="@(Choices.GetValueOrDefault(lesson.Id,-1)==choice)" @onchange="()=>Choices[lesson.Id]=choice"> @lesson.Options[choice]</label>}@if(Current.Mine==1&&lesson.Answer is not null){<p class="small">@T("Yazarın cevap anahtarı:", "Correct answer:") @lesson.Options[lesson.Answer.Value]</p>}@if(Current.MemberId is not null&&Current.State.Status=="published"&&!complete){<button disabled="@(Busy||!unlocked||!Choices.ContainsKey(lesson.Id))" @onclick="()=>AnswerAsync(lesson.Id)">@T("Yanıtı sunucuda kontrol et", "Check answer")</button>}@if(Current.MemberId is not null && !unlocked && !complete){<p class="small">Complete the previous lesson before answering this quiz.</p>}@if(lesson.Explanation is not null){<p class="explanation">@lesson.Explanation</p>}</article>}
<ReportBox Kind="@Kind" TargetId="@Current.Id" Endpoint="collaboration/reports" />}
</section></main><footer><CollaborationRules /></footer></div>
</PageSurface>
@code{
 const string Kind="mikro-akademi";[SupplyParameterFromQuery(Name="alan")]public string? Area{get;set;}Space<AcademyState>? Current;List<SpaceItem> Items=[];string Title="",Intro="",Name="",LessonTitle="",LessonText="",Question="",Explanation="";string[] Options=["","","",""];int Correct;readonly Dictionary<string,int> Choices=[];
 /// <summary>Loads real courses and an optional shared course.</summary>
 protected override Task OnParametersSetAsync()=>ExecuteAsync(async()=>{if(LessonTitle.Length==0)UseDraft(CollaborationEditorial.Lessons[0]);await LoadListAsync();if(Area is not null)await LoadAsync(Area);});
 /// <summary>Retrieves bounded course headers.</summary>
 async Task LoadListAsync()=>Items=(await DirectoryAsync(Kind)).Items;
 /// <summary>Refreshes course discovery.</summary>
 Task ListAsync()=>ExecuteAsync(LoadListAsync);
 /// <summary>Reads the current learner-filtered lesson state.</summary>
 async Task LoadAsync(string id){Current=await ReadSpaceAsync<AcademyState>(Kind,id);await RememberAsync(Kind,id);}
 /// <summary>Opens a selected course.</summary>
 Task OpenAsync(string id)=>ExecuteAsync(()=>LoadAsync(id));
 /// <summary>Refreshes the current course and completion state.</summary>
 Task ReloadAsync()=>Current is null?Task.CompletedTask:OpenAsync(Current.Id);
 /// <summary>Creates an unpublished author-owned course.</summary>
 Task CreateAsync()=>ExecuteAsync(async()=>{Current=await CreateSpaceAsync<AcademyState>(Kind,new{title=Title,intro=Intro});await RememberAsync(Kind,Current.Id);Title=Intro="";await LoadListAsync();});
 /// <summary>Copies an authored editorial template into an editable section draft.</summary>
 void UseDraft(LessonDraft draft){LessonTitle=draft.Title;LessonText=draft.Text;Question=draft.Question;Options=[..draft.Options];Correct=draft.Answer;Explanation=draft.Explanation;}
 /// <summary>Submits a lesson and answer key to the author-authorized server mutation.</summary>
 Task AddLessonAsync()=>ExecuteAsync(async()=>{if(Current is null)return;Current=await ActionAsync(Kind,Current,"lesson",new{title=LessonTitle,text=LessonText,question=Question,options=Options,answer=Correct,explanation=Explanation});LessonTitle=LessonText=Question=Explanation="";Options=["","","",""];Correct=0;});
 /// <summary>Publishes a nonempty draft and freezes its question content.</summary>
 Task PublishAsync()=>ExecuteAsync(async()=>{if(Current is not null)Current=await ActionAsync(Kind,Current,"publish",new{});});
 /// <summary>Creates this anonymous identity's learner progress record.</summary>
 Task EnrollAsync()=>ExecuteAsync(async()=>{if(Current is not null)Current=await ActionAsync(Kind,Current,"enroll",new{name=Name});});
 /// <summary>Checks a selected answer server-side and updates progress only if the answer and prerequisite pass.</summary>
 Task AnswerAsync(string lessonId)=>ExecuteAsync(async()=>{if(Current is null)return;Current=await ActionAsync(Kind,Current,"answer",new{lessonId,choice=Choices.GetValueOrDefault(lessonId,-1)});var correct=Current.Feedback is {} feedback&&feedback.TryGetProperty("correct",out var value)&&value.GetBoolean();Status=correct?T("Doğru yanıt; bölüm tamamlandı.","Correct."):T("Yanıt eşleşmedi. Ders metnini yeniden okuyup deneyebilirsin.","That answer did not match. Revisit the lesson and try again.");});
}
