@page "/birlikte-bil/"
@inherits CollaborationComponent
<PageTitle>@T("Birlikte Bil — Bilgi bayrağını devret", "Knowledge Relay — Pass the knowledge flag")</PageTitle>
<PageSurface>
<div class="relay-page"><header><div class="topline"><LanguageSwitch /></div><h1>@T("Birlikte Bil", "Knowledge Relay")</h1><p>Solve three challenges as a team, passing the turn after each answer.</p></header>
@if(Status.Length>0){<p class="status" role="status">@Status</p>}
<main>
@if(Current is null){<div class="intro-grid"><section class="setup"><h2>@T("Takımı başlat", "Start a team")</h2><form @onsubmit="CreateAsync" @onsubmit:preventDefault><label>@T("Oda adı", "Room title")<input @bind="Title" required minlength="4" maxlength="140"></label><label>@T("Takma adın", "Your name")<input @bind="Name" required minlength="2" maxlength="24"></label><button type="submit" disabled="@Busy">@T("İlk bayrağı al", "Create team")</button></form><details><summary>@T("Davet bağlantısıyla geliyorum", "I have an invitation link")</summary><form @onsubmit="OpenLinkAsync" @onsubmit:preventDefault><label>@T("Bağlantı", "Link")<input @bind="ExistingLink" type="url" required></label><button type="submit" class="quiet" disabled="@Busy">@T("Takımı aç", "Open team")</button></form></details></section><details class="guide"><summary>How to play</summary><ol><li>@T("2–6 tarayıcı kimliğiyle aynı odaya katılın.","Invite one to five teammates.")</li><li>@T("Bayrak kimdeyse o kişi güncel soruya yanıt verebilir.","Only the current flag holder may answer the current question.")</li><li>@T("Doğru yanıttan sonra başka bir kişiye devretmeden devam edilemez.","After a correct answer, progress waits until the flag is passed to someone else.")</li><li>@T("Diğer kişi daha sonra gelip kendi aşamasını tamamlayabilir.","The next person can return later to complete their stage.")</li></ol><p>@T("Üç aşama: açık bir çarpma sorusu, ipuçlu Türkçe kelime çözümü ve koordinat yürüyüşü. Sorular her oda için yeniden üretilir. Yanıtlar ve gelecek aşamalar sunucu görünümünden filtrelenir.","Solve a multiplication, a word puzzle and a map challenge.")</p></details></div>}
else{<section class="room-heading"><h2>@Current.Title</h2><div class="toolbar"><button class="quiet" disabled="@Busy" @onclick="ReloadAsync">@T("Takımı yenile", "Refresh team")</button><button class="quiet" @onclick="()=>CopyAsync(SpaceLink(Kind,Current.Id))">@T("Davet et", "Copy invite link")</button></div>@if(CopyFallback is not null){<input readonly value="@CopyFallback">}<div class="team-roster">@foreach(var participant in Current.State.Members){<article class="@(participant.Id==Current.State.Runner?"holder":"")"><strong>@participant.Name</strong>@if(participant.Id==Current.State.Runner){<span>@T("BAYRAK ONDA", "HOLDS THE FLAG")</span>}</article>}</div>@if(Current.MemberId is null){<form @onsubmit="JoinAsync" @onsubmit:preventDefault><label>@T("Takma adın", "Your name")<input @bind="Name" required minlength="2" maxlength="24"></label><button type="submit" disabled="@Busy">@T("Takıma katıl", "Join team")</button></form>}</section><div class="progress-track">@for(var index=0;index<3;index++){<span class="@(Current.State.History.Any(step=>step.Stage==index)?"done":"")">@T("Aşama", "Stage") @(index+1)</span>}</div>
@if(Current.State.Status=="finished"){<section class="finish"><button @onclick="NewTeamAsync">Play again</button><h2>@T("Üç aşama tamamlandı!", "All three stages are complete!")</h2><p>@T("Takımın bayrağı paylaşarak sonuca ulaştı. Yeni bir odada farklı sırayla deneyebilirsiniz.","Your team reached the end by passing responsibility. Try a different order in a new room.")</p></section>}
else if(Current.State.Status=="handoff"){<section class="handoff"><h2>@T("Doğru yanıt. Şimdi bayrağı devret.", "Correct. Now pass the flag.")</h2><p>@T("Aynı kişi iki aşamayı arka arkaya çözemiyor. Devri sunucu kaydeder; diğer kişi daha sonra devam edebilir.","Choose another teammate to continue. They can return later.")</p>@if(Current.MemberId==Current.State.Runner){<form @onsubmit="HandoffAsync" @onsubmit:preventDefault><label>@T("Sıradaki takım arkadaşı", "Next teammate")<select @bind="NextMember" required><option value="">@T("Bir kişi seç", "Choose someone")</option>@foreach(var participant in Current.State.Members.Where(item=>item.Id!=Current.MemberId)){<option value="@participant.Id">@participant.Name</option>}</select></label><button type="submit" disabled="@Busy">@T("Bayrağı devret", "Pass flag")</button></form>}else{<p>@Handle(Current.State.Members,Current.State.Runner) @T("devri seçiyor.","is choosing the handoff.")</p>}</section>}
else{<section class="question-card"><span>@T("AŞAMA", "STAGE") @(Current.State.Stage+1)/3</span><h2>@Current.State.Question</h2>@if(Current.State.Members.Count<2){<p>@T("Başlamak için en az bir takım arkadaşın daha katılmalı.","At least one more teammate must join before answering.")</p>}@if(Current.MemberId==Current.State.Runner){<form @onsubmit="AnswerAsync" @onsubmit:preventDefault><label>@T("Yanıtın", "Your answer")<input @bind="Answer" required maxlength="80" autocomplete="off"></label><button type="submit" disabled="@(Busy||Current.State.Members.Count<2)">@T("Sunucuda kontrol et", "Check answer")</button></form>}else{<p>@T("Şu anda yanıt hakkı:","Current answer holder:") @Handle(Current.State.Members,Current.State.Runner)</p>}</section>}
<section class="history"><h3>@T("Bayrağın izi", "Flag history")</h3>@foreach(var step in Current.State.History){<p>@(step.Stage+1). @T("aşama", "stage") · @Handle(Current.State.Members,step.MemberId) · @DateLabel(step.At)</p>}</section><ReportBox Kind="@Kind" TargetId="@Current.Id" Endpoint="collaboration/reports" />}
</main><footer><p>@T("Odalar gezilebilir bir listede yer almaz; bağlantıyı bilenler kontenjan dolana kadar katılabilir. Eşzamanlı çevrimiçi olma veya otomatik bildirim hizmeti sunulmaz.","Use Refresh to see your team updates.")</p><CollaborationRules /></footer></div>
</PageSurface>
@code{
 const string Kind="birlikte-bil";[SupplyParameterFromQuery(Name="alan")]public string? Area{get;set;}Space<RelayState>? Current;string Title="",Name="",ExistingLink="",Answer="",NextMember="";
 /// <summary>Reads only an explicitly shared asynchronous team room.</summary>
 protected override Task OnParametersSetAsync()=>Area is null?Task.CompletedTask:OpenAsync(Area);
 /// <summary>Retrieves only the current question and actual relay state.</summary>
 async Task LoadAsync(string id){Current=await ReadSpaceAsync<RelayState>(Kind,id);await RememberAsync(Kind,id);}
 /// <summary>Opens a shared team room.</summary>
 Task OpenAsync(string id)=>ExecuteAsync(()=>LoadAsync(id));
 /// <summary>Refreshes actual holder and stage state.</summary>
 async Task NewTeamAsync(){Current=null;Area=null;Title=Answer=NextMember=Status="";CopyFallback=null;await Javascript.InvokeVoidAsync("binSiteSocial.replaceUrl",new Uri(new Uri(Navigation.BaseUri),Kind+"/").AbsoluteUri);}
 Task ReloadAsync()=>Current is null?Task.CompletedTask:OpenAsync(Current.Id);
 /// <summary>Creates three generated server-checked stages and assigns the first flag.</summary>
 Task CreateAsync()=>ExecuteAsync(async()=>{Current=await CreateSpaceAsync<RelayState>(Kind,new{title=Title,name=Name});await RememberAsync(Kind,Current.Id);});
 /// <summary>Joins one of six available roster positions.</summary>
 Task JoinAsync()=>ExecuteAsync(async()=>{if(Current is not null)Current=await ActionAsync(Kind,Current,"join",new{name=Name});});
 /// <summary>Checks one answer only for the authoritative current flag holder.</summary>
 Task AnswerAsync()=>ExecuteAsync(async()=>{if(Current is null)return;Current=await ActionAsync(Kind,Current,"answer",new{answer=Answer});var correct=Current.Feedback is {} feedback&&feedback.TryGetProperty("correct",out var value)&&value.GetBoolean();Status=correct&&Current.State.Status=="finished"?"Team challenge complete!":correct?T("Aşama tamamlandı. Bayrağı başka kişiye devret.","Stage complete. Pass the flag to someone else."):T("Yanıt eşleşmedi. Sorudaki koşulları birlikte yeniden okuyun.","That answer did not match. Recheck the question conditions together.");if(correct)Answer="";});
 /// <summary>Persists a handoff to a different joined member.</summary>
 Task HandoffAsync()=>ExecuteAsync(async()=>{if(Current is not null){Current=await ActionAsync(Kind,Current,"handoff",new{memberId=NextMember});NextMember="";}});
 /// <summary>Accepts only same-origin links with an explicit workspace identifier.</summary>
 Task OpenLinkAsync()=>ExecuteAsync(async()=>{if(!Uri.TryCreate(ExistingLink,UriKind.Absolute,out var url)||url.GetLeftPart(UriPartial.Authority)!=new Uri(Navigation.BaseUri).GetLeftPart(UriPartial.Authority)){HasError=true;Status="Paste a Knowledge Relay invitation from this site.";return;}var pair=url.Query.TrimStart('?').Split('&').Select(item=>item.Split('=',2)).FirstOrDefault(item=>item.Length==2&&item[0]=="alan");if(pair is null||!Guid.TryParse(Uri.UnescapeDataString(pair[1]),out _)){HasError=true;Status="This link does not contain a team. Paste the complete invitation.";return;}await LoadAsync(Uri.UnescapeDataString(pair[1]));});
}
