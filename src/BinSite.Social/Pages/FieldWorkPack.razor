@page "/field-work-pack/"
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@inject IJSRuntime Javascript
@inject ILogger<FieldWorkPack> Logger
@inject SocialApi Api
@inject NavigationManager Navigation
@implements IAsyncDisposable

<PageTitle>Field Work Pack — Work orders and evidence</PageTitle>
<PageSurface>
<main class="field-work">
    <header><a href="/">Product directory</a><h1>Field Work Pack</h1><p>Record work, measurements and photos, then create a handoff report.</p></header>
    <nav aria-label="Workspace sections">
        <button class="@(View == "orders" ? "selected" : "")" @onclick='() => View = "orders"' disabled="@Busy">Work orders (@Workspace.Orders.Count)</button>
        <button class="@(View == "templates" ? "selected" : "")" @onclick='() => View = "templates"' disabled="@Busy">Checklist library (@Workspace.Templates.Count)</button>
        <button class="@(View == "cloud" ? "selected" : "")" @onclick="OpenCloud" disabled="@Busy">Sharing</button>
        <button class="@(View == "help" ? "selected" : "")" @onclick='() => View = "help"' disabled="@Busy">Help</button>
    </nav>
    <p class="notice" role="status" aria-live="polite">@Message</p>
    @if (!string.IsNullOrWhiteSpace(StorageMessage)) { <p class="storage">@StorageMessage</p> }
    <details class="project-tools"><summary>Project files and offline use</summary><div class="toolbar">
        <button disabled="@(Busy || Module is null)" @onclick="SaveNow">Save now</button>
        <button disabled="@(Busy || Module is null)" @onclick="NewWorkspace">New workspace</button>
        <button disabled="@(Busy || Module is null)" @onclick="ExportProject">Save project file</button>
        <label class="file-button">Open project file<InputFile OnChange="ImportProject" accept="application/json,.json" disabled="@(Busy || Module is null)" /></label>
        <button disabled="@(Busy || Module is null)" @onclick="InstallOffline">Make available offline</button>
    </div><p class="small">Project files include your photos. Keep a copy before clearing browser data.</p></details>
    @if (Busy) { <p role="status">Working…</p> }

    @if (View == "orders")
    {
        <div class="workspace-grid">
            <aside>
                <h2>Create work order</h2>
                <fieldset disabled="@(Busy || Module is null)">
                    <label>Order title<input maxlength="160" @bind="NewTitle" placeholder="For example: Friday studio handoff" /></label>
                    <label>Checklist<select @bind="SelectedTemplateId">@foreach (var item in Workspace.Templates) { <option value="@item.Id">@item.Title · v@item.Revision</option> }</select></label>
                    <button class="strong" @onclick="CreateOrder" disabled="@(Workspace.Templates.Count == 0)">Create work order</button>
                </fieldset>
                @if (Workspace.Templates.Count == 0) { <p>Create a checklist in the library before making an order.</p> }
                <h2>Your work orders</h2>
                <div class="order-list">
                    @foreach (var item in Workspace.Orders.OrderByDescending(value => value.UpdatedAt))
                    {
                        <button class="@(SelectedOrderId == item.Id ? "selected" : "")" @onclick="() => SelectOrder(item.Id)" disabled="@Busy"><strong>@item.Title</strong><span>@FieldWorkRules.StatusLabel(item.Status) · @item.UpdatedAt.ToLocalTime().ToString("MMM d, HH:mm", System.Globalization.CultureInfo.InvariantCulture)</span></button>
                    }
                </div>
                @if (Workspace.Orders.Count == 0) { <p>No work orders yet.</p> }
            </aside>
            <section>
                @if (CurrentOrder is { } order)
                {
                    var locked = order.Status is FieldWorkStatus.ReadyForReview or FieldWorkStatus.Complete;
                    var issues = FieldWorkRules.Issues(order);
                    <div class="order-heading"><h2>@order.Title</h2><strong class="status-label">@FieldWorkRules.StatusLabel(order.Status)</strong></div>
                    <p>@order.TemplateTitle</p>
                    <div class="toolbar">
                        @if (order.Status != FieldWorkStatus.Complete) { <button class="strong" disabled="@Busy" @onclick="Advance">@NextAction(order.Status)</button> }
                        @if (locked) { <button disabled="@Busy" @onclick="Reopen">Reopen for changes</button> }
                        <button disabled="@Busy" @onclick="ExportOrder">Save order file</button>
                        <button disabled="@Busy" @onclick="ExportReport">Save report</button>
                        <button disabled="@Busy" @onclick="PrintReport">Print report</button>
                    </div>
                    <fieldset disabled="@(Busy || locked)">
                        <details><summary>Order details and notes</summary><div class="metadata">
                            <label>Work-order title<input maxlength="160" @bind="order.Title" @bind:after="OrderChanged" /></label>
                            <label>Reference label (optional)<input maxlength="160" @bind="order.Reference" @bind:after="OrderChanged" /></label>
                            <label>Customer / site (optional)<input maxlength="160" @bind="order.CustomerLabel" @bind:after="OrderChanged" /></label>
                            <label>Reviewer name (optional)<input maxlength="160" @bind="order.ReviewerLabel" @bind:after="OrderChanged" /></label>
                        </div>
                        <label>Work-order notes<textarea rows="3" maxlength="6000" @bind="order.Notes" @bind:after="OrderChanged"></textarea></label></details>
                    </fieldset>
                    <section class="outstanding" aria-label="Unresolved requirements">
                        <h3>Outstanding items: @issues.Count</h3>
                        @if (issues.Count == 0) { <p>All required items are filled.</p> }
                        else { <details><summary>View missing items</summary><ul>@foreach (var issue in issues) { <li><strong>@issue.Label:</strong> @issue.Message</li> }</ul></details> }
                    </section>
                    @if (order.Status == FieldWorkStatus.Plan) { <p class="instruction">Select Start work to fill this checklist.</p> }
                    @foreach (var field in order.Fields)
                    {
                        var answer = order.Answers.First(value => value.FieldId == field.Id);
                        var editable = order.Status == FieldWorkStatus.InProgress && !Busy;
                        var fieldIssues = issues.Where(value => value.FieldId == field.Id).ToList();
                        <article class="evidence-field" @key="field.Id">
                            <h3>@field.Label <span>@(field.Required ? "Required" : "Optional")</span></h3>
                            @if (!string.IsNullOrWhiteSpace(field.Instructions)) { <p>@field.Instructions</p> }
                            <fieldset disabled="@(!editable)">
                                @if (field.Kind == FieldWorkFieldKind.Confirmation)
                                {
                                    <label class="check"><input type="checkbox" @bind="answer.Confirmed" @bind:after="OrderChanged" /> Checked</label>
                                }
                                else if (field.Kind == FieldWorkFieldKind.Measurement)
                                {
                                    <label>Value @(string.IsNullOrWhiteSpace(field.Unit) ? "" : $"({field.Unit})")<input type="text" inputmode="decimal" maxlength="80" @bind="answer.NumberText" @bind:after="OrderChanged" placeholder="0.0" /></label>
                                    @if (field.Minimum is not null || field.Maximum is not null) { <p class="small">Range: @(field.Minimum?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "any") to @(field.Maximum?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "any") @field.Unit</p> }
                                }
                                else
                                {
                                    <label>Attach photo<InputFile OnChange="args => AttachPhoto(args, field.Id)" accept="image/jpeg,image/png,image/webp" /></label>
                                    <p class="small">JPEG, PNG or WebP · up to 8 MB</p>
                                }
                                <details open="@(!string.IsNullOrWhiteSpace(answer.Note))"><summary>Add a note</summary><label>Note<textarea rows="2" maxlength="2000" @bind="answer.Note" @bind:after="OrderChanged"></textarea></label></details>
                            </fieldset>
                            @if (answer.Photo is { } photo)
                            {
                                @if (FieldWorkRules.HasRasterEvidence(photo)) { <img class="evidence-image" src="@photo.DataUrl" alt="@field.Label" /><p class="small">@photo.FileName</p> }
                                else { <p class="field-error">Choose the original photo to reconnect it.</p> }
                                <details><summary>Source image fingerprint</summary><code>@photo.SourceSha256</code></details>
                                @if (editable) { <button @onclick="() => RemovePhoto(field.Id)">Remove attached photo</button> }
                            }
                            @foreach (var issue in fieldIssues) { <p class="field-error">@issue.Message</p> }
                        </article>
                    }
                    <details class="history"><summary>Local workflow history (@order.History.Count)</summary><ol>@foreach (var entry in order.History) { <li>@entry.At.ToLocalTime().ToString("MMM d, HH:mm", System.Globalization.CultureInfo.InvariantCulture) · <strong>@entry.Action</strong> — @entry.Detail</li> }</ol></details>
                    <details class="history"><summary>Checklist version and report details</summary><p>@order.TemplateTitle · checklist @order.TemplateRevision · order @order.Revision</p><p>Library edits do not change this order. Reports include your answers and photos. Completion records your review; it is not a signed inspection.</p></details>
                }
                else if ((Workspace.Templates.FirstOrDefault(item => item.Id.ToString() == SelectedTemplateId) ?? Workspace.Templates.FirstOrDefault()) is { } preview) { <h2>@preview.Title</h2><p>@preview.Description</p><ul class="checklist-preview">@foreach (var field in preview.Fields) { <li>@field.Label <span class="small">· @(field.Kind == FieldWorkFieldKind.Photo ? "Photo" : field.Kind == FieldWorkFieldKind.Measurement ? field.Unit : "Check")</span></li> }</ul><p class="small">Checklist preview · add an order title to begin.</p> }
                else { <h2>Create a checklist</h2><p>Open the checklist library to add the items you need.</p> }
            </section>
        </div>
    }
    else if (View == "templates")
    {
        <div class="workspace-grid">
            <aside><h2>Checklist library</h2><p>Edit a starter or make your own.</p><div class="order-list">@foreach (var template in Workspace.Templates) { <button disabled="@Busy" @onclick="() => EditTemplate(template.Id)"><strong>@template.Title</strong><span>@template.Fields.Count items</span></button> }</div><button disabled="@Busy" @onclick="NewTemplate">New checklist</button></aside>
            <section>
                @if (TemplateDraft is { } draft)
                {
                    <h2>Checklist editor</h2><p>Changes apply to new orders only.</p>
                    <fieldset disabled="@Busy">
                        <label>Checklist name<input maxlength="120" @bind="draft.Title" /></label>
                        <label>Scope / description<textarea rows="3" maxlength="2000" @bind="draft.Description"></textarea></label>
                        @foreach (var field in draft.Fields)
                        {
                            <article class="definition" @key="field.Id">
                                <div class="metadata"><label>Field label<input maxlength="160" @bind="field.Label" /></label><label>Type<select @bind="field.Kind"><option value="@FieldWorkFieldKind.Confirmation">Confirmation</option><option value="@FieldWorkFieldKind.Measurement">Numeric measurement</option><option value="@FieldWorkFieldKind.Photo">Photo evidence</option></select></label></div>
                                <label>Instructions<textarea rows="2" maxlength="1000" @bind="field.Instructions"></textarea></label>
                                <label class="check"><input type="checkbox" @bind="field.Required" /> Required before review</label>
                                @if (field.Kind == FieldWorkFieldKind.Measurement)
                                {
                                    <div class="metadata"><label>Unit<input maxlength="30" @bind="field.Unit" /></label><label>Minimum (optional)<input type="number" step="any" @bind="field.Minimum" /></label><label>Maximum (optional)<input type="number" step="any" @bind="field.Maximum" /></label></div>
                                }
                                <div class="toolbar"><button @onclick="() => MoveField(field.Id, -1)">Move up</button><button @onclick="() => MoveField(field.Id, 1)">Move down</button><button @onclick="() => draft.Fields.Remove(field)">Remove field</button></div>
                            </article>
                        }
                    <div class="toolbar"><button @onclick="() => AddField(FieldWorkFieldKind.Confirmation)">Add confirmation</button><button @onclick="() => AddField(FieldWorkFieldKind.Measurement)">Add measurement</button><button @onclick="() => AddField(FieldWorkFieldKind.Photo)">Add photo field</button><button class="strong" @onclick="SaveTemplate">Save checklist</button></div>
                    </fieldset>
                }
                else { <h2>Choose a checklist</h2><p>Edit its items, or start a new one.</p> }
            </section>
        </div>
    }
    else if (View == "cloud")
    {
        <section class="cloud">
            <h2>Shared projects</h2>
            <p>Share checklists and answers with invited people. Everyone invited can read all notes. Keep the original photos on your device.</p>
            <p class="notice" role="status">@CloudMessage</p>
            <div class="toolbar"><a href="/uyelik/" target="_blank" rel="noopener">Account</a><button disabled="@Busy" @onclick="RefreshCloud">Refresh</button></div>
            @if (CloudAccount is { } account)
            {
                <p><strong>@(account.Premium ? "Paid account" : "Free account")</strong> · @account.UsedProjects / @account.ProjectLimit projects</p><details><summary>Sharing limits</summary><p>@(account.MaxBodyBytes / 1024) KB per project · @account.MemberLimit invited people · @account.HistoryLimit saved versions. Photos are kept separately.</p></details>
                <label>Shared project name<input maxlength="100" @bind="CloudTitle" /></label>
                <p>Photos are included in project files, not online saves.</p>
                <div class="toolbar">
                    <button disabled="@Busy" @onclick="CreateCloud">Save as a new shared project</button>
                    @if (!string.IsNullOrEmpty(CloudId))
                    {
                        <button disabled="@(Busy || !CanEditCloud)" @onclick="SaveCloud">Save changes</button>
                        <button disabled="@Busy" @onclick="ReloadCloud">Reload shared project</button>
                    }
                </div>
                @if (!string.IsNullOrEmpty(CloudId))
                {
                    <p><strong>Your access: @CloudRole</strong> · revision @CloudRevision. Select Save changes to update this shared project. Viewers can keep a local copy.</p>
                    @if (CloudRole == "owner")
                    {
                        <div class="metadata"><label>Invitation permission<select @bind="InviteRole"><option value="viewer">Viewer — read only</option><option value="editor">Editor — edit project</option></select></label><div><button disabled="@Busy" @onclick="CreateInvite">Create invite link</button></div></div>
                        @if (!string.IsNullOrEmpty(InvitationLink)) { <label>Private invitation link<input readonly value="@InvitationLink" @onclick="CopyInvitation" /></label><button disabled="@Busy" @onclick="CopyInvitation">Copy private invitation</button><p>Expires @InvitationExpiry. Send it only to the intended recipient.</p> }
                    }
                    @if (CanEditCloud)
                    {
                        <button disabled="@Busy" @onclick="ReadCloudHistory">Version history</button>
                        @foreach (var version in CloudVersions)
                        {
                            <div class="cloud-row"><span>Revision @version.Revision · @version.Title · @DateTimeOffset.FromUnixTimeMilliseconds(version.SavedAt).ToLocalTime().ToString("MMM d, HH:mm", System.Globalization.CultureInfo.InvariantCulture)</span><button disabled="@Busy" @onclick="() => RestoreCloudVersion(version.Revision)">Open local copy</button></div>
                        }
                    }
                }
                <h3>Your shared projects</h3>
                @foreach (var item in CloudList.Where(value => value.Kind == "field"))
                {
                    <div class="cloud-row"><span><strong>@item.Title</strong> · revision @item.Revision · @item.Role</span><button disabled="@Busy" @onclick="() => ReadCloud(item.Id)">Open project</button></div>
                }
                @if (!CloudList.Any(value => value.Kind == "field")) { <p>No shared projects yet.</p> }
            }
            <h3>Join a shared project</h3>
            <p>Sign in, then paste the invitation. Its owner chooses your access.</p>
            <label>Invite link<input type="password" autocomplete="off" @bind="InviteValue" /></label><button disabled="@(Busy || CloudAccount is null)" @onclick="JoinCloud">Join project</button>
            <p class="instruction">On another device, reconnect the original photos before completing a review.</p>
        </section>
    }
    else
    {
        <section class="help">
            <h2>From plan to handoff</h2>
            <ol><li>Choose one of eight checklists or define your own confirmations, measurements, and photo fields.</li><li>Create an order using only labels you choose. Customer and reviewer labels are optional.</li><li>Start work, enter measurements, and attach actual images. Outstanding items update after committed changes.</li><li>Request review. Missing confirmations, invalid numbers, out-of-range values, or missing photo bytes block the transition.</li><li>Complete the reviewed order or reopen it for changes. Export a filled HTML report or print it.</li></ol>
            <h2>Saving and offline use</h2><p>Changes save on this device when you finish editing a field. Save checklist drafts with Save checklist. Keep a project file as a backup. Projects can hold 30 orders, 50 checklists and 25 MB.</p>
            <p>Open Project files and offline use, then choose Make available offline before disconnecting. Wait for its confirmation.</p>
            <h2>Photos and reporting</h2><p>Project files and reports can contain photos. File matching does not prove when or where a photo was taken.</p>
            <p>Reports with outstanding items are marked Draft. Completion records your own review, not a signed inspection.</p>
            <h2>Opening a project</h2><p>Save a project file before opening another project. Opening replaces the current project after checking its contents and asking you to confirm.</p>
        </section>
    }
</main>

</PageSurface>
@code {
    const bool IsLogEnabled = true;
    FieldWorkWorkspace Workspace = FieldWorkExamples.CreateWorkspace();
    FieldWorkTemplate? TemplateDraft;
    IJSObjectReference? Module;
    Guid? SelectedOrderId;
    string SelectedTemplateId = "";
    string NewTitle = "";
    string View = "orders";
    string Message = "Opening your project…";
    string StorageMessage = "";
    bool Busy;
    FieldWorkCloudAccount? CloudAccount;
    List<FieldWorkCloudSummary> CloudList = [];
    List<FieldWorkCloudVersion> CloudVersions = [];
    string CloudMessage = "Sign in to save or join a shared project.";
    string CloudTitle = "Field work workspace";
    string CloudId = "";
    string CloudRole = "";
    int CloudRevision;
    int CloudPayloadSize;
    string InviteRole = "viewer";
    string InviteValue = "";
    string InvitationLink = "";
    string InvitationExpiry = "";
    bool CanEditCloud => CloudRole is "owner" or "editor";
    FieldWorkOrder? CurrentOrder => Workspace.Orders.FirstOrDefault(order => order.Id == SelectedOrderId);

    /// <summary>Loads only this product's browser module and validates a stored workspace before displaying it.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Execute(async () =>
        {
            Module = await Javascript.InvokeAsync<IJSObjectReference>("import", "/field-work.js");
            var stored = await Module.InvokeAsync<string?>("loadProject");
            if (!string.IsNullOrWhiteSpace(stored))
            {
                var candidate = FieldWorkRules.Deserialize(stored);
                await ValidateImages(candidate);
                Workspace = candidate;
                Message = "Project opened.";
            }
            else Message = "Choose a checklist and add an order title.";
            SelectedTemplateId = Workspace.Templates.FirstOrDefault()?.Id.ToString() ?? "";
            SelectedOrderId = Workspace.Orders.FirstOrDefault()?.Id;
            var invite = QueryValue(new Uri(Navigation.Uri).Query, "invite");
            if (!string.IsNullOrEmpty(invite)) { InviteValue = invite; Message = "An invitation is available. Open Private workspace and sign in to claim it."; }
        }, "load");
        StateHasChanged();
    }

    /// <summary>Contains a whole user action and reports failure without logging customer content or photo bytes.</summary>
    async Task Execute(Func<Task> operation, string name)
    {
        if (Busy) return;
        Busy = true;
        try
        {
            if (IsLogEnabled) Logger.LogInformation("Field work action started; operation={Operation}", name);
            await operation();
        }
        catch (ApiFailure error) { CloudMessage = error.Status == System.Net.HttpStatusCode.Conflict ? "The server could not accept this revision or allowance. Your local data is preserved. Refresh or reload before saving again. " + error.Message : error.Message; Message = CloudMessage; if (error.Status == System.Net.HttpStatusCode.Unauthorized) { CloudAccount = null; CloudRole = ""; } }
        catch (InvalidOperationException error) { Message = error.Message; if (IsLogEnabled) Logger.LogWarning("Field work validation failed; operation={Operation}; type={Type}", name, error.GetType().Name); }
        catch (JsonException) { Message = "This project file could not be opened. Your current work is unchanged."; }
        catch (HttpRequestException) { CloudMessage = "The cloud service could not be reached. Your local workspace is unchanged; local editing and project exports remain available."; Message = CloudMessage; }
        catch (JSException error) { Message = "Browser action failed: " + error.Message.Split('\n')[0]; if (IsLogEnabled) Logger.LogWarning("Field work browser action failed; operation={Operation}", name); }
        catch (Exception error) { Message = "The action could not be completed. Your current data remains in memory; download a project backup before closing."; if (IsLogEnabled) Logger.LogError("Field work action failed; operation={Operation}; type={Type}", name, error.GetType().Name); }
        finally { Busy = false; }
    }

    /// <summary>Writes a validated complete project and acknowledges only an actual completed browser write.</summary>
    async Task Persist()
    {
        if (Module is null) throw new InvalidOperationException("Browser storage is not ready. Refresh the page or download a project backup.");
        Workspace.UpdatedAt = DateTimeOffset.UtcNow;
        var json = FieldWorkRules.Serialize(Workspace);
        try { var mode = await Module.InvokeAsync<string>("saveProject", json); StorageMessage = $"Saved on this device at {DateTimeOffset.Now:HH:mm:ss}."; }
        catch { StorageMessage = "Saving failed. Save a project file before closing this page."; throw; }
    }

    /// <summary>Persists all committed fields on explicit request.</summary>
    Task SaveNow() => Execute(async () => { await Persist(); Message = "The local workspace was saved."; }, "save");

    /// <summary>Starts a separate local workspace only after an explicit replacement confirmation.</summary>
    Task NewWorkspace() => Execute(async () =>
    {
        if ((Workspace.Orders.Count > 0 || Workspace.Templates.Count > 0 || TemplateDraft is not null) && !await Javascript.InvokeAsync<bool>("confirm", "Start a new project? Save checklist edits and a project file first to keep your work.")) return;
        Workspace = FieldWorkExamples.CreateWorkspace(); SelectedOrderId = null; TemplateDraft = null; SelectedTemplateId = Workspace.Templates[0].Id.ToString(); NewTitle = ""; DetachCloud();
        await Persist(); Message = "New project ready.";
    }, "new-workspace");

    /// <summary>Creates a work order from a frozen, validated checklist version.</summary>
    Task CreateOrder() => Execute(async () =>
    {
        if (Workspace.Orders.Count >= FieldWorkRules.MaximumOrders) throw new InvalidOperationException("This workspace supports up to 30 orders. Export this project and start a separate workspace for more.");
            var template = Workspace.Templates.FirstOrDefault(value => value.Id.ToString() == SelectedTemplateId) ?? throw new InvalidOperationException("Choose a checklist first.");
        if (string.IsNullOrWhiteSpace(NewTitle)) throw new InvalidOperationException("Enter an order title first.");
        var order = FieldWorkRules.CreateOrder(template, NewTitle.Trim());
        Workspace.Orders.Add(order); SelectedOrderId = order.Id; NewTitle = "";
        await Persist(); Message = "Planned order created. Check its details and select Start work.";
    }, "create-order");

    /// <summary>Selects an existing order without creating or altering evidence.</summary>
    void SelectOrder(Guid id) { if (Busy) return; SelectedOrderId = id; Message = "Work order opened."; }

    /// <summary>Records an editable field change before saving its actual current values.</summary>
    Task OrderChanged() => Execute(async () => { if (CurrentOrder is null) return; FieldWorkRules.Touch(CurrentOrder); await Persist(); }, "edit-order");

    /// <summary>Performs one validated state transition and exposes each unresolved requirement if blocked.</summary>
    Task Advance() => Execute(async () =>
    {
        var order = CurrentOrder;
        if (order is null) return;
        var result = FieldWorkRules.Advance(order);
        if (!result.Succeeded) { Message = $"Cannot advance: {result.Issues.Count} unresolved item(s). {result.Issues[0].Label}: {result.Issues[0].Message}"; return; }
        await Persist(); Message = $"Order is now {FieldWorkRules.StatusLabel(order.Status)}.";
    }, "advance");

    /// <summary>Explicitly reopens a reviewed order so edits cannot silently retain a completed label.</summary>
    Task Reopen() => Execute(async () => { if (CurrentOrder is null) return; FieldWorkRules.Reopen(CurrentOrder); await Persist(); Message = "Order reopened. Its answers are preserved; review and completion must be repeated."; }, "reopen");

    /// <summary>Decodes a user-selected image, compresses actual pixels, and binds those bytes to the selected requirement.</summary>
    Task AttachPhoto(InputFileChangeEventArgs args, Guid fieldId) => Execute(async () =>
    {
        var workspace = Workspace;
        var order = CurrentOrder;
        var module = Module;
        if (order is null || module is null || order.Status != FieldWorkStatus.InProgress) return;
        var field = order.Fields.FirstOrDefault(value => value.Id == fieldId && value.Kind == FieldWorkFieldKind.Photo);
        var answer = order.Answers.FirstOrDefault(value => value.FieldId == fieldId);
        if (field is null || answer is null) throw new InvalidOperationException("Choose an existing photo requirement in this work order.");
        var previous = answer.Photo;
        var revision = order.Revision;
        await using var stream = args.File.OpenReadStream(8 * 1024 * 1024);
        using var memory = new MemoryStream(); await stream.CopyToAsync(memory);
        var prepared = await module.InvokeAsync<FieldWorkPhoto>("preparePhoto", Convert.ToBase64String(memory.ToArray()), args.File.ContentType, args.File.Name);
        if (!FieldWorkRules.HasRasterEvidence(prepared)) throw new InvalidOperationException("The image could not be prepared as valid photo evidence.");
        if (!ReferenceEquals(Workspace, workspace) || !workspace.Orders.Contains(order) || order.Status != FieldWorkStatus.InProgress || order.Revision != revision || !order.Fields.Contains(field) || !order.Answers.Contains(answer) || !ReferenceEquals(answer.Photo, previous)) throw new InvalidOperationException("The target work order changed while the image was being prepared. Its photo was not replaced; select the intended order and try again.");
        if (previous is { DataUrl.Length: 0 } expected && !string.IsNullOrWhiteSpace(expected.SourceSha256) && expected.SourceSha256 != prepared.SourceSha256) throw new InvalidOperationException("This file does not match the expected source fingerprint. Use the original image or explicitly remove the old photo reference first.");
        answer.Photo = prepared;
        try { FieldWorkRules.Serialize(workspace); }
        catch { answer.Photo = previous; throw; }
        FieldWorkRules.Touch(order); await Persist(); Message = "Photo attached and saved.";
    }, "attach-photo");

    /// <summary>Removes image bytes and their reference, making a required photo field incomplete again.</summary>
    Task RemovePhoto(Guid fieldId) => Execute(async () => { if (CurrentOrder is null || CurrentOrder.Status != FieldWorkStatus.InProgress) return; CurrentOrder.Answers.First(value => value.FieldId == fieldId).Photo = null; FieldWorkRules.Touch(CurrentOrder); await Persist(); Message = "Photo removed. Required photo fields must be filled again before review."; }, "remove-photo");

    /// <summary>Opens a detached copy of a library template; unsaved edits cannot change existing jobs.</summary>
    async Task EditTemplate(Guid id) { if (Busy || !await ConfirmChecklistDraft()) return; TemplateDraft = FieldWorkRules.Clone(Workspace.Templates.First(value => value.Id == id)); Message = "Editing a checklist. Select Save checklist to keep changes."; }

    /// <summary>Starts a custom checklist with an editable confirmation requirement.</summary>
    async Task NewTemplate() { if (Busy || !await ConfirmChecklistDraft()) return; TemplateDraft = new() { Title = "My checklist", Fields = [new()] }; Message = "New checklist ready to edit."; }

    /// <summary>Asks before switching away from an unsaved checklist definition.</summary>
    async Task<bool> ConfirmChecklistDraft()
    {
        if (TemplateDraft is null) return true;
        var saved = Workspace.Templates.FirstOrDefault(item => item.Id == TemplateDraft.Id);
        return saved is not null && JsonSerializer.Serialize(saved) == JsonSerializer.Serialize(TemplateDraft)
            || await Javascript.InvokeAsync<bool>("confirm", "Discard the unsaved checklist edits and open another checklist?");
    }

    /// <summary>Adds a genuinely typed requirement to the current template draft.</summary>
    void AddField(FieldWorkFieldKind kind)
    {
        if (TemplateDraft is null || TemplateDraft.Fields.Count >= FieldWorkRules.MaximumFields) { Message = "A checklist supports up to 40 fields."; return; }
        TemplateDraft.Fields.Add(new() { Kind = kind, Label = kind switch { FieldWorkFieldKind.Measurement => "New measurement", FieldWorkFieldKind.Photo => "New photo evidence", _ => "New confirmation" } });
    }

    /// <summary>Reorders definitions without moving their identity or any existing order snapshot.</summary>
    void MoveField(Guid id, int delta)
    {
        if (TemplateDraft is null) return;
        var index = TemplateDraft.Fields.FindIndex(field => field.Id == id); var target = index + delta;
        if (index < 0 || target < 0 || target >= TemplateDraft.Fields.Count) return;
        (TemplateDraft.Fields[index], TemplateDraft.Fields[target]) = (TemplateDraft.Fields[target], TemplateDraft.Fields[index]);
    }

    /// <summary>Commits only a valid draft and increments its library revision while retaining all old job snapshots.</summary>
    Task SaveTemplate() => Execute(async () =>
    {
        if (TemplateDraft is null) return;
        var issues = FieldWorkRules.DefinitionIssues(TemplateDraft.Title, TemplateDraft.Fields);
        if (issues.Count > 0) throw new InvalidOperationException($"{issues[0].Label}: {issues[0].Message}");
        var existing = Workspace.Templates.FindIndex(template => template.Id == TemplateDraft.Id);
        var copy = FieldWorkRules.Clone(TemplateDraft);
        if (existing >= 0) { copy.Revision = Workspace.Templates[existing].Revision + 1; Workspace.Templates[existing] = copy; }
        else { if (Workspace.Templates.Count >= 50) throw new InvalidOperationException("A workspace supports up to 50 checklists."); Workspace.Templates.Add(copy); }
        TemplateDraft = FieldWorkRules.Clone(copy); SelectedTemplateId = copy.Id.ToString(); await Persist(); Message = "Checklist saved. Existing work orders keep their original checklist snapshot.";
    }, "save-checklist");

    /// <summary>Downloads the complete local workspace, including actual photo data, as a portable JSON project.</summary>
    Task ExportProject() => Execute(async () => { if (Module is null) return; await Module.InvokeVoidAsync("downloadText", FieldWorkRules.Serialize(Workspace), "field-work-project.json", "application/json"); Message = "Project file downloaded, including photos."; }, "export-project");

    /// <summary>Exports a single selected order with its independent checklist for smaller portable projects.</summary>
    Task ExportOrder() => Execute(async () =>
    {
        if (CurrentOrder is null || Module is null) return;
        var order = FieldWorkRules.Clone(CurrentOrder);
        var project = new FieldWorkWorkspace { Title = "Work order backup", Orders = [order], Templates = [new() { Id = order.TemplateId, Title = order.TemplateTitle, Revision = order.TemplateRevision, Fields = order.Fields.Select(FieldWorkRules.Clone).ToList() }] };
        await Module.InvokeVoidAsync("downloadText", FieldWorkRules.Serialize(project), "field-work-order.json", "application/json"); Message = "Order file downloaded, including photos.";
    }, "export-order");

    /// <summary>Validates a full import and decodes every embedded image before changing the current project.</summary>
    Task ImportProject(InputFileChangeEventArgs args) => Execute(async () =>
    {
        if (Module is null) return;
        await using var stream = args.File.OpenReadStream(FieldWorkRules.MaximumProjectBytes);
        using var reader = new StreamReader(stream); var candidate = FieldWorkRules.Deserialize(await reader.ReadToEndAsync());
        await ValidateImages(candidate);
        if ((Workspace.Orders.Count > 0 || Workspace.Templates.Count > 0 || TemplateDraft is not null) && !await Javascript.InvokeAsync<bool>("confirm", "Replace the current project? Save checklist edits and a project file first to keep your work.")) return;
        Workspace = candidate; SelectedOrderId = Workspace.Orders.FirstOrDefault()?.Id; SelectedTemplateId = Workspace.Templates.FirstOrDefault()?.Id.ToString() ?? ""; TemplateDraft = null; DetachCloud();
        await Persist(); Message = "Project opened.";
    }, "import-project");

    /// <summary>Checks real browser decoding for all imported or restored photos rather than trusting metadata.</summary>
    async Task ValidateImages(FieldWorkWorkspace workspace)
    {
        if (Module is null) return;
        foreach (var photo in workspace.Orders.SelectMany(order => order.Answers).Where(answer => answer.Photo is not null && !string.IsNullOrEmpty(answer.Photo.DataUrl)).Select(answer => answer.Photo!))
            await Module.InvokeVoidAsync("validatePhoto", photo);
    }

    /// <summary>Downloads a standalone filled report, clearly marked as a draft when work remains unresolved.</summary>
    Task ExportReport() => Execute(async () => { if (CurrentOrder is null || Module is null) return; await Module.InvokeVoidAsync("downloadText", FieldWorkReport.Create(CurrentOrder), "field-work-report.html", "text/html"); Message = "Report downloaded."; }, "export-report");

    /// <summary>Opens the same self-contained report and prints only after its embedded images are ready.</summary>
    Task PrintReport() => Execute(async () => { if (CurrentOrder is null || Module is null) return; await Module.InvokeVoidAsync("printReport", FieldWorkReport.Create(CurrentOrder)); Message = "Report opened for printing."; }, "print-report");

    /// <summary>Requests a product-scoped offline cache and reports the verified cache result.</summary>
    Task InstallOffline() => Execute(async () => { if (Module is null) return; var count = await Module.InvokeAsync<int>("prepareOffline"); Message = $"Ready to reopen offline in this browser."; }, "prepare-offline");

    /// <summary>Opens optional server features only after a user requests them; local startup does not require a network.</summary>
    Task OpenCloud() => Execute(async () => { View = "cloud"; CloudPayloadSize = FieldWorkCloud.MetadataBytes(Workspace); await LoadCloudList(); }, "open-cloud");

    /// <summary>Refreshes actual server account allowances and accessible metadata workspaces.</summary>
    Task RefreshCloud() => Execute(LoadCloudList, "refresh-cloud");

    /// <summary>Reads first-party access state without creating an account or uploading local data.</summary>
    async Task LoadCloudList()
    {
        var result = await Api.GetAsync<FieldWorkCloudList>("commerce/workspaces"); CloudAccount = result.Account; CloudList = result.Workspaces ?? [];
        CloudMessage = "Shared projects refreshed. Photos stay on this device.";
    }

    /// <summary>Checks the exact metadata size and label before requesting server persistence.</summary>
    JsonElement CloudBody(bool create)
    {
        if (string.IsNullOrWhiteSpace(CloudTitle) || CloudTitle.Length > 100) throw new InvalidOperationException("Use a cloud workspace label between 1 and 100 characters.");
        var body = FieldWorkCloud.Metadata(Workspace); CloudPayloadSize = System.Text.Encoding.UTF8.GetByteCount(body.GetRawText());
        var limit = create || CloudRole == "owner" ? CloudAccount?.MaxBodyBytes ?? 65536 : 524288;
        if (CloudPayloadSize > limit) throw new InvalidOperationException($"This metadata document is {CloudPayloadSize} bytes. The current limit is {limit} bytes; export the full local project or use a smaller workspace.");
        return body;
    }

    /// <summary>Creates a metadata-only cloud workspace under the real authenticated account allowance.</summary>
    Task CreateCloud() => Execute(async () =>
    {
        var response = await Api.PostAsync<FieldWorkCloudResponse>("commerce/workspaces", new { kind = "field", title = CloudTitle.Trim(), body = CloudBody(true) });
        CloudId = response.Workspace.Id; CloudRevision = response.Workspace.Revision; CloudRole = response.Workspace.Role; CloudVersions = []; InvitationLink = "";
        await LoadCloudList(); CloudMessage = "Shared project saved. Keep a project file to back up photos.";
    }, "create-cloud");

    /// <summary>Saves with the actual server revision; a conflict never triggers an automatic overwrite.</summary>
    Task SaveCloud() => Execute(async () =>
    {
        if (!CanEditCloud || string.IsNullOrEmpty(CloudId)) throw new InvalidOperationException("Editor or owner access is required to save this server workspace.");
        var response = await Api.PostAsync<FieldWorkCloudResponse>($"commerce/workspaces/{Uri.EscapeDataString(CloudId)}", new { revision = CloudRevision, title = CloudTitle.Trim(), body = CloudBody(false) });
        CloudRevision = response.Workspace.Revision; CloudRole = response.Workspace.Role; await LoadCloudList(); CloudMessage = $"Shared project saved · version {CloudRevision}.";
    }, "save-cloud");

    /// <summary>Opens a server document only after explicit local replacement confirmation and local-image validation.</summary>
    Task ReadCloud(string id) => Execute(async () =>
    {
        var response = await Api.GetAsync<FieldWorkCloudResponse>($"commerce/workspaces/{Uri.EscapeDataString(id)}");
        if (response.Workspace.Kind != "field") throw new InvalidOperationException("This is not a Field Work Pack workspace.");
        await ApplyCloud(response.Workspace.Body);
        CloudId = response.Workspace.Id; CloudRevision = response.Workspace.Revision; CloudRole = response.Workspace.Role; CloudTitle = response.Workspace.Title; CloudVersions = []; InvitationLink = "";
    }, "read-cloud");

    /// <summary>Reloads the current remote revision while preserving local work if replacement is declined.</summary>
    Task ReloadCloud() => string.IsNullOrEmpty(CloudId) ? Task.CompletedTask : ReadCloud(CloudId);

    /// <summary>Installs metadata into the local editor while refusing to treat remote image metadata as pixels.</summary>
    async Task ApplyCloud(JsonElement body)
    {
        var restored = FieldWorkCloud.Restore(body, Workspace); await ValidateImages(restored.Workspace);
        if ((Workspace.Orders.Count > 0 || Workspace.Templates.Count > 0 || TemplateDraft is not null) && !await Javascript.InvokeAsync<bool>("confirm", "Open this shared version and replace your current project? Save checklist edits and a project file first to keep your work.")) throw new InvalidOperationException("The current local workspace was kept.");
        Workspace = restored.Workspace; SelectedOrderId = Workspace.Orders.FirstOrDefault()?.Id; SelectedTemplateId = Workspace.Templates.FirstOrDefault()?.Id.ToString() ?? ""; TemplateDraft = null;
        await Persist(); CloudPayloadSize = FieldWorkCloud.MetadataBytes(Workspace);
        CloudMessage = $"Project opened. Reconnect {restored.PhotosToRelink} original photo(s).";
    }

    /// <summary>Creates a real single-use invitation using owner-only server authorization.</summary>
    Task CreateInvite() => Execute(async () =>
    {
        if (CloudRole != "owner") throw new InvalidOperationException("Only the workspace owner can create an invitation.");
        var response = await Api.PostAsync<FieldWorkCloudInvite>($"commerce/workspaces/{Uri.EscapeDataString(CloudId)}/invites", new { role = InviteRole });
        var url = new UriBuilder(new Uri(new Uri(Navigation.BaseUri), "field-work-pack/")) { Query = "invite=" + Uri.EscapeDataString(response.Token) };
        InvitationLink = url.Uri.AbsoluteUri; InvitationExpiry = DateTimeOffset.FromUnixTimeMilliseconds(response.ExpiresAt).ToLocalTime().ToString("MMM d, HH:mm", System.Globalization.CultureInfo.InvariantCulture); CloudMessage = "Invite link created. It opens the whole shared project.";
    }, "create-invite");

    /// <summary>Copies only a user-requested invitation and handles denied clipboard permission explicitly.</summary>
    Task CopyInvitation() => Execute(async () => { if (Module is null) return; var copied = await Module.InvokeAsync<bool>("copyText", InvitationLink); CloudMessage = copied ? "Private invitation copied." : "Clipboard access was denied. Select the invitation link and copy it manually."; }, "copy-invite");

    /// <summary>Claims a real invitation token without inventing a local login or collaborator.</summary>
    Task JoinCloud() => Execute(async () =>
    {
        var token = InviteValue.Trim(); if (Uri.TryCreate(token, UriKind.Absolute, out var url)) token = QueryValue(url.Query, "invite");
        var response = await Api.PostAsync<FieldWorkCloudJoined>("commerce/workspaces/join", new { token });
        var document = await Api.GetAsync<FieldWorkCloudResponse>($"commerce/workspaces/{Uri.EscapeDataString(response.WorkspaceId)}");
        if (document.Workspace.Kind != "field") throw new InvalidOperationException("This invitation belongs to a different product. Open it in the corresponding tool.");
        await ApplyCloud(document.Workspace.Body); CloudId = document.Workspace.Id; CloudRevision = document.Workspace.Revision; CloudRole = document.Workspace.Role; CloudTitle = document.Workspace.Title; InviteValue = ""; CloudVersions = []; InvitationLink = ""; await LoadCloudList(); CloudMessage = $"Joined with {CloudRole} access. Reconnect the original photos.";
    }, "join-cloud");

    /// <summary>Reads actual server-retained revisions for an owner or editor.</summary>
    Task ReadCloudHistory() => Execute(async () => { var response = await Api.GetAsync<FieldWorkCloudHistory>($"commerce/workspaces/{Uri.EscapeDataString(CloudId)}/history"); CloudVersions = response.Versions ?? []; CloudMessage = "Version history opened. Photos are not included."; }, "cloud-history");

    /// <summary>Opens a prior metadata version locally; saving later creates a new revision rather than rewriting history.</summary>
    Task RestoreCloudVersion(int revision) => Execute(async () => { var response = await Api.GetAsync<FieldWorkCloudVersionResponse>($"commerce/workspaces/{Uri.EscapeDataString(CloudId)}/history/{revision}"); await ApplyCloud(response.Version.Body); CloudTitle = response.Version.Title; CloudMessage += $" Opened version {revision} locally. Saving creates a new version."; }, "open-cloud-version");

    /// <summary>Extracts a bounded invitation token from an explicit product URL.</summary>
    static string QueryValue(string query, string name)
    {
        foreach (var part in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries)) { var pair = part.Split('=', 2); if (pair[0] == name && pair.Length == 2 && pair[1].Length <= 500) return Uri.UnescapeDataString(pair[1]); }
        return "";
    }

    /// <summary>Detaches a newly opened local project from any previously selected shared server document.</summary>
    void DetachCloud() { CloudId = ""; CloudRole = ""; CloudRevision = 0; CloudVersions = []; InvitationLink = ""; }

    /// <summary>Names the exact next lifecycle operation without skipping review.</summary>
    static string NextAction(FieldWorkStatus status) => status switch { FieldWorkStatus.Plan => "Start work", FieldWorkStatus.InProgress => "Request review", FieldWorkStatus.ReadyForReview => "Complete reviewed order", _ => "Complete" };

    /// <summary>Releases this product's JS module when the component leaves the browser view.</summary>
    public async ValueTask DisposeAsync()
    {
        if (Module is null) return;
        try { await Module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
