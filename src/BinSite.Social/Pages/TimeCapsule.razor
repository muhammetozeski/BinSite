@page "/zaman-kapsulu/"
@inherits ProductComponent
<PageTitle>@T("Zaman Kapsülü — Henüz açılmamış bir mektup", "Time Capsule — A letter not yet opened")</PageTitle>
<PageSurface>
<div class="capsule-page"><div class="wrap"><header><LanguageSwitch /><h1>@T("Zaman Kapsülü", "Time Capsule")</h1><p>Write a letter, choose when it opens and keep the link.</p></header>
@if (!string.IsNullOrEmpty(Status)) { <div class="status" data-error="@HasError.ToString().ToLowerInvariant()" role="status">@Status</div> }
<main>
@if (Current is null) { <section class="sheet"><h2>@T("Bir mesajı bugünden sakla.", "New letter")</h2><form @onsubmit="CreateAsync" @onsubmit:preventDefault><label for="capsule-title">@T("Zarfın üstüne ne yazalım?", "What goes on the envelope?")</label><input id="capsule-title" @bind="Title" required minlength="3" maxlength="100"><p class="small">@T("Başlık ve açılış zamanı, bağlantıyı bilenlere şimdiden görünür.", "The title and opening time are visible to link holders immediately.")</p><label for="capsule-message">@T("İçindeki mektup", "The letter inside")</label><textarea id="capsule-message" @bind="Message" required minlength="10" maxlength="5000"></textarea><label for="capsule-date">@T("Ne zaman açılsın? (bulunduğun yerin saati)", "When should it open? (your local time)")</label><input id="capsule-date" type="datetime-local" @bind="UnlockDate" @bind:format="yyyy-MM-ddTHH:mm" required><p class="small">@T("En az 1 dakika, en çok 10 yıl ilerisi. Tarih ve mesaj oluşturulduktan sonra değiştirilemez.", "At least 1 minute and at most 10 years ahead. The message and date cannot be edited after creation.")</p><details><summary>@T("Bir mektup fikri seç", "Choose a letter prompt")</summary><p class="small">@T("Bunlar yazmana yardımcı olan editoryal sorular; otomatik yayımlanmaz.", "Optional writing ideas.")</p>@foreach (var prompt in LetterPrompts()) { <button type="button" class="quiet" @onclick="() => Message = prompt">@prompt</button> }</details><p class="small">@T("Mesaj Cloudflare veritabanında tutulur; işletmeci içeriği görebilir. Hassas sır, şifre veya kimlik bilgisi yazma. Uçtan uca şifreleme, e-posta teslimi ve kalıcı saklama garantisi sunulmaz.", "The site operator can read stored letters. Do not include passwords or sensitive information.")</p><button type="submit" disabled="@Busy">@T("Mektubu mühürle", "Seal the letter")</button></form><details class="open-existing"><summary>@T("Elimde bir kapsül bağlantısı var", "I have a capsule link")</summary><form @onsubmit="OpenExistingAsync" @onsubmit:preventDefault><label for="capsule-link">@T("Bağlantıyı yapıştır", "Paste the link")</label><input id="capsule-link" @bind="ExistingLink" type="url" required><button type="submit" class="quiet" disabled="@Busy">@T("Kapsüle git", "Open envelope")</button></form></details></section> }
else { <section class="sheet"><span class="stamp">@(Current.Locked ? T("VAKTİ HENÜZ GELMEDİ", "ITS TIME HAS NOT COME") : T("MEKTUBUN AÇILDI", "YOUR LETTER IS OPEN"))</span><h2>@Current.Capsule.Title</h2><p class="small">@T("Açılış:", "Opens:") @DateLabel(Current.Capsule.UnlockAt)</p>@if (Current.Locked) { <p class="countdown">@RemainingLabel()</p><p class="small">@T("Kalan süre son sunucu yanıtındaki saate göredir. Güncel kilit durumunu aşağıdan kontrol et.", "Refresh to update the countdown.")</p> } else { <article class="message">@Current.Capsule.Body</article> }<div class="actions"><button disabled="@Busy" @onclick="() => CopyAsync(ShareLink())">@T("Bağlantıyı sakla / paylaş", "Save / share the link")</button><button class="quiet" disabled="@Busy" @onclick="RefreshAsync">@T("Sunucudan yeniden kontrol et", "Refresh")</button><button class="quiet" @onclick="NewCapsule">@T("Yeni kapsül", "New capsule")</button></div>@if (CopyFallback is not null) { <input class="copy-fallback" readonly value="@CopyFallback" aria-label="@T("Kapsül bağlantısı", "Capsule link")"> }<ReportBox Kind="capsule" TargetId="@Current.Capsule.Id" /></section> }
</main><details class="rules"><summary>Privacy and access</summary><p class="small">@T("Kapsüllerin gezilebilir listesi yok. Rastgele oluşturulan bağlantıyı bilen herkes tarihi geldiğinde okuyabilir. Bağlantıyı kaybetme; bu sürümde hesap ve bağlantı kurtarma yok. Sunucu kendi saatine göre içeriği açar; bilgisayar saatini değiştirmek kapsülü açmaz.", "Anyone with the link can read the letter after its opening time. Keep the link; lost links cannot be recovered. Capsules are not listed publicly.")</p><p class="small">@T("Kişisel bilgi, taciz, nefret söylemi, izinsiz eser ve spam paylaşma. Üç farklı ağ adresinden raporlanan kapsül otomatik gizlenir. Çerez kimliği, ağ adresinin özeti ve rapor gerekçesi kötüye kullanımı sınırlamak için saklanır; bu sürümde insan inceleme hizmeti sunulmaz.", "No personal information, harassment, hate, unauthorized works or spam. A capsule reported by three distinct network addresses is automatically hidden. Cookie identities, hashed network addresses and report reasons are stored to limit abuse. Reports are not reviewed by a person.")</p><p>No email delivery or permanent storage guarantee is provided. Keep your own copy.</p></details></div></div>
</PageSurface>
@code {
    [SupplyParameterFromQuery(Name = "kapsul")] public string? CapsuleId { get; set; }
    CapsuleDetail? Current;
    string Title = "", Message = "", ExistingLink = "";
    DateTime UnlockDate = DateTime.Now.AddDays(1);

    /// <summary>Loads an envelope only when a private share identity was supplied.</summary>
    protected override Task OnParametersSetAsync() => string.IsNullOrEmpty(CapsuleId) ? Task.CompletedTask : ExecuteAsync(() => LoadAsync(CapsuleId));
    /// <summary>Fetches an envelope; locked message content is absent from the server response.</summary>
    async Task LoadAsync(string id) { Current = await Api.GetAsync<CapsuleDetail>("capsules/" + id); CapsuleId = id; await Javascript.InvokeVoidAsync("binSiteSocial.replaceUrl", ShareLink()); }
    /// <summary>Creates one capsule with the selected browser-local date converted to a UTC instant.</summary>
    Task CreateAsync() => ExecuteAsync(async () => { var created = await Api.PostAsync<CreatedResponse>("capsules", new { title = Title, body = Message, unlockAt = new DateTimeOffset(UnlockDate).ToUniversalTime().ToString("O") }); CapsuleId = created.Id; await Javascript.InvokeVoidAsync("binSiteSocial.replaceUrl", ShareLink()); Message = ""; await LoadAsync(created.Id); }, T("Mektup mühürlendi. Bağlantıyı şimdi sakla; kaybedersen bu sürümde geri getirilemez.", "Letter sealed. Save the link; lost links cannot be recovered."));
    /// <summary>Refreshes the server's authoritative lock decision without relying on the browser clock.</summary>
    Task RefreshAsync() => string.IsNullOrEmpty(CapsuleId) ? Task.CompletedTask : ExecuteAsync(() => LoadAsync(CapsuleId));
    /// <summary>Validates a pasted same-origin capsule URL before reading its envelope.</summary>
    Task OpenExistingAsync() => ExecuteAsync(async () => { var url = new Uri(ExistingLink, UriKind.Absolute); if (url.GetLeftPart(UriPartial.Authority) != new Uri(Navigation.BaseUri).GetLeftPart(UriPartial.Authority)) throw new InvalidOperationException("Foreign capsule origin."); var parameter = url.Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries).Select(item => item.Split('=', 2)).FirstOrDefault(item => item.Length == 2 && item[0] == "kapsul"); if (parameter is null || string.IsNullOrWhiteSpace(parameter[1])) throw new InvalidOperationException("Missing capsule identity."); await LoadAsync(Uri.UnescapeDataString(parameter[1])); });
    /// <summary>Returns to a fresh envelope form without deleting any stored capsule.</summary>
    async Task NewCapsule() { Current = null; CapsuleId = null; CopyFallback = null; Title = Message = Status = ""; await Javascript.InvokeVoidAsync("binSiteSocial.replaceUrl", new Uri(new Uri(Navigation.BaseUri), "zaman-kapsulu/").AbsoluteUri); }
    /// <summary>Describes remaining time using the last server timestamp, rather than a client unlock assertion.</summary>
    string RemainingLabel() { if (Current is null) return ""; var duration = TimeSpan.FromMilliseconds(Math.Max(0, Current.Capsule.UnlockAt - Current.ServerNow)); return T($"Yaklaşık {duration.Days} gün, {duration.Hours} saat, {duration.Minutes} dakika", $"About {duration.Days} days, {duration.Hours} hours, {duration.Minutes} minutes"); }
    /// <summary>Returns optional editorial prompts in the current interface language.</summary>
    string[] LetterPrompts() => ["What would I like my future self to remember about today?", "Which small thing did you do for me that I never properly thanked you for?", "What do I hope we will have created together by the time this opens?", "Which ordinary detail from today do I want to preserve?", "What would I say at the start of a new chapter?"];
    /// <summary>Constructs the current capsule's unlisted share address.</summary>
    string ShareLink() => new Uri(new Uri(Navigation.BaseUri), "zaman-kapsulu/?kapsul=" + CapsuleId).AbsoluteUri;
}
