@page "/ortak-tuval/"
@inherits CommunityComponent
<PageTitle>@T("Ortak Tuval — Birlikte piksel piksel", "Shared Canvas — Build it pixel by pixel")</PageTitle>
<div class="canvas-page"><header><div class="headline"><div><span class="eyebrow">@T("24 × 16 ORTAK ÇİZİM ALANI", "A 24 × 16 COLLABORATIVE GRID")</span><h1>@T("Ortak Tuval", "Shared Canvas")</h1></div><LanguageSwitch /></div><p>@T("Bir küçük resim, birden fazla el. Hücreleri boya; en fazla 32 değişikliği tek paketle yayımla. Başka biri arada çizdiyse sunucu sessizce üstüne yazmaz.", "One small picture, many hands. Paint cells, then publish up to 32 changes in one batch. If someone else draws first, the server prevents a silent overwrite.")</p></header>
@if(Status.Length>0){<p class="status" role="status">@Status</p>}
<main><aside><h2>@T("Atölyeler", "Studios")</h2><form @onsubmit="CreateAsync" @onsubmit:preventDefault><label for="canvas-title">@T("Yeni tuvalin adı", "New canvas title")</label><input id="canvas-title" @bind="Title" required minlength="4" maxlength="100"><button type="submit" disabled="@Busy">@T("Boş tuval aç", "Create blank canvas")</button></form><button class="quiet" disabled="@Busy" @onclick="RefreshListAsync">@T("Atölyeleri yenile", "Refresh studios")</button><div class="studio-list">@foreach(var item in Canvases){<button class="studio" disabled="@Busy" @onclick="()=>OpenAsync(item.Id)"><strong>@item.Title</strong><span>@T("Sürüm", "Revision") @item.Revision</span></button>}</div><details><summary>@T("Bir çizim görevi seç", "Choose a drawing challenge")</summary>@foreach(var prompt in Prompts()){<button class="prompt" @onclick="()=>Challenge=prompt">@prompt</button>}</details></aside><section class="workspace">
@if(Current is null){<div class="empty"><h2>@T("İlk piksel kimden?", "Who will draw the first pixel?")</h2><p>@T("Bir tuval seç veya boş bir tuval oluştur. Örnek kullanıcı ve sahte çizim yok; ortak alanı siz doldurursunuz.", "Choose a canvas or create an empty one. No fake users or fabricated drawings: your group creates the canvas.")</p></div>}
else{<div class="canvas-heading"><h2>@Current.Canvas.Title</h2><span>@T("Sunucu sürümü", "Server revision") @Current.Canvas.Revision</span></div>@if(Challenge.Length>0){<p class="challenge">@Challenge</p>}<div class="palette" aria-label="@T("Renk seçimi", "Color palette")">@for(var index=0;index<Colors.Length;index++){var color=index;<button class="swatch" style="@($"background:{Colors[color]}")" aria-pressed="@(SelectedColor==color?"true":"false")" aria-label="@T(ColorNames[color],ColorEnglish[color])" @onclick="()=>SelectedColor=color"></button>}</div><p class="help">@T("Hücreye tıkla veya klavyeyle seçip Enter'a bas. Bekleyen hücreler çerçeveli görünür.", "Click a cell, or focus it and press Enter. Pending cells are outlined.")</p><div class="pixel-grid" role="group" aria-label="@T("24 sütun 16 satır çizim ızgarası", "Drawing grid: 24 columns, 16 rows")">@for(var row=0;row<16;row++){var y=row;@for(var column=0;column<24;column++){var x=column;var color=CellColor(x,y);<button class="@(Pending.ContainsKey((x,y))?"pixel pending":"pixel")" style="@($"background:{Colors[color]}")" aria-label="@($"{x+1}, {y+1}: {T(ColorNames[color],ColorEnglish[color])}")" @onclick="()=>Paint(x,y)"></button>}}</div><div class="controls"><button disabled="@(Busy||Pending.Count==0)" @onclick="PublishAsync">@T("Değişiklikleri yayımla", "Publish changes") (@Pending.Count/32)</button><button class="quiet" disabled="@Busy" @onclick="ReloadAsync">@T("Sunucudan yenile", "Reload from server")</button><button class="quiet" disabled="@Busy" @onclick="ClearPending">@T("Bekleyenleri geri al", "Discard pending changes")</button><button class="quiet" disabled="@Busy" @onclick="()=>CopyAsync(Link())">@T("Tuvali paylaş", "Share canvas")</button></div>@if(CopyFallback is not null){<input readonly class="copy-fallback" value="@CopyFallback">}<p class="help">@T("Yenilemek bekleyen hücrelerini korur. Çakışma sonrası güncel resmi görüp kendi hücrelerini yeniden yayımlayabilirsin. Gönderimler elle yapılır; bütün resim sürekli yeniden yazılmaz.", "Reloading retains pending cells. After a conflict, inspect the latest picture and publish your chosen cells again. Only explicitly submitted changed cells are written.")</p><ReportBox Kind="canvas" TargetId="@Current.Canvas.Id" Endpoint="community/reports" />}
</section></main><footer><p>@T("Tuval herkese açıktır ve Cloudflare veritabanında saklanır. Kimlik anonim çerezdir; kişi doğrulaması yoktur. Hakaret, nefret, kişisel bilgi ve izinsiz eser paylaşma. Üç farklı ağdan raporlanan tuval otomatik gizlenir; hız sınırları ağ özeti ve çerez kimliğiyle uygulanır. İnsan incelemesi hizmeti sunulmaz.", "Canvases are public and stored in a Cloudflare database. Identity uses an anonymous cookie, without person verification. No harassment, hate, personal information or unauthorized works. Three distinct-network reports automatically hide a canvas; request limits use network hashes and cookie identities. No human review service is provided.")</p></footer></div>
@code{
 [SupplyParameterFromQuery(Name="tuval")]public string? CanvasId{get;set;}
 static readonly string[] Colors=["#ffffff","#111111","#d00000","#f07800","#ffcf00","#008a2e","#007888","#1649e1","#7019bd","#d40091","#7d3f10","#858585"];
 static string[] ColorNames=>ColorEnglish;
 static readonly string[] ColorEnglish=["White","Charcoal","Red","Orange","Yellow","Green","Teal","Blue","Purple","Pink","Earth","Grey"];
 List<CanvasInfo> Canvases=[];CanvasDetail? Current;readonly Dictionary<(int,int),int> Pending=[];string Title="",Challenge="";int SelectedColor=1;
 /// <summary>Loads real canvas headers and an optional shared canvas.</summary>
 protected override Task OnParametersSetAsync()=>ExecuteAsync(async()=>{await LoadListAsync();if(!string.IsNullOrEmpty(CanvasId))await LoadAsync(CanvasId);});
 /// <summary>Reads the bounded studio directory.</summary>
 async Task LoadListAsync()=>Canvases=(await ReadAsync<CanvasList>("canvases")).Canvases;
 /// <summary>Refreshes actual studio headers.</summary>
 Task RefreshListAsync()=>ExecuteAsync(LoadListAsync);
 /// <summary>Opens a selected studio and clears unsent pixels from the previous studio.</summary>
 Task OpenAsync(string id)=>ExecuteAsync(async()=>{Pending.Clear();await LoadAsync(id);});
 /// <summary>Reads the actual current revision and updates the independent share URL.</summary>
 async Task LoadAsync(string id){Current=await ReadAsync<CanvasDetail>("canvases/"+id);await ReplaceAsync(Link());}
 /// <summary>Creates a shared empty canvas without generating fabricated activity.</summary>
 Task CreateAsync()=>ExecuteAsync(async()=>{var created=await WriteAsync<CreatedResponse>("canvases",new{title=Title});Pending.Clear();await LoadAsync(created.Id);Title="";await LoadListAsync();});
 /// <summary>Retains local edits while refreshing the authoritative server revision.</summary>
 Task ReloadAsync()=>Current is null?Task.CompletedTask:ExecuteAsync(()=>LoadAsync(Current.Canvas.Id));
 /// <summary>Changes one local pending cell, bounded to a 32-cell publication batch.</summary>
 void Paint(int x,int y){if(Pending.Count>=32&&!Pending.ContainsKey((x,y))){Status=T("32 hücrelik paket doldu. Önce yayımla veya bekleyenleri geri al.","The 32-cell batch is full. Publish or discard pending cells first.");return;}Pending[(x,y)]=SelectedColor;}
 /// <summary>Returns a local preview color before falling back to the server snapshot.</summary>
 int CellColor(int x,int y)=>Pending.TryGetValue((x,y),out var color)?color:Current?.Cells.FirstOrDefault(cell=>cell.X==x&&cell.Y==y)?.Color??0;
 /// <summary>Sends only changed cells with their expected server revision; conflicts preserve the pending batch.</summary>
 Task PublishAsync()=>ExecuteAsync(async()=>{if(Current is null||Pending.Count==0)return;Current=await WriteAsync<CanvasDetail>($"canvases/{Current.Canvas.Id}/pixels",new{revision=Current.Canvas.Revision,cells=Pending.Select(cell=>new{x=cell.Key.Item1,y=cell.Key.Item2,color=cell.Value}).ToArray()});Pending.Clear();await LoadListAsync();},T("Hücrelerin ortak tuvale işlendi.","Your cells were published to the shared canvas."));
 /// <summary>Discards only unsent local pixel edits.</summary>
 void ClearPending()=>Pending.Clear();
 /// <summary>Builds a public independent canvas link.</summary>
 string Link()=>ContentLink("ortak-tuval","tuval",Current?.Canvas.Id??"");
 /// <summary>Offers distinct editorial constraints as optional collaboration exercises.</summary>
 string[] Prompts()=>["Build a skyline where every person owns one building.","Make a creature using only five colors.","Draw a tiny garden; leave paths for the next person.","Create an imaginary flag without borrowing a real one.","Represent one sound using only shapes.","Build a maze together and reserve a visible exit.","Make a four-panel story using only pixels.","Create a map of a place that does not exist."];
}
