@page "/ortak-tuval/"
@inherits CommunityComponent
<PageTitle>@T("Ortak Tuval — Birlikte piksel piksel", "Shared Canvas — Build it pixel by pixel")</PageTitle>
<PageSurface>
<div class="canvas-page"><header><div class="headline"><div><h1>@T("Ortak Tuval", "Shared Canvas")</h1><p>Share a canvas. Paint some pixels, then save your changes.</p></div><LanguageSwitch /></div></header>
@if(Status.Length>0){<p class="status" role="status">@Status</p>}
<main><aside><h2>@T("Atölyeler", "Canvases")</h2><form @onsubmit="CreateAsync" @onsubmit:preventDefault><label for="canvas-title">@T("Yeni tuvalin adı", "New canvas title")</label><input id="canvas-title" @bind="Title" required minlength="4" maxlength="100"><button type="submit" disabled="@Busy">@T("Boş tuval aç", "Create blank canvas")</button></form><button class="quiet" disabled="@Busy" @onclick="RefreshListAsync">@T("Atölyeleri yenile", "Refresh canvases")</button><div class="studio-list">@foreach(var item in Canvases){<button class="studio" disabled="@Busy" @onclick="()=>OpenAsync(item.Id)"><strong>@item.Title</strong></button>}</div><details><summary>@T("Bir çizim görevi seç", "Choose a drawing challenge")</summary>@foreach(var prompt in Prompts()){<button class="prompt" @onclick="()=>Challenge=prompt">@prompt</button>}</details></aside><section class="workspace">@if(Challenge.Length>0){<p class="challenge">@Challenge</p>}
@if(Current is null){<div class="empty"><h2>@T("İlk piksel kimden?", "Choose a canvas or start a new one.")</h2><p>@T("Bir tuval seç veya boş bir tuval oluştur. Örnek kullanıcı ve sahte çizim yok; ortak alanı siz doldurursunuz.", "Invite others with the canvas link.")</p></div>}
else{<div class="canvas-heading"><h2>@Current.Canvas.Title</h2></div><div class="palette" data-appearance-preserve aria-label="@T("Renk seçimi", "Color palette")">@for(var index=0;index<Colors.Length;index++){var color=index;<button class="swatch" disabled="@Busy" style="@($"background:{Colors[color]}")" aria-pressed="@(SelectedColor==color?"true":"false")" aria-label="@T(ColorNames[color],ColorEnglish[color])" @onclick="()=>SelectedColor=color"></button>}</div><p class="help">@T("Hücreye tıkla veya klavyeyle seçip Enter'a bas. Bekleyen hücreler çerçeveli görünür.", "Click a cell, or focus it and press Enter. Pending cells are outlined.")</p><div class="pixel-grid" data-appearance-preserve role="group" aria-label="@T("24 sütun 16 satır çizim ızgarası", "Drawing grid: 24 columns, 16 rows")">@for(var row=0;row<16;row++){var y=row;@for(var column=0;column<24;column++){var x=column;var color=CellColor(x,y);<button class="@(Pending.ContainsKey((x,y))?"pixel pending":"pixel")" disabled="@Busy" style="@($"background:{Colors[color]}")" aria-label="@($"{x+1}, {y+1}: {T(ColorNames[color],ColorEnglish[color])}")" @onclick="()=>Paint(x,y)"></button>}}</div><div class="controls"><button disabled="@(Busy||Pending.Count==0)" @onclick="PublishAsync">@T("Değişiklikleri yayımla", "Save changes") (@Pending.Count)</button><button class="quiet" disabled="@Busy" @onclick="ReloadAsync">@T("Sunucudan yenile", "Refresh")</button><button class="quiet" disabled="@(Busy || Pending.Count == 0)" @onclick="ClearPending">@T("Bekleyenleri geri al", "Discard pending changes")</button><button class="quiet" disabled="@Busy" @onclick="()=>CopyAsync(Link())">@T("Tuvali paylaş", "Copy canvas link")</button></div>@if(CopyFallback is not null){<input readonly class="copy-fallback" value="@CopyFallback">}<p class="help">@T("Yenilemek bekleyen hücrelerini korur. Çakışma sonrası güncel resmi görüp kendi hücrelerini yeniden yayımlayabilirsin. Gönderimler elle yapılır; bütün resim sürekli yeniden yazılmaz.", "Refresh keeps your unsaved cells. After a conflict, review the picture and save your chosen cells again.")</p><ReportBox Kind="canvas" TargetId="@Current.Canvas.Id" Endpoint="community/reports" />}
</section></main><footer><details class="page-help"><summary>Privacy and safety</summary><p>Canvases are public. Do not share private information, abuse, spam or work you lack permission to share. Reports are not reviewed by a person.</p></details></footer></div>
</PageSurface>
@code{
 [SupplyParameterFromQuery(Name="tuval")]public string? CanvasId{get;set;}
 static readonly string[] Colors=["#ffffff","#111111","#d00000","#f07800","#ffcf00","#008a2e","#007888","#1649e1","#7019bd","#d40091","#7d3f10","#858585"];
 static string[] ColorNames=>ColorEnglish;
 static readonly string[] ColorEnglish=["White","Charcoal","Red","Orange","Yellow","Green","Teal","Blue","Purple","Pink","Earth","Grey"];
 List<CanvasInfo> Canvases=[];CanvasDetail? Current;readonly Dictionary<(int,int),int> Pending=[];string Title="",Challenge="";int SelectedColor=1;
 /// <summary>Loads real canvas headers and an optional shared canvas.</summary>
 protected override Task OnParametersSetAsync()=>ExecuteAsync(async()=>{await LoadListAsync();if(!string.IsNullOrEmpty(CanvasId))await LoadAsync(CanvasId);});
 /// <summary>Reads the bounded studio directory.</summary>
 async Task LoadListAsync()=>Canvases=(await ReadAsync<CanvasList>("canvases")).Canvases;
 /// <summary>Refreshes actual studio headers.</summary>
 Task RefreshListAsync()=>ExecuteAsync(LoadListAsync);
 /// <summary>Opens a selected studio and clears unsent pixels from the previous studio.</summary>
 Task OpenAsync(string id){if(Pending.Count>0){Status="Save or discard your changes before opening another canvas.";return Task.CompletedTask;}return ExecuteAsync(()=>LoadAsync(id));}
 /// <summary>Reads the actual current revision and updates the independent share URL.</summary>
 async Task LoadAsync(string id){Current=await ReadAsync<CanvasDetail>("canvases/"+id);await ReplaceAsync(Link());}
 /// <summary>Creates a shared empty canvas without generating fabricated activity.</summary>
 Task CreateAsync(){if(Pending.Count>0){Status="Save or discard your changes before creating another canvas.";return Task.CompletedTask;}return ExecuteAsync(async()=>{var created=await WriteAsync<CreatedResponse>("canvases",new{title=Title});Pending.Clear();await LoadAsync(created.Id);Title="";await LoadListAsync();});}
 /// <summary>Retains local edits while refreshing the authoritative server revision.</summary>
 Task ReloadAsync()=>Current is null?Task.CompletedTask:ExecuteAsync(()=>LoadAsync(Current.Canvas.Id));
 /// <summary>Changes one local pending cell, bounded to a 32-cell publication batch.</summary>
 void Paint(int x,int y){if(Busy)return;if(Pending.Count>=32&&!Pending.ContainsKey((x,y))){Status=T("32 hücrelik paket doldu. Önce yayımla veya bekleyenleri geri al.","Save your changes before painting more pixels.");return;}Pending[(x,y)]=SelectedColor;}
 /// <summary>Returns a local preview color before falling back to the server snapshot.</summary>
 int CellColor(int x,int y)=>Pending.TryGetValue((x,y),out var color)?color:Current?.Cells.FirstOrDefault(cell=>cell.X==x&&cell.Y==y)?.Color??0;
 /// <summary>Sends only changed cells with their expected server revision; conflicts preserve the pending batch.</summary>
 Task PublishAsync()=>ExecuteAsync(async()=>{if(Current is null||Pending.Count==0)return;Current=await WriteAsync<CanvasDetail>($"canvases/{Current.Canvas.Id}/pixels",new{revision=Current.Canvas.Revision,cells=Pending.Select(cell=>new{x=cell.Key.Item1,y=cell.Key.Item2,color=cell.Value}).ToArray()});Pending.Clear();await LoadListAsync();},T("Hücrelerin ortak tuvale işlendi.","Drawing saved."));
 /// <summary>Discards only unsent local pixel edits.</summary>
 void ClearPending(){if(Busy)return;Pending.Clear();}
 /// <summary>Builds a public independent canvas link.</summary>
 string Link()=>ContentLink("ortak-tuval","tuval",Current?.Canvas.Id??"");
 /// <summary>Offers distinct editorial constraints as optional collaboration exercises.</summary>
 string[] Prompts()=>["Build a skyline where every person owns one building.","Make a creature using only five colors.","Draw a tiny garden; leave paths for the next person.","Create an imaginary flag without borrowing a real one.","Represent one sound using only shapes.","Build a maze together and reserve a visible exit.","Make a four-panel story using only pixels.","Create a map of a place that does not exist."];
}
