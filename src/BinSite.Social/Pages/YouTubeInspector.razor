@page "/youtube-tools/"
@using BinSite.Social.Models
@using Microsoft.JSInterop
@inject IJSRuntime Javascript
@implements IAsyncDisposable

<PageTitle>Check YouTube links</PageTitle>
<main class="youtube-tool">
    <header><a href="/">← Tools</a><h1>Check YouTube links</h1></header>
    <p>Get video titles and thumbnails, then export a table or thumbnail sheet.</p>
    <label for="youtube-links">Video links <span>· up to 20</span></label>
    <textarea id="youtube-links" rows="4" maxlength="16000" spellcheck="false" placeholder="Paste YouTube links, one per line" @bind="Input" @bind:event="oninput" disabled="@Busy"></textarea>
    <div class="actions">
        <button class="primary" disabled="@(Busy || Module is null || string.IsNullOrWhiteSpace(Input))" @onclick="Check">Check links</button>
        @if (Busy && CanCancel) { <button @onclick="Cancel">Cancel</button> }
        @if (Rows.Count > 0) {
        <button disabled="@Busy" @onclick='() => Output("copy")'>Copy results</button>
        <button disabled="@(Busy || Rows.Count == 0)" @onclick='() => Output("csv")'>Export table</button>
        <button disabled="@(Busy || AvailableImageCount == 0)" @onclick='() => Output("sheet")'>Thumbnail sheet</button>
        }
        @if (Rows.Count > 0 || Input.Length > 0) { <button disabled="@Busy" @onclick="Clear">Clear</button> }
    </div>
    @if (Busy) { <p class="status" role="status">@WorkingText</p> }
    @if (!string.IsNullOrEmpty(Message)) { <p class="status" role="status">@Message</p> }
    @if (!string.IsNullOrEmpty(Error)) { <p class="error" role="alert">@Error</p> }
    @if (Preview is not null)
    {
        <section id="youtube-preview" class="preview" tabindex="-1" aria-label="Thumbnail preview">
            <button class="close" @onclick="() => Preview = null">Close preview</button>
            <h2>@Preview.Title</h2>
            <img src="@Preview.ThumbnailUrl" alt="@Preview.Title" referrerpolicy="no-referrer" />
            <p>@Preview.Channel · @Preview.Width × @Preview.Height</p>
            <button disabled="@Busy" @onclick='() => Output("thumbnail", Preview.Id)'>Download image</button>
        </section>
    }
    @if (Rows.Count > 0)
    {
        <p class="summary">@AvailableCount of @Rows.Count videos found</p>
        <div class="results">
            @foreach (var row in Rows)
            {
                <article class="result">
                    <div class="image">
                        @if (row.ThumbnailUrl is not null)
                        {
                            <button class="thumbnail" aria-label="Preview thumbnail" disabled="@Busy" @onclick="() => ShowPreview(row)"><img src="@row.ThumbnailUrl" alt="@row.Title" loading="lazy" referrerpolicy="no-referrer" /></button>
                        }
                        else { <span class="empty-image">No thumbnail</span> }
                    </div>
                    <div class="details">
                        <p class="availability @(row.Status == "available" ? "available" : "")">@StatusText(row) @if (row.DuplicateOf is int duplicate) { <span>· same video as @duplicate</span> }</p>
                        @if (row.Title is not null) { <h2><a href="@row.Url" target="_blank" rel="noopener noreferrer">@row.Title</a></h2> }
                        @if (row.Channel is not null) { <p>@if (row.ChannelUrl is not null) { <a href="@row.ChannelUrl" target="_blank" rel="noopener noreferrer">@row.Channel</a> } else { @row.Channel }</p> }
                        @if (row.Width.HasValue && row.Height.HasValue) { <p class="dimensions">@row.Width × @row.Height</p> }
                        @if (row.Title is null) { <p class="input-link">@row.Input</p> }
                        <div class="row-actions">
                            @if (row.Url is not null && row.Title is null) { <a href="@row.Url" target="_blank" rel="noopener noreferrer">Open video</a> }
                        </div>
                    </div>
                </article>
            }
        </div>

    }
</main>

@code {
    private IJSObjectReference? Module;
    private string Session = "", Input = "", Message = "", Error = "", WorkingText = "Checking…";
    private List<YouTubeLinkRow> Rows = [];
    private YouTubeLinkRow? Preview;
    private bool Busy, Disposed, FocusPreview, CanCancel;
    private void ShowPreview(YouTubeLinkRow row) { Preview = row; FocusPreview = true; }
    private int AvailableImageCount => Rows.Count(row => row.Status == "available" && row.ThumbnailUrl is not null);
    private int AvailableCount => Rows.Count(row => row.Status == "available");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (FocusPreview) { FocusPreview = false; await Javascript.InvokeVoidAsync("binSiteSocial.focusField", "youtube-preview"); }
        if (!firstRender) return;
        try
        {
            var module = await Javascript.InvokeAsync<IJSObjectReference>("import", "/youtube-inspector.js");
            if (Disposed) { await module.DisposeAsync(); return; }
            var session = await module.InvokeAsync<string>("create");
            if (Disposed) { await module.InvokeVoidAsync("dispose", session); await module.DisposeAsync(); return; }
            Module = module;
            Session = session;
        }
        catch (JSException) { Error = "The tool could not load. Refresh and try again."; }
        if (!Disposed) StateHasChanged();
    }
    private async Task Check()
    {
        if (Busy || Module is null) return;
        Busy = true; CanCancel = true; Error = ""; Message = ""; Preview = null; WorkingText = "Checking links…";
        try
        {
            var result = await Module.InvokeAsync<YouTubeLinkBatch>("check", Session, Input);
            if (Disposed) return;
            Rows = result.Rows;
            Message = result.Canceled ? "Canceled. Completed checks are shown." : "";
        }
        catch (JSException ex) { if (!Disposed) Error = ex.Message.Split('\n')[0]; }
        finally { if (!Disposed) { Busy = false; CanCancel = false; } }
    }
    private async Task Cancel()
    {
        if (Module is null || !Busy || !CanCancel) return;
        WorkingText = "Canceling…";
        await Module.InvokeVoidAsync("cancel", Session);
    }
    private async Task Output(string kind, string? videoId = null)
    {
        if (Busy || Module is null) return;
        Busy = true; CanCancel = kind is "thumbnail" or "sheet"; Error = ""; Message = ""; WorkingText = kind == "sheet" ? "Preparing thumbnail sheet…" : "Preparing output…";
        try
        {
            if (kind == "copy") { await Module.InvokeVoidAsync("copyResults", Session); if (!Disposed) Message = "Results copied."; }
            else if (kind == "csv") { await Module.InvokeVoidAsync("exportCsv", Session); if (!Disposed) Message = "Table file sent to downloads."; }
            else
            {
                var result = kind == "thumbnail"
                    ? await Module.InvokeAsync<YouTubeImageOutput>("downloadThumbnail", Session, videoId)
                    : await Module.InvokeAsync<YouTubeImageOutput>("contactSheet", Session);
                if (!Disposed) Message = result.Canceled ? "Canceled." : kind == "sheet" ? $"Saved {result.Count} thumbnails in one PNG." + (result.Skipped > 0 ? $" {result.Skipped} images unavailable." : "") : "Image sent to downloads.";
            }
        }
        catch (JSException ex) { if (!Disposed) Error = ex.Message.Split('\n')[0]; }
        finally { if (!Disposed) { Busy = false; CanCancel = false; } }
    }
    private async Task Clear() { if (Busy || Module is null) return; Busy = true; try { await Module.InvokeVoidAsync("clear", Session); if (!Disposed) { Input = ""; Rows = []; Preview = null; Message = ""; Error = ""; } } finally { if (!Disposed) { Busy = false; CanCancel = false; } } }
    private static string StatusText(YouTubeLinkRow row) => row.Status switch
    {
        "available" => "Details found",
        "unavailable" => "Details unavailable",
        "invalid" => row.Message,
        "canceled" => "Canceled",
        _ => row.Message
    };
    public async ValueTask DisposeAsync()
    {
        Disposed = true;
        if (Module is null) return;
        try { await Module.InvokeVoidAsync("dispose", Session); await Module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}


