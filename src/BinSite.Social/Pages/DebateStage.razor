@page "/munazara-sahnesi/"
@inherits CommunityComponent
<PageTitle>@T("Münazara Sahnesi — Savı kur, gerekçeyi göster", "Debate Stage — State a claim and show the reasoning")</PageTitle>
<PageSurface>
<div class="debate-page"><header><div class="masthead"><LanguageSwitch /></div><h1>@T("Münazara Sahnesi", "Debate Stage")</h1><p>Discuss a question with reasons, evidence and counterarguments.</p><div class="toolbar"><button @onclick="()=>Creating=true">@T("Yeni önerme kur", "Start a discussion")</button><button class="quiet" disabled="@Busy" @onclick="RefreshAsync">@T("Önermeleri yenile", "Refresh discussions")</button></div></header>
@if(Status.Length>0){<div role="status" class="status">@Status</div>}
<main><aside><h2>@T("Açık oturumlar", "Discussions")</h2><div class="session-list">@foreach(var debate in Debates){<button class="session" @onclick="()=>OpenAsync(debate.Id)" disabled="@Busy"><strong>@debate.Title</strong><span>@debate.ArgumentCount @T("gerekçeli sav", "reasoned arguments")</span></button>}</div><details><summary>@T("12 editoryal tartışma önerisi", "Discussion ideas")</summary><p class="small">@T("Bunlar gerçek kullanıcı oturumları değil, senin düzenleyip yayımlayabileceğin başlangıç taslaklarıdır. Metinler Türkçedir.", "Examples you can edit before publishing.")</p>@foreach(var prompt in Prompts){<button class="session" @onclick="()=>UsePrompt(prompt)"><strong>@prompt.Title</strong><span>@prompt.Context</span></button>}</details></aside><section class="stage">
@if(Creating){<section class="composer"><h2>@T("Sınırları belli bir önerme", "Start a discussion")</h2><form @onsubmit="CreateAsync" @onsubmit:preventDefault><label for="debate-title">@T("Önerme veya soru", "Question")</label><input id="debate-title" @bind="Title" required minlength="10" maxlength="180"><label for="debate-context">@T("Bağlam: neyi tartışıyoruz?", "Context: what is being discussed?")</label><textarea id="debate-context" @bind="Context" required minlength="30" maxlength="2000"></textarea><p class="small">@T("Kapsamı, önemli terimleri ve tartışmanın hangi koşullarda geçerli olduğunu belirt. Başlık ve bağlam herkese açık yayımlanır.", "Your question and context will be public.")</p><div class="toolbar"><button type="submit" disabled="@Busy">@T("Oturumu aç", "Publish question")</button><button class="quiet" type="button" @onclick="()=>Creating=false">@T("Vazgeç", "Cancel")</button></div></form></section>}
@if(Current is null && !Creating){<div class="empty"><h2>@T("Bir önerme seç, hangi gerekçenin eksik olduğunu bul.", "Choose a discussion or start one.")</h2><p>@T("Taraf seçmekten fazlası: her savın açıklaması, isteğe bağlı kaynak bağlantısı ve karşısav ilişkisi bulunur.", "Add a reason, link evidence or answer an argument.")</p></div>}
else if(Current is not null && !Creating){<section class="proposition"><h2>@Current.Debate.Title</h2><p>@Current.Debate.Context</p><div class="toolbar"><button class="quiet" @onclick="ReloadAsync" disabled="@Busy">@T("Sav haritasını yenile", "Refresh discussion")</button><button class="quiet" @onclick="()=>CopyAsync(Link())" disabled="@Busy">@T("Oturumu paylaş", "Copy discussion link")</button></div>@if(CopyFallback is not null){<input readonly class="copy-fallback" value="@CopyFallback">}<ReportBox Kind="debate" TargetId="@Current.Debate.Id" Endpoint="community/reports" /></section>
<div class="argument-columns">@for(var column=0;column<2;column++){var side=column;<section class="@(side==0?"side pro":"side con")"><h3>@(side==0?T("Destekleyen savlar", "Supporting arguments"):T("Karşısavlar", "Opposing arguments"))</h3>@foreach(var argument in Current.Arguments.Where(item=>item.Side==side)){<article class="argument" @key="argument.Id"><h4>@argument.Claim</h4>@if(argument.ParentId is not null){<p class="reply">@T("Yanıtladığı sav:", "Responds to:") @ParentLabel(argument.ParentId)</p>}<p>@argument.Reasoning</p>@if(argument.EvidenceUrl.Length>0){<a href="@argument.EvidenceUrl" target="_blank" rel="noopener noreferrer nofollow">@T("Yazarın kanıt bağlantısı", "Read source")</a>}<p class="review-result">@argument.ReviewCount @T("değerlendirme", "reviews") @if(argument.ReviewCount>0){<span>· @T("açıklık", "clarity") @argument.Clarity.ToString("0.0")/3 · @T("kanıt", "evidence") @argument.Evidence.ToString("0.0")/3</span>}</p><button class="quiet" @onclick="()=>ReplyTo(argument)">@T("Karşısavla yanıtla", "Respond with a counterargument")</button>@if(argument.Mine==0&&argument.Reviewed==0){<details><summary>@T("Gerekçeyi değerlendir", "Review the reasoning")</summary><p class="small">@T("Açıklık: 1 belirsiz, 2 kısmen açık, 3 kapsamı açık. Kanıt: 1 destek yok, 2 ilgili ama sınırlı, 3 savla doğrudan bağlantılı ve incelenebilir. Bu puanlar kullanıcı görüşüdür; doğruluk kararı değildir.", "Rate the reasoning, rather than whether you agree with it.")</p><label>@T("Açıklık", "Clarity")<select value="@ReviewValue(Clarity,argument.Id)" @onchange="e=>SetReview(Clarity,argument.Id,e)"><option value="1">Unclear</option><option value="2">Partly clear</option><option value="3">Clear</option></select></label><label>@T("Kanıt niteliği", "Evidence quality")<select value="@ReviewValue(Evidence,argument.Id)" @onchange="e=>SetReview(Evidence,argument.Id,e)"><option value="1">Unsupported</option><option value="2">Some support</option><option value="3">Strong support</option></select></label><button disabled="@Busy" @onclick="()=>ReviewAsync(argument.Id)">@T("Değerlendirmeyi kaydet", "Save review")</button></details>}else if(argument.Reviewed>0){<p class="small">@T("Bu savı değerlendirdin.", "You reviewed this argument.")</p>}<ReportBox Kind="argument" TargetId="@argument.Id" Endpoint="community/reports" /></article>}</section>}</div>
<section class="composer"><h3>@T("Savını yapılandır", "Structure your argument")</h3>@if(ParentId is not null){<p class="reply">@T("Yanıtladığın sav:", "Your response targets:") @ParentLabel(ParentId) <button class="quiet" @onclick="()=>ParentId=null">@T("Bağı kaldır", "Write a separate argument")</button></p>}<form @onsubmit="AddArgumentAsync" @onsubmit:preventDefault><label for="argument-side">@T("Taraf", "Side")</label><select id="argument-side" @bind="Side" disabled="@(ParentId is not null)"><option value="0">@T("Destekleyen", "Supporting")</option><option value="1">@T("Karşı çıkan", "Opposing")</option></select><label for="argument-claim">@T("Tek cümlelik sav", "One-sentence claim")</label><input id="argument-claim" @bind="Claim" required minlength="10" maxlength="240"><label for="argument-reasoning">@T("Neden? Hangi koşulda? Hangi karşı örnek önemli?", "Why? Under what conditions? Which counterexample matters?")</label><textarea id="argument-reasoning" @bind="Reasoning" required minlength="40" maxlength="1800"></textarea><label for="argument-evidence">@T("İsteğe bağlı kanıt bağlantısı (http/https)", "Source link (optional)")</label><input id="argument-evidence" @bind="EvidenceUrl" type="url" maxlength="800"><button type="submit" disabled="@Busy">@T("Savı yayımla", "Publish argument")</button></form></section>}
</section></main><footer><details class="page-help"><summary>Privacy and safety</summary><p>Questions, arguments and reviews are public. Reviews are opinions, not fact-checks. You cannot review your own argument. Do not post private information, abuse, spam or work you lack permission to share. Reports are not reviewed by a person.</p></details></footer></div>
</PageSurface>
@code{
 [SupplyParameterFromQuery(Name="oturum")]public string? DebateId{get;set;}
 bool FocusArgument; protected override async Task OnAfterRenderAsync(bool firstRender){if(FocusArgument){FocusArgument=false;await Javascript.InvokeVoidAsync("binSiteSocial.focusField","argument-claim");}}
 List<DebateSummary> Debates=[];DebateDetail? Current;bool Creating;string Title="",Context="",Claim="",Reasoning="",EvidenceUrl="";int Side;string? ParentId;readonly Dictionary<string,int> Clarity=[],Evidence=[];
 static readonly DebatePrompt[] Prompts=[
new("Should shared workspaces have quiet hours?","Consider concentration, conversation and teamwork in one small workspace. Define the proposed quiet hours and their exceptions."),
new("Should games use shared goals instead of individual scores?","Discuss a game that gives all players the same goal. Separate competition, cooperation and personal progress before comparing designs."),
new("Should participants set a neighborhood event calendar?","Consider the relationship between topic selection, access, preparation time and organizer responsibility in a local activity group."),
new("Should museum visitors be able to change an exhibition's order?","Compare a curator's narrative with a visitor's curiosity. Focus on ordering decisions in a digital exhibition rather than physical artifact safety."),
new("Should short stories have one author or many?","Use a specific writing community to examine creative consistency, multiple voices and the design decisions that support each."),
new("Should all hours count equally in a skill exchange?","Define effort, preparation, experience and accessibility, then consider fair matching in a voluntary community without payments."),
new("Should a new community member contribute on the first day?","Discuss a newcomer's choices to read, observe, ask or make something. Consider both participation pressure and belonging."),
new("Should city games use only public routes?","Consider access, safety, use of space and surprise within one fictional city-game design. Do not assume the conditions of a particular real city."),
new("Should a social product hide like counts?","Separate content quality, discovery and feedback. Discuss which users should see counts, in what context and at what time."),
new("Should creative contests display the making process?","Discuss how showing drafts and unsuccessful attempts alongside finished work could affect participation, learning and review."),
new("Should every collaborator be able to edit every part of a canvas?","Consider the boundary between open contribution and preserving existing work. Compare undo, reserved areas and ways to resolve disagreement."),
new("Should cooperative game roles be assigned randomly?","Discuss role assignment in a four-player puzzle, including newcomer learning, experienced-player guidance and replay choices.")];
 /// <summary>Loads actual sessions and an optional shared argument map.</summary>
 protected override Task OnParametersSetAsync()=>ExecuteAsync(async()=>{await LoadListAsync();if(!string.IsNullOrEmpty(DebateId))await LoadAsync(DebateId);else if(Debates.Count==0)Creating=true;});
 /// <summary>Reads the bounded public session directory.</summary>
 async Task LoadListAsync()=>Debates=(await ReadAsync<DebateList>("debates")).Debates;
 /// <summary>Refreshes real sessions.</summary>
 Task RefreshAsync()=>ExecuteAsync(LoadListAsync);
 /// <summary>Opens one public proposition.</summary>
 Task OpenAsync(string id)=>ExecuteAsync(()=>LoadAsync(id));
 /// <summary>Loads structured arguments, review aggregates and this identity's review state.</summary>
 async Task LoadAsync(string id){Current=await ReadAsync<DebateDetail>("debates/"+id);await ReplaceAsync(Link());}
 /// <summary>Refreshes the displayed proposition and its arguments.</summary>
 Task ReloadAsync()=>Current is null?Task.CompletedTask:ExecuteAsync(()=>LoadAsync(Current.Debate.Id));
 /// <summary>Fills an unpublished proposition from an explicitly editorial prompt.</summary>
 void UsePrompt(DebatePrompt prompt){Title=prompt.Title;Context=prompt.Context;Creating=true;}
 /// <summary>Publishes a proposition with an explicit scope.</summary>
 Task CreateAsync()=>ExecuteAsync(async()=>{var created=await WriteAsync<CreatedResponse>("debates",new{title=Title,context=Context});await LoadAsync(created.Id);Creating=false;Title=Context="";await LoadListAsync();});
 /// <summary>Prepares an argument on the opposite side of a specific existing claim.</summary>
 void ReplyTo(ArgumentInfo argument){ParentId=argument.Id;Side=1-argument.Side;FocusArgument=true;}
 /// <summary>Publishes one reasoned argument, optionally linked as a counterargument.</summary>
 Task AddArgumentAsync()=>ExecuteAsync(async()=>{if(Current is null)return;await WriteAsync<CreatedResponse>($"debates/{Current.Debate.Id}/arguments",new{side=Side,claim=Claim,reasoning=Reasoning,evidenceUrl=EvidenceUrl,parentId=ParentId});Claim=Reasoning=EvidenceUrl="";ParentId=null;await LoadAsync(Current.Debate.Id);await LoadListAsync();},T("Savın gerekçesiyle birlikte yayımlandı.","Your argument and reasoning were published."));
 /// <summary>Returns the selected rubric value or its neutral middle starting value.</summary>
 static int ReviewValue(Dictionary<string,int> values,string id)=>values.GetValueOrDefault(id,2);
 /// <summary>Stores a local rubric draft without submitting a vote.</summary>
 static void SetReview(Dictionary<string,int> values,string id,ChangeEventArgs change){if(int.TryParse(change.Value?.ToString(),out var score)&&score is >=1 and <=3)values[id]=score;}
 /// <summary>Records a peer-only two-axis rubric review, once per anonymous identity.</summary>
 Task ReviewAsync(string id)=>ExecuteAsync(async()=>{await WriteAsync<object>($"arguments/{id}/reviews",new{clarity=ReviewValue(Clarity,id),evidence=ReviewValue(Evidence,id)});if(Current is not null)await LoadAsync(Current.Debate.Id);},T("Değerlendirmen kaydedildi.","Your review was saved."));
 /// <summary>Resolves a visible parent claim without exposing hidden text.</summary>
 string ParentLabel(string id)=>Current?.Arguments.FirstOrDefault(item=>item.Id==id)?.Claim??T("Gizlenen veya erişilemeyen sav", "A hidden or unavailable argument");
 /// <summary>Returns this debate's independent share URL.</summary>
 string Link()=>ContentLink("munazara-sahnesi","oturum",Current?.Debate.Id??"");
}
