@page "/munazara-sahnesi/"
@inherits CommunityComponent
<PageTitle>@T("Münazara Sahnesi — Savı kur, gerekçeyi göster", "Debate Stage — State a claim and show the reasoning")</PageTitle>
<div class="debate-page"><header><div class="masthead"><span>@T("KAZANMAKTAN ÖNCE ANLAMAK", "UNDERSTANDING BEFORE WINNING")</span><LanguageSwitch /></div><h1>@T("Münazara Sahnesi", "Debate Stage")</h1><p>@T("Bir önerme. İki bakış açısı. Gerekçeli savlar, birbirini yanıtlayan karşısavlar ve açık bir değerlendirme ölçütü. Burada çoğunluk oyu gerçeğin yerine geçmez.", "One proposition, two perspectives. Reasoned claims, linked counterarguments and an explicit review rubric. A popularity vote does not decide truth here.")</p><div class="toolbar"><button @onclick="()=>Creating=true">@T("Yeni önerme kur", "Create a proposition")</button><button class="quiet" disabled="@Busy" @onclick="RefreshAsync">@T("Önermeleri yenile", "Refresh propositions")</button></div></header>
@if(Status.Length>0){<div role="status" class="status">@Status</div>}
<main><aside><h2>@T("Açık oturumlar", "Open sessions")</h2><div class="session-list">@foreach(var debate in Debates){<button class="session" @onclick="()=>OpenAsync(debate.Id)" disabled="@Busy"><strong>@debate.Title</strong><span>@debate.ArgumentCount @T("gerekçeli sav", "reasoned arguments")</span></button>}</div><details><summary>@T("12 editoryal tartışma önerisi", "12 editorial discussion prompts")</summary><p class="small">@T("Bunlar gerçek kullanıcı oturumları değil, senin düzenleyip yayımlayabileceğin başlangıç taslaklarıdır. Metinler Türkçedir.", "These Turkish drafts are editorial suggestions for you to edit and publish, not fabricated user sessions.")</p>@foreach(var prompt in Prompts){<button class="session" @onclick="()=>UsePrompt(prompt)"><strong>@prompt.Title</strong><span>@prompt.Context</span></button>}</details></aside><section class="stage">
@if(Creating){<section class="composer"><h2>@T("Sınırları belli bir önerme", "A proposition with explicit boundaries")</h2><form @onsubmit="CreateAsync" @onsubmit:preventDefault><label for="debate-title">@T("Önerme veya soru", "Proposition or question")</label><input id="debate-title" @bind="Title" required minlength="10" maxlength="180"><label for="debate-context">@T("Bağlam: neyi tartışıyoruz?", "Context: what is being discussed?")</label><textarea id="debate-context" @bind="Context" required minlength="30" maxlength="2000"></textarea><p class="small">@T("Kapsamı, önemli terimleri ve tartışmanın hangi koşullarda geçerli olduğunu belirt. Başlık ve bağlam herkese açık yayımlanır.", "Define scope, important terms and applicable conditions. The title and context will be published publicly.")</p><div class="toolbar"><button type="submit" disabled="@Busy">@T("Oturumu aç", "Open session")</button><button class="quiet" type="button" @onclick="()=>Creating=false">@T("Vazgeç", "Cancel")</button></div></form></section>}
@if(Current is null){<div class="empty"><h2>@T("Bir önerme seç, hangi gerekçenin eksik olduğunu bul.", "Choose a proposition and find the missing reasoning.")</h2><p>@T("Taraf seçmekten fazlası: her savın açıklaması, isteğe bağlı kaynak bağlantısı ve karşısav ilişkisi bulunur.", "More than taking a side: every argument has reasoning, an optional evidence link and a possible counterargument relationship.")</p></div>}
else{<section class="proposition"><h2>@Current.Debate.Title</h2><p>@Current.Debate.Context</p><div class="toolbar"><button class="quiet" @onclick="ReloadAsync" disabled="@Busy">@T("Sav haritasını yenile", "Refresh argument map")</button><button class="quiet" @onclick="()=>CopyAsync(Link())" disabled="@Busy">@T("Oturumu paylaş", "Share session")</button></div>@if(CopyFallback is not null){<input readonly class="copy-fallback" value="@CopyFallback">}<ReportBox Kind="debate" TargetId="@Current.Debate.Id" Endpoint="community/reports" /></section>
<div class="argument-columns">@for(var column=0;column<2;column++){var side=column;<section class="@(side==0?"side pro":"side con")"><h3>@(side==0?T("Destekleyen savlar", "Supporting arguments"):T("Karşısavlar", "Opposing arguments"))</h3>@foreach(var argument in Current.Arguments.Where(item=>item.Side==side)){<article class="argument" @key="argument.Id"><h4>@argument.Claim</h4>@if(argument.ParentId is not null){<p class="reply">@T("Yanıtladığı sav:", "Responds to:") @ParentLabel(argument.ParentId)</p>}<p>@argument.Reasoning</p>@if(argument.EvidenceUrl.Length>0){<a href="@argument.EvidenceUrl" target="_blank" rel="noopener noreferrer nofollow">@T("Yazarın kanıt bağlantısı", "Author's evidence link")</a>}else{<p class="small">@T("Kaynak bağlantısı eklenmemiş.", "No evidence link provided.")</p>}<p class="review-result">@argument.ReviewCount @T("değerlendirme", "reviews") @if(argument.ReviewCount>0){<span>· @T("açıklık", "clarity") @argument.Clarity.ToString("0.0")/3 · @T("kanıt", "evidence") @argument.Evidence.ToString("0.0")/3</span>}</p><button class="quiet" @onclick="()=>ReplyTo(argument)">@T("Karşısavla yanıtla", "Respond with a counterargument")</button>@if(argument.Mine==0&&argument.Reviewed==0){<details><summary>@T("Gerekçeyi değerlendir", "Review the reasoning")</summary><p class="small">@T("Açıklık: 1 belirsiz, 2 kısmen açık, 3 kapsamı açık. Kanıt: 1 destek yok, 2 ilgili ama sınırlı, 3 savla doğrudan bağlantılı ve incelenebilir. Bu puanlar kullanıcı görüşüdür; doğruluk kararı değildir.", "Clarity: 1 unclear, 2 partly clear, 3 explicit scope. Evidence: 1 unsupported, 2 relevant but limited, 3 directly relevant and inspectable. These are peer opinions, not a verdict of truth.")</p><label>@T("Açıklık", "Clarity")<select value="@ReviewValue(Clarity,argument.Id)" @onchange="e=>SetReview(Clarity,argument.Id,e)">@for(var score=1;score<=3;score++){<option value="@score">@score</option>}</select></label><label>@T("Kanıt niteliği", "Evidence quality")<select value="@ReviewValue(Evidence,argument.Id)" @onchange="e=>SetReview(Evidence,argument.Id,e)">@for(var score=1;score<=3;score++){<option value="@score">@score</option>}</select></label><button disabled="@Busy" @onclick="()=>ReviewAsync(argument.Id)">@T("Değerlendirmeyi kaydet", "Save review")</button></details>}else if(argument.Reviewed>0){<p class="small">@T("Bu savı değerlendirdin.", "You reviewed this argument.")</p>}<ReportBox Kind="argument" TargetId="@argument.Id" Endpoint="community/reports" /></article>}</section>}</div>
<section class="composer"><h3>@T("Savını yapılandır", "Structure your argument")</h3>@if(ParentId is not null){<p class="reply">@T("Yanıtladığın sav:", "Your response targets:") @ParentLabel(ParentId) <button class="quiet" @onclick="()=>ParentId=null">@T("Bağı kaldır", "Remove link")</button></p>}<form @onsubmit="AddArgumentAsync" @onsubmit:preventDefault><label for="argument-side">@T("Taraf", "Side")</label><select id="argument-side" @bind="Side" disabled="@(ParentId is not null)"><option value="0">@T("Destekleyen", "Supporting")</option><option value="1">@T("Karşı çıkan", "Opposing")</option></select><label for="argument-claim">@T("Tek cümlelik sav", "One-sentence claim")</label><input id="argument-claim" @bind="Claim" required minlength="10" maxlength="240"><label for="argument-reasoning">@T("Neden? Hangi koşulda? Hangi karşı örnek önemli?", "Why? Under what conditions? Which counterexample matters?")</label><textarea id="argument-reasoning" @bind="Reasoning" required minlength="40" maxlength="1800"></textarea><label for="argument-evidence">@T("İsteğe bağlı kanıt bağlantısı (http/https)", "Optional evidence link (http/https)")</label><input id="argument-evidence" @bind="EvidenceUrl" type="url" maxlength="800"><button type="submit" disabled="@Busy">@T("Savı yayımla", "Publish argument")</button></form></section>}
</section></main><footer><p>@T("Başlıklar, savlar ve değerlendirme ortalamaları herkese açıktır. Veriler Cloudflare veritabanında saklanır. Bir savı kendi yazarı değerlendiremez; diğer kimlikler bir kez değerlendirebilir. Kimlik çerez tabanlıdır, kişi doğrulaması değildir. Kişisel bilgi, taciz, nefret, izinsiz eser ve spam yasaktır. Üç farklı ağ raporu içeriği otomatik gizler; insan incelemesi ve otomatik gerçek kontrolü sunulmaz.", "Propositions, arguments and peer-review averages are public and stored in a Cloudflare database. Authors cannot review their own claims; another cookie identity can review once. Cookie identity is not person verification. No personal information, harassment, hate, unauthorized works or spam. Three distinct-network reports automatically hide content. No human review or automated fact-checking service is provided.")</p></footer></div>
@code{
 [SupplyParameterFromQuery(Name="oturum")]public string? DebateId{get;set;}
 List<DebateSummary> Debates=[];DebateDetail? Current;bool Creating;string Title="",Context="",Claim="",Reasoning="",EvidenceUrl="";int Side;string? ParentId;readonly Dictionary<string,int> Clarity=[],Evidence=[];
 static readonly DebatePrompt[] Prompts=[new("Ortak çalışma alanlarında sessiz saatler olmalı mı?","Küçük bir ortak çalışma alanında odaklanma, konuşma ve ekip üretimi ihtiyaçlarını birlikte düşünün. Sessiz saatlerin kapsamını ve istisnalarını açıkça tanımlayın."),new("Oyunlarda puan yerine ortak hedefler kullanılmalı mı?","Tek bir oyunun bütün oyuncularını aynı hedefe yönlendiren bir tasarımı tartışın. Rekabet, işbirliği ve kişisel ilerleme ihtiyaçlarını birbirinden ayırın."),new("Mahalle etkinliklerinin takvimini katılımcılar mı belirlemeli?","Yerel bir etkinlik topluluğunda konu seçimi, erişim, hazırlık süresi ve organizasyon sorumluluğu arasındaki ilişkiyi değerlendirin."),new("Bir müzenin sergi sırasını ziyaretçiler değiştirebilmeli mi?","Küratörün anlatısı ile ziyaretçinin merakını karşılaştırın. Eserlerin güvenliği dışında dijital bir sergideki sıralama kararını düşünün."),new("Kısa hikâyeler tek yazarlı mı çok yazarlı mı olmalı?","Yaratıcı tutarlılık ile farklı seslere yer açma arasında hangi tasarım kararlarının işe yarayacağını, belli bir yazı topluluğu üzerinden tartışın."),new("Beceri takasında bütün saatler eşit mi sayılmalı?","Gönüllü bir beceri paylaşım topluluğunda emek, hazırlık, deneyim ve erişilebilirlik gibi ölçütleri tanımlayıp para kullanmadan adil eşleşme yolları düşünün."),new("Bir toplulukta yeni üyelerin ilk işi katkı yapmak mı olmalı?","İlk gün gelen bir kişinin okuma, gözlemleme, soru sorma ve üretme seçeneklerini tartışın. Katılma baskısını ve aidiyet kurmayı birlikte ele alın."),new("Şehir oyunları herkese açık rotalarda mı oynanmalı?","Kurgusal bir şehir oyununun erişim, güvenlik, mekân kullanımı ve sürpriz ihtiyacını aynı bağlamda değerlendirin. Belirli bir şehrin koşullarını varsaymayın."),new("Bir sosyal üründe beğeni sayıları gizlenmeli mi?","Paylaşımın niteliği, keşif ve geri bildirim ihtiyacını ayırın. Sayıların hangi kullanıcılara, ne zaman ve hangi bağlamda gösterileceğini tartışın."),new("Yaratıcı yarışmalarda süreç de sergilenmeli mi?","Bitmiş eserlerin yanında taslakların ve başarısız denemelerin paylaşılmasının katılım, öğrenme ve değerlendirmeyi nasıl etkileyebileceğini tartışın."),new("Ortak çizimlerde herkes her alanı değiştirebilmeli mi?","Küçük bir dijital tuvalde açık katkı ile mevcut çizimi koruma arasındaki sınırları düşünün. Geri alma, alan ayırma ve anlaşmazlık yöntemlerini değerlendirin."),new("Bir oyun takımında roller rastgele mi seçilmeli?","Dört kişilik işbirlikli bir bulmacada rol dağıtımını tartışın. Yeni oyuncuların öğrenmesi, deneyimli oyuncuların yönlendirmesi ve tekrar oynama seçeneklerini birlikte düşünün.")];
 /// <summary>Loads actual sessions and an optional shared argument map.</summary>
 protected override Task OnParametersSetAsync()=>ExecuteAsync(async()=>{await LoadListAsync();if(!string.IsNullOrEmpty(DebateId))await LoadAsync(DebateId);});
 /// <summary>Reads the bounded public session directory.</summary>
 async Task LoadListAsync()=>Debates=(await ReadAsync<DebateList>("debates")).Debates;
 /// <summary>Refreshes real sessions.</summary>
 Task RefreshAsync()=>ExecuteAsync(LoadListAsync);
 /// <summary>Opens one public proposition.</summary>
 Task OpenAsync(string id)=>ExecuteAsync(()=>LoadAsync(id));
 /// <summary>Loads structured arguments, review aggregates and this identity's review state.</summary>
 async Task LoadAsync(string id){Current=await ReadAsync<DebateDetail>("debates/"+id);await ReplaceAsync(Link());}
 /// <summary>Refreshes the displayed proposition and its arguments.</summary>
 Task ReloadAsync()=>Current is null?Task.CompletedTask:ExecuteAsync(()=>LoadAsync(Current.Debate.Id));
 /// <summary>Fills an unpublished proposition from an explicitly editorial prompt.</summary>
 void UsePrompt(DebatePrompt prompt){Title=prompt.Title;Context=prompt.Context;Creating=true;}
 /// <summary>Publishes a proposition with an explicit scope.</summary>
 Task CreateAsync()=>ExecuteAsync(async()=>{var created=await WriteAsync<CreatedResponse>("debates",new{title=Title,context=Context});await LoadAsync(created.Id);Creating=false;Title=Context="";await LoadListAsync();});
 /// <summary>Prepares an argument on the opposite side of a specific existing claim.</summary>
 void ReplyTo(ArgumentInfo argument){ParentId=argument.Id;Side=1-argument.Side;}
 /// <summary>Publishes one reasoned argument, optionally linked as a counterargument.</summary>
 Task AddArgumentAsync()=>ExecuteAsync(async()=>{if(Current is null)return;await WriteAsync<CreatedResponse>($"debates/{Current.Debate.Id}/arguments",new{side=Side,claim=Claim,reasoning=Reasoning,evidenceUrl=EvidenceUrl,parentId=ParentId});Claim=Reasoning=EvidenceUrl="";ParentId=null;await LoadAsync(Current.Debate.Id);await LoadListAsync();},T("Savın gerekçesiyle birlikte yayımlandı.","Your argument and reasoning were published."));
 /// <summary>Returns the selected rubric value or its neutral middle starting value.</summary>
 static int ReviewValue(Dictionary<string,int> values,string id)=>values.GetValueOrDefault(id,2);
 /// <summary>Stores a local rubric draft without submitting a vote.</summary>
 static void SetReview(Dictionary<string,int> values,string id,ChangeEventArgs change){if(int.TryParse(change.Value?.ToString(),out var score)&&score is >=1 and <=3)values[id]=score;}
 /// <summary>Records a peer-only two-axis rubric review, once per anonymous identity.</summary>
 Task ReviewAsync(string id)=>ExecuteAsync(async()=>{await WriteAsync<object>($"arguments/{id}/reviews",new{clarity=ReviewValue(Clarity,id),evidence=ReviewValue(Evidence,id)});if(Current is not null)await LoadAsync(Current.Debate.Id);},T("Değerlendirmen kaydedildi.","Your review was saved."));
 /// <summary>Resolves a visible parent claim without exposing hidden text.</summary>
 string ParentLabel(string id)=>Current?.Arguments.FirstOrDefault(item=>item.Id==id)?.Claim??T("Gizlenen veya erişilemeyen sav", "A hidden or unavailable argument");
 /// <summary>Returns this debate's independent share URL.</summary>
 string Link()=>ContentLink("munazara-sahnesi","oturum",Current?.Debate.Id??"");
}
