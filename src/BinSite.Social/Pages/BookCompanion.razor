@page "/kitap-arkadasi/"
@inherits CollaborationComponent
<PageTitle>@T("Kitap Arkadaşı — Bir metin, birlikte okuma", "Book Companion — Read a story together")</PageTitle>
<div class="reading-page"><header><LanguageSwitch /><span class="eyebrow">@T("KISA METİNLER, UZUN KONUŞMALAR", "SHORT TEXTS, LONG CONVERSATIONS")</span><h1>@T("Kitap Arkadaşı", "Book Companion")</h1><p>@T("Dört özgün kurmaca kısa metinden birini seç. Üç bölümü kendi hızında oku, ilerlemeni kulübe kaydet, yorumları doğru bölümde konuş.","Choose one of four original fictional short stories. Read its three chapters at your own pace, save your progress and discuss each chapter separately.")</p></header>
@if(Status.Length>0){<p class="status" role="status">@Status</p>}
<main><aside><h2>@T("Okuma kulübü aç", "Create a reading club")</h2><form @onsubmit="CreateAsync" @onsubmit:preventDefault><label>@T("Kulüp adı", "Club title")<input @bind="Title" required minlength="4" maxlength="140"></label><label>@T("Özgün kurmaca metin", "Original fictional story")<select @bind="BookIndex">@for(var index=0;index<CollaborationEditorial.Books.Length;index++){<option value="@index">@CollaborationEditorial.Books[index].Title</option>}</select></label><button type="submit" disabled="@Busy">@T("Kulübü oluştur", "Create club")</button></form><p class="small">@T("Metinler editoryal olarak yazılmış özgün kurmacalardır; kullanıcı gönderisi veya gerçek kişi hatırası olarak sunulmaz. Metinlerin dili Türkçedir.","The Turkish stories are original editorial fiction, not user posts or real personal memories.")</p><button class="quiet" @onclick="ListAsync" disabled="@Busy">@T("Kulüpleri yenile", "Refresh clubs")</button>@foreach(var item in Items){<button class="club-link" @onclick="()=>OpenAsync(item.Id)" disabled="@Busy">@item.Title</button>}</aside><section>
@if(Current is null){<section class="reader"><h2>@CollaborationEditorial.Books[BookIndex].Title</h2><p>@CollaborationEditorial.Books[BookIndex].Description</p><h3>@T("İlk bölümü kulüpsüz de okuyabilirsin.","Read the opening chapter without joining a club.")</h3><p class="story">@CollaborationEditorial.Books[BookIndex].Chapters[0]</p></section>}
else{<h2>@Current.Title</h2><div class="toolbar"><button class="quiet" @onclick="ReloadAsync" disabled="@Busy">@T("Yenile", "Refresh")</button><button class="quiet" @onclick="()=>CopyAsync(SpaceLink(Kind,Current.Id))">@T("Kulübü paylaş", "Share club")</button></div>@if(CopyFallback is not null){<input readonly value="@CopyFallback">}@if(Current.MemberId is null){<form @onsubmit="JoinAsync" @onsubmit:preventDefault><label>@T("Kulüp içi takma adın", "Club handle")<input @bind="Name" required minlength="2" maxlength="24"></label><button type="submit" disabled="@Busy">@T("Okur olarak katıl", "Join as a reader")</button></form>}<div class="chapter-tabs">@for(var index=1;index<=3;index++){var chapter=index;<button class="@(Chapter==chapter?"active":"quiet")" @onclick="()=>Chapter=chapter">@T("Bölüm", "Chapter") @chapter</button>}</div><section class="reader"><span class="eyebrow">@CollaborationEditorial.Books[Current.State.Book].Title · @Chapter/3</span><p class="story">@CollaborationEditorial.Books[Current.State.Book].Chapters[Chapter-1]</p>@if(Current.MemberId is not null){<button disabled="@Busy" @onclick="ProgressAsync">@T("Bu bölümü okudum", "I have read this chapter")</button>}</section><section class="club-progress"><h3>@T("Okuma masası", "Reading table")</h3>@foreach(var participant in Current.State.Members){<p>@participant.Name <progress max="3" value="@participant.Progress"></progress> @participant.Progress/3</p>}<p class="small">@T("İlerleme okurun kendi beyanıdır; okuma doğrulaması değildir.","Progress is self-reported by the reader, not verified reading.")</p></section><section class="discussion"><h3>@T("Bu bölümün konuşması", "Discussion for this chapter")</h3><p class="small">@T("Sonraki bölümdeki ayrıntıları bu başlığa taşımayarak sürprizleri koruyun.","Keep later-chapter details out of this discussion to preserve surprises.")</p>@foreach(var comment in Current.State.Discussion.Where(item=>item.Chapter==Chapter)){<article><strong>@Handle(Current.State.Members,comment.MemberId)</strong><p>@comment.Body</p></article>}@if(Current.MemberId is not null){<form @onsubmit="CommentAsync" @onsubmit:preventDefault><label>@T("Sende kalan soru veya ayrıntı", "A question or detail that stayed with you")<textarea @bind="Comment" required minlength="10" maxlength="1200"></textarea></label><button type="submit" disabled="@Busy">@T("Bölüme yorum ekle", "Add chapter comment")</button></form>}</section><ReportBox Kind="@Kind" TargetId="@Current.Id" Endpoint="collaboration/reports" />}
</section></main><footer><CollaborationRules /></footer></div>
@code{
 const string Kind="kitap-arkadasi";[SupplyParameterFromQuery(Name="alan")]public string? Area{get;set;}Space<ReadingState>? Current;List<SpaceItem> Items=[];string Title="",Name="",Comment="";int BookIndex,Chapter=1;
 /// <summary>Loads actual club headers and an optional shared discussion space.</summary>
 protected override Task OnParametersSetAsync()=>ExecuteAsync(async()=>{await LoadListAsync();if(Area is not null)await LoadAsync(Area);});
 /// <summary>Reads actual public club headers.</summary>
 async Task LoadListAsync()=>Items=(await DirectoryAsync(Kind)).Items;
 /// <summary>Refreshes the club directory.</summary>
 Task ListAsync()=>ExecuteAsync(LoadListAsync);
 /// <summary>Reads actual reader progress and chapter-specific comments.</summary>
 async Task LoadAsync(string id){Current=await ReadSpaceAsync<ReadingState>(Kind,id);await RememberAsync(Kind,id);}
 /// <summary>Opens a selected club.</summary>
 Task OpenAsync(string id)=>ExecuteAsync(()=>LoadAsync(id));
 /// <summary>Refreshes the current club from the server.</summary>
 Task ReloadAsync()=>Current is null?Task.CompletedTask:OpenAsync(Current.Id);
 /// <summary>Creates a real club for an explicitly authored editorial story.</summary>
 Task CreateAsync()=>ExecuteAsync(async()=>{Current=await CreateSpaceAsync<ReadingState>(Kind,new{title=Title,book=BookIndex});await RememberAsync(Kind,Current.Id);Title="";await LoadListAsync();});
 /// <summary>Joins the club with this browser identity and a public handle.</summary>
 Task JoinAsync()=>ExecuteAsync(async()=>{if(Current is not null)Current=await ActionAsync(Kind,Current,"join",new{name=Name});});
 /// <summary>Stores this reader's self-reported completed chapter monotonically.</summary>
 Task ProgressAsync()=>ExecuteAsync(async()=>{if(Current is not null)Current=await ActionAsync(Kind,Current,"progress",new{chapter=Chapter});});
 /// <summary>Publishes a comment scoped to the displayed chapter.</summary>
 Task CommentAsync()=>ExecuteAsync(async()=>{if(Current is not null){Current=await ActionAsync(Kind,Current,"discuss",new{chapter=Chapter,body=Comment});Comment="";}});
}
