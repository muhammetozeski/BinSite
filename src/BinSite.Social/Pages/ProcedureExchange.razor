@page "/procedure-exchange/"
@implements IAsyncDisposable
@inject IJSRuntime Javascript
@inject SocialApi Api
@inject NavigationManager Navigation
@inject ILogger<ProcedureExchange> Logger
<PageTitle>Procedure Exchange</PageTitle>
<PageSurface>
<div class="procedure-exchange">
<header><div><h1>Procedure Exchange</h1><p>Write a method, follow its steps and share improvements.</p></div></header>
<div class="boundary">Download your project before closing; this tab does not save automatically.</div>
@if(Status.Length>0){<div class="status" role="status" data-error="@HasError.ToString().ToLowerInvariant()">@Status</div>}
<nav class="view-tabs" aria-label="Procedure workspace"><button disabled="@Busy" class="@(View=="author"?"active":"")" @onclick='()=>View="author"'>Write &amp; adapt</button><button disabled="@Busy" class="@(View=="run"?"active":"")" @onclick='()=>View="run"'>Runs (@Workspace.Runs.Count)</button><button disabled="@Busy" class="@(View=="public"?"active":"")" @onclick="OpenPublicAsync">Published methods</button><button disabled="@Busy" class="@(View=="private"?"active":"")" @onclick='()=>View="private"'>Private copies</button></nav>
<main aria-busy="@Busy">
<details class="file-tools"><summary>Save, open or export</summary><div class="actions"><button disabled="@Busy" @onclick="NewAsync">New method</button><button disabled="@Busy" @onclick="DownloadProjectAsync">Save project</button><label class="file-control">Open project<input type="file" accept=".json,application/json" @ref="RestoreInput" @onchange="RestoreAsync" disabled="@Busy"></label><button disabled="@(Busy||Workspace.Document.Steps.Count==0)" @onclick="ExportPackageAsync">Export instructions</button><button disabled="@(Busy||Workspace.Document.Steps.Count==0)" @onclick="ExportMethodAsync">Print instructions</button></div><p>Project files include private runs. Instruction exports do not.</p></details>
@if(View=="author")
{
<div class="author-grid">
<aside class="starter-list"><h2>Starting methods</h2>@foreach(var starter in ProcedureExchangeContent.All){<button disabled="@Busy" @onclick="()=>LoadStarterAsync(starter)"><strong>@starter.Document.Title</strong><span>@starter.Document.Category · @starter.Document.Steps.Count steps · @starter.Document.Steps.Sum(step=>step.Minutes) min estimate</span></button>}</aside>
<section class="method-editor"><h2>Your method</h2><p class="source-label">@ProcedureExchangeRules.SourceLabel(Workspace.Source)</p><button class="primary" disabled="@(Busy||Workspace.Document.Steps.Count==0)" @onclick="StartDraftRun">Start this method</button>
@if(Workspace.PublicationTarget is {} target){<div class="target-notice"><strong>Updating version @target.Revision.</strong> Publishing creates the next version.<button @onclick="DetachTarget">Publish as a separate method</button></div>}
<label>Method title<input @bind="Workspace.Document.Title" maxlength="120" disabled="@Busy"></label><label>Summary<textarea @bind="Workspace.Document.Summary" maxlength="600" rows="3" disabled="@Busy"></textarea></label>
<div class="two-fields"><label>Category<select @bind="Workspace.Document.Category" disabled="@Busy">@foreach(var category in ProcedureExchangeRules.Categories){<option value="@category">@category</option>}</select></label><label>Tags — one per line, up to 6<textarea @bind="TagsDraft" rows="3" disabled="@Busy"></textarea></label></div>
<label>Required inputs — one description per line, up to 20<textarea @bind="InputsDraft" rows="4" disabled="@Busy"></textarea></label><label>What will you produce?<textarea @bind="Workspace.Document.Artifact" maxlength="1200" rows="3" disabled="@Busy"></textarea></label>
<h3>Steps</h3>
@for(var index=0;index<Workspace.Document.Steps.Count;index++)
{
var position=index;var step=Workspace.Document.Steps[position];
<fieldset class="step-editor" @key="step.Id"><legend>Step @(position+1)</legend><div class="step-tools"><button disabled="@(Busy||position==0)" @onclick="()=>MoveStep(position,-1)">Move up</button><button disabled="@(Busy||position==Workspace.Document.Steps.Count-1)" @onclick="()=>MoveStep(position,1)">Move down</button><button disabled="@Busy" @onclick="()=>RemoveStep(position)">Remove</button></div><label>Step title<input @bind="step.Title" maxlength="120" disabled="@Busy"></label><label>Action<textarea @bind="step.Action" maxlength="2000" rows="4" disabled="@Busy"></textarea></label><label>Done when<textarea @bind="step.DoneWhen" maxlength="500" rows="2" disabled="@Busy"></textarea></label><label>Estimated minutes<input type="number" min="0" max="1440" @bind="step.Minutes" disabled="@Busy"></label></fieldset>
}
<div class="actions"><button disabled="@(Busy||Workspace.Document.Steps.Count>=40)" @onclick="AddStep">Add step</button><button disabled="@Busy" @onclick="CheckDraft">Check method</button></div>
@if(Workspace.ComparisonBase is not null)
{<details class="comparison"><summary>Compare with source</summary><p>Source: @ProcedureExchangeRules.SourceLabel(Workspace.Source)</p><button disabled="@Busy" @onclick="CompareDraft">Refresh comparison</button>@if(Differences.Count==0){<p>Last comparison: no differences. Refresh after editing.</p>}else{<ul>@foreach(var difference in Differences){<li>@difference</li>}</ul>}<details><summary>Read source instructions</summary><p>@Workspace.ComparisonBase.Summary</p><ol>@foreach(var step in Workspace.ComparisonBase.Steps){<li><strong>@step.Title</strong><p>@step.Action</p><p>Done when: @step.DoneWhen</p></li>}</ol></details></details>}
<section class="publish-panel"><h3>Publish reusable instructions</h3><p><a href="/uyelik/">Sign in</a> to publish. Method text becomes public; keep private inputs and work notes in Runs.</p><label>Published name<input @bind="AuthorAlias" @bind:event="oninput" maxlength="40" disabled="@Busy"></label><label class="check"><input type="checkbox" @bind="ReuseConsent" disabled="@Busy">I can publish this text and allow copying, credited exports and forks.</label><button disabled="@(Busy||!ReuseConsent||string.IsNullOrWhiteSpace(AuthorAlias))" @onclick="PublishAsync">@(Workspace.PublicationTarget is null?"Publish method":"Publish next version")</button></section>
</section>
</div>
}
else if(View=="run")
{
<div class="run-grid"><aside><h2>Your runs</h2><p>Each run keeps its original instructions.</p>@if(Workspace.Runs.Count==0){<p>No runs yet.</p>}@foreach(var item in Workspace.Runs.OrderByDescending(item=>item.StartedAt)){<button class="run-choice @(Workspace.CurrentRunId==item.Id?"selected":"")" @onclick="()=>SelectRun(item.Id)" disabled="@Busy"><strong>@item.Snapshot.Title</strong><span>@item.State · @item.StartedAt.ToLocalTime().ToString("g")</span><span>@item.Steps.Count(step=>step.Done)/@item.Steps.Count checks</span></button>}</aside>
<section>
@if(CurrentRun is {} run)
{
<div class="run-heading"><div><h2>@run.Snapshot.Title</h2></div><strong>@run.State</strong></div><p>@ProcedureExchangeRules.SourceLabel(run.Source)</p>@if(run.DerivedFrom is not null){<p class="small">Based on @ProcedureExchangeRules.SourceLabel(run.DerivedFrom).</p>}<p>@run.Snapshot.Summary</p>
<h3>Your inputs</h3>@for(var index=0;index<run.Snapshot.Inputs.Count;index++){var inputIndex=index;<label>@run.Snapshot.Inputs[inputIndex]<textarea @bind="run.InputValues[inputIndex]" rows="2" maxlength="4000" disabled="@(Busy||run.State!=ProcedureRunState.Active)"></textarea></label>}
<h3>Expected output</h3><p class="artifact-description">@run.Snapshot.Artifact</p>
@foreach(var step in run.Snapshot.Steps){var record=run.Steps.Single(item=>item.StepId==step.Id);<fieldset class="run-step"><legend>@step.Title</legend><p class="multiline">@step.Action</p><p class="done-check"><strong>Done when:</strong> @step.DoneWhen</p><label class="check"><input type="checkbox" @bind="record.Done" disabled="@(Busy||run.State!=ProcedureRunState.Active)">I checked that this step is finished.</label><div class="two-fields"><label>Private note<textarea @bind="record.Note" rows="2" maxlength="4000" disabled="@(Busy||run.State!=ProcedureRunState.Active)"></textarea></label><label>Private evidence or file link<textarea @bind="record.Evidence" rows="2" maxlength="4000" disabled="@(Busy||run.State!=ProcedureRunState.Active)"></textarea></label></div></fieldset>}
<label>Your output or file links<textarea @bind="run.ArtifactText" @bind:event="oninput" maxlength="16000" rows="7" disabled="@(Busy||run.State!=ProcedureRunState.Active)"></textarea></label><label>Result note (at least 3 characters)<textarea @bind="run.ResultNote" @bind:event="oninput" maxlength="4000" rows="3" disabled="@(Busy||run.State!=ProcedureRunState.Active)"></textarea></label>
<div class="actions">@if(run.State==ProcedureRunState.Active){<button disabled="@Busy" @onclick="SaveCurrentRun">Check entries</button><button disabled="@(Busy||run.ResultNote.Trim().Length<3||string.IsNullOrWhiteSpace(run.ArtifactText)||run.Steps.Any(step=>!step.Done))" @onclick="()=>FinishRun(ProcedureRunState.Completed)">Complete</button><button disabled="@(Busy||run.ResultNote.Trim().Length<3)" @onclick="()=>FinishRun(ProcedureRunState.Partial)">Mark partial</button><button disabled="@(Busy||run.ResultNote.Trim().Length<3)" @onclick="()=>FinishRun(ProcedureRunState.Blocked)">Mark blocked</button>}else{<button disabled="@Busy" @onclick="ReopenRun">Reopen run</button>}</div><p class="small">Complete after checking every step and recording the output.</p>
<section class="run-exports"><h3>Run outputs</h3><label class="check"><input type="checkbox" @bind="IncludePrivateReport" disabled="@Busy">Include private inputs, notes, evidence and outputs in the report.</label><div class="actions"><button @onclick="ExportRunAsync" disabled="@Busy">Download report HTML</button><button @onclick="ExportArtifactAsync" disabled="@(Busy||string.IsNullOrWhiteSpace(run.ArtifactText))">Download result text</button></div><p class="small">Review the report before sharing it.</p>@if(run.Source.Kind=="published"){<button disabled="@Busy" @onclick="()=>ReadPublicAsync(run.Source.Id,run.Source.Revision)">Report your result for this version</button>}</section>
}
else{<h2>Start a run</h2><p>Choose a method, then start it to follow the steps and record your output.</p>}
</section></div>
}
else if(View=="public")
{
<div class="public-grid"><aside><h2>Published methods</h2><label>Search titles, summaries or tags<input @bind="Search" maxlength="120" disabled="@Busy"></label><label>Category<select @bind="SearchCategory" disabled="@Busy"><option value="">All categories</option>@foreach(var category in ProcedureExchangeRules.Categories){<option value="@category">@category</option>}</select></label><label class="check"><input type="checkbox" @bind="MineOnly" disabled="@Busy">My publications — account required</label><button @onclick="SearchPublicAsync" disabled="@Busy">Search</button>@if(DirectoryLoaded&&PublicItems.Count==0){<p>No matching methods. Try another search or adapt a starting method.</p>}@foreach(var item in PublicItems){<button class="public-choice" @onclick="()=>ReadPublicAsync(item.Id,item.Revision)" disabled="@Busy"><strong>@item.Title</strong><span>Version @item.Revision · @item.Category</span><span>By @item.AuthorAlias</span>@if(item.Withdrawn||item.Hidden){<span>Owner-only: @(item.Withdrawn?"withdrawn":"hidden")</span>}</button>}<div class="actions"><button disabled="@(Busy||SearchOffset==0)" @onclick="PreviousPageAsync">Previous</button><button disabled="@(Busy||!HasMore||SearchOffset>=2000)" @onclick="NextPageAsync">Next</button></div>@if(HasMore&&SearchOffset>=2000){<p>Narrow your search to see more methods.</p>}</aside>
<section>
@if(PublicDetail is {} detail)
{
var published=detail.Playbook;
<div class="published-heading"><div><span class="eyebrow">VERSION @published.Revision</span><h2>@published.Document.Title</h2></div><span>By @published.AuthorAlias</span></div><p>@published.Document.Summary</p><p>@published.Document.Category · @string.Join(", ",published.Document.Tags)</p>
@if(published.Withdrawn||published.Hidden){<p class="target-notice">This record is visible to its owner only: @(published.Withdrawn?"withdrawn by author":"hidden by moderation"). New public forks and outcomes are unavailable.</p>}
@if(published.ParentId is not null){<p>Adapted from <button class="inline" disabled="@Busy" @onclick="()=>ReadPublicAsync(published.ParentId,published.ParentRevision)">Source method · version @published.ParentRevision</button></p>}
<div class="actions"><button class="primary" @onclick="StartPublishedRun" disabled="@Busy">Start this revision</button><button disabled="@(Busy||published.Withdrawn||published.Hidden)" @onclick="()=>UsePublicAsync(false)">Adapt this method</button>@if(published.Owned&&!published.Withdrawn&&!published.Hidden){<button disabled="@Busy" @onclick="()=>UsePublicAsync(true)">Edit next version</button><button disabled="@Busy" @onclick="ArmSelectedUpdateAsync">Use my current draft for next version</button>}</div>
<label>Share this version<input readonly value="@PublicLink"></label><button @onclick="CopyLinkAsync" disabled="@Busy">Copy link</button>
<div class="revision-picker"><label>Version<input type="number" @bind="RevisionToRead" min="1" max="100" disabled="@Busy"></label><button @onclick="ReadRevisionAsync" disabled="@(Busy||RevisionToRead<1||RevisionToRead>100)">Open version</button><button @onclick="()=>ReadPublicAsync(published.Id,null)" disabled="@Busy">Latest version</button></div>
<h3>Required inputs</h3><ul>@foreach(var input in published.Document.Inputs){<li>@input</li>}</ul><h3>Expected output</h3><p>@published.Document.Artifact</p><ol class="published-steps">@foreach(var step in published.Document.Steps){<li><h3>@step.Title</h3><p class="multiline">@step.Action</p><p><strong>Done when:</strong> @step.DoneWhen</p><p class="small">Estimated @step.Minutes minutes</p></li>}</ol>
<section class="outcomes"><h3>Reported outcomes · version @published.Revision</h3>@if(PublicRefreshPending){<p class="target-notice">Details may be out of date. Use Open version to refresh.</p>}<dl><div><dt>Completed</dt><dd>@detail.Outcomes.Completed</dd></div><div><dt>Partial</dt><dd>@detail.Outcomes.Partial</dd></div><div><dt>Blocked</dt><dd>@detail.Outcomes.Blocked</dd></div></dl><p class="small">You can update your result for this version.</p>@if(detail.MyOutcome is not null){<p>Your result: <strong>@detail.MyOutcome.Kind</strong></p><p>@detail.MyOutcome.Note</p>}<label>Your result<select @bind="OutcomeKind" disabled="@(Busy||published.Withdrawn||published.Hidden)"><option value="">Choose a result</option><option value="completed">Completed</option><option value="partial">Partial</option><option value="blocked">Blocked</option></select></label><label>Public note · optional<textarea @bind="OutcomeNote" maxlength="1000" rows="3" disabled="@(Busy||published.Withdrawn||published.Hidden)"></textarea></label><button disabled="@(Busy||OutcomeKind.Length==0||published.Withdrawn||published.Hidden)" @onclick="SubmitOutcomeAsync">Save public outcome</button><p class="small"><a href="/uyelik/">Sign in</a> to report. Your note becomes public.</p></section>
<details><summary>Report this public method</summary><label>Reason<select @bind="ReportReason" disabled="@Busy"><option value="spam">Spam</option><option value="unsafe">Unsafe instructions</option><option value="rights">Rights concern</option><option value="privacy">Private information</option></select></label><label>What is the problem?<textarea @bind="ReportNote" maxlength="1000" rows="3" disabled="@Busy"></textarea></label><button disabled="@Busy" @onclick="ReportAsync">Submit report</button></details>
@if(published.Owned&&!published.Withdrawn){<section class="withdraw"><h3>Publication owner</h3><p>Withdrawal hides this method from public reads and new forks. Copies people already downloaded are independent files.</p><button disabled="@Busy" @onclick="WithdrawAsync">Withdraw my publication</button></section>}
}
else{<h2>Open a method</h2><p>Choose a method to follow, adapt or review.</p>}
</section></div>
}
else if(View=="private")
{
<section class="vault"><h2>Private copies</h2><p><a href="/uyelik/">Sign in</a> to save a project and its runs privately. Free accounts have 3 items; membership adds capacity. Each copy can hold up to 64 KB. Download a project file for larger projects.</p><label>Saved copy name<input @bind="VaultLabel" @bind:event="oninput" maxlength="100" disabled="@Busy"></label><div class="actions"><button disabled="@Busy" @onclick="ListVaultAsync">Refresh copies</button><button disabled="@(Busy||string.IsNullOrWhiteSpace(VaultLabel))" @onclick="SaveVaultNewAsync">Save a new private copy</button>@if(VaultId is not null){<button disabled="@(Busy||string.IsNullOrWhiteSpace(VaultLabel))" @onclick="SaveVaultExistingAsync">Replace selected private copy</button><button disabled="@Busy" @onclick="DetachVault">Keep saved copy unchanged</button>}</div>@if(VaultId is not null){<p>Replacing this selected copy overwrites its previous contents. Download the earlier copy first if you want to keep it.</p>}@if(VaultLoaded&&VaultItems.Count==0){<p>No saved copies yet.</p>}<ul class="vault-list">@foreach(var item in VaultItems){<li><button disabled="@Busy" @onclick="()=>LoadVaultAsync(item.Id)">@item.Title</button><span>@DateTimeOffset.FromUnixTimeMilliseconds(item.UpdatedAt).ToUniversalTime().ToString("u")</span></li>}</ul></section>
}
</main>
</div>
</PageSurface>
