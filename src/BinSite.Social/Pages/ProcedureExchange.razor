@page "/procedure-exchange/"
@implements IAsyncDisposable
@inject IJSRuntime Javascript
@inject SocialApi Api
@inject NavigationManager Navigation
@inject ILogger<ProcedureExchange> Logger
<PageTitle>Procedure Exchange — Useful methods, actual work, attributed improvements</PageTitle>
<PageSurface>
<div class="procedure-exchange">
<header><div><h1>Procedure Exchange</h1><p>Write a method, follow its steps and share improvements.</p></div><a href="/">All products</a></header>
<div class="boundary"><strong>Local work needs no account.</strong> Inputs, notes and artifacts stay in memory until you download a project or explicitly save a private copy. Public publishing sends only reusable method text. Export your project before closing this tab.</div>
@if(Status.Length>0){<div class="status" role="status" data-error="@HasError.ToString().ToLowerInvariant()">@Status</div>}
<nav class="view-tabs" aria-label="Procedure workspace"><button class="@(View=="author"?"active":"")" @onclick='()=>View="author"'>Write &amp; adapt</button><button class="@(View=="run"?"active":"")" @onclick='()=>View="run"'>Local runs (@Workspace.Runs.Count)</button><button class="@(View=="public"?"active":"")" @onclick="OpenPublicAsync">Public exchange</button><button class="@(View=="private"?"active":"")" @onclick='()=>View="private"'>Private account copy</button></nav>
<main aria-busy="@Busy">
<section class="file-tools"><button disabled="@Busy" @onclick="NewAsync">New blank method</button><button disabled="@Busy" @onclick="DownloadProjectAsync">Download private project JSON</button><label class="file-control">Restore method / project<input type="file" accept=".json,application/json" @ref="RestoreInput" @onchange="RestoreAsync" disabled="@Busy"></label><button disabled="@Busy" @onclick="ExportPackageAsync">Export reusable method JSON</button><button disabled="@Busy" @onclick="ExportMethodAsync">Export method HTML</button><p>A project contains your private run records. A reusable method export contains instructions and attribution only. Local files can be edited by their holder; they are not proof of execution or ownership.</p></section>
@if(View=="author")
{
<div class="author-grid">
<aside class="starter-list"><h2>12 original starting methods</h2><p>Examples you can use or adapt.</p>@foreach(var starter in ProcedureExchangeContent.All){<button disabled="@Busy" @onclick="()=>LoadStarterAsync(starter)"><strong>@starter.Document.Title</strong><span>@starter.Document.Category · @starter.Document.Steps.Count steps · @starter.Document.Steps.Sum(step=>step.Minutes) min estimate</span></button>}</aside>
<section class="method-editor"><h2>Your editable method</h2><p class="source-label">@ProcedureExchangeRules.SourceLabel(Workspace.Source)</p>
@if(Workspace.PublicationTarget is {} target){<div class="target-notice"><strong>Owner update target:</strong> @target.Id · expected revision @target.Revision. Publishing will create the next immutable version of that record.<button @onclick="DetachTarget">Detach target; publish as an attributed fork instead</button></div>}
<label>Method title<input @bind="Workspace.Document.Title" maxlength="120" disabled="@Busy"></label><label>Summary<textarea @bind="Workspace.Document.Summary" maxlength="600" rows="3" disabled="@Busy"></textarea></label>
<div class="two-fields"><label>Category<select @bind="Workspace.Document.Category" disabled="@Busy">@foreach(var category in ProcedureExchangeRules.Categories){<option value="@category">@category</option>}</select></label><label>Tags — one per line, up to 6<textarea @bind="TagsDraft" rows="3" disabled="@Busy"></textarea></label></div>
<label>Required inputs — one description per line, up to 20<textarea @bind="InputsDraft" rows="4" disabled="@Busy"></textarea></label><label>Expected artifact — what will actually exist at the end?<textarea @bind="Workspace.Document.Artifact" maxlength="1200" rows="3" disabled="@Busy"></textarea></label>
<h3>Instructions and observable checks</h3><p class="small">A done check describes something a reader can inspect. Estimates are planning hints, not promises. Stable step IDs allow meaningful comparison after a fork.</p>
@for(var index=0;index<Workspace.Document.Steps.Count;index++)
{
var position=index;var step=Workspace.Document.Steps[position];
<fieldset class="step-editor" @key="step.Id"><legend>Step @(position+1)</legend><div class="step-tools"><code>@step.Id</code><button disabled="@(Busy||position==0)" @onclick="()=>MoveStep(position,-1)">Move up</button><button disabled="@(Busy||position==Workspace.Document.Steps.Count-1)" @onclick="()=>MoveStep(position,1)">Move down</button><button disabled="@Busy" @onclick="()=>RemoveStep(position)">Remove</button></div><label>Step title<input @bind="step.Title" maxlength="120" disabled="@Busy"></label><label>Action — exact work to perform<textarea @bind="step.Action" maxlength="2000" rows="4" disabled="@Busy"></textarea></label><label>Done when — observable acceptance check<textarea @bind="step.DoneWhen" maxlength="500" rows="2" disabled="@Busy"></textarea></label><label>Estimated minutes<input type="number" min="0" max="1440" @bind="step.Minutes" disabled="@Busy"></label></fieldset>
}
<div class="actions"><button disabled="@(Busy||Workspace.Document.Steps.Count>=40)" @onclick="AddStep">Add step</button><button disabled="@Busy" @onclick="CheckDraft">Check method</button><button class="primary" disabled="@Busy" @onclick="StartDraftRun">Start a local run of this draft</button></div>
@if(Workspace.ComparisonBase is not null)
{<details class="comparison"><summary>Compare with the pinned source instructions</summary><p>Source: @ProcedureExchangeRules.SourceLabel(Workspace.Source)</p><button disabled="@Busy" @onclick="CompareDraft">Refresh comparison</button>@if(Differences.Count==0){<p>No saved instruction differences in the latest comparison.</p>}else{<ul>@foreach(var difference in Differences){<li>@difference</li>}</ul>}<details><summary>Read original source snapshot</summary><p>@Workspace.ComparisonBase.Summary</p><ol>@foreach(var step in Workspace.ComparisonBase.Steps){<li><strong>@step.Title</strong><p>@step.Action</p><p>Done when: @step.DoneWhen</p></li>}</ol></details></details>}
<section class="publish-panel"><h3>Publish reusable instructions</h3><p>Requires your <a href="/uyelik/">account</a>. Publisher aliases are self-supplied. Check that you own the text or may share it. Never put private inputs, personal details, credentials or confidential work into the method itself.</p><label>Publisher alias<input @bind="AuthorAlias" maxlength="40" disabled="@Busy"></label><label class="check"><input type="checkbox" @bind="ReuseConsent" disabled="@Busy">I have permission to publish these instructions and allow copying, attributed exports and forks. The method text will be public.</label><button disabled="@(Busy||!ReuseConsent)" @onclick="PublishAsync">@(Workspace.PublicationTarget is null?"Publish a new reusable method":"Publish next version with revision check")</button><p class="small">Publishing shares the instructions, not your private work or notes. If the saved version changes, your draft stays intact for comparison.</p></section>
</section>
</div>
}
else if(View=="run")
{
<div class="run-grid"><aside><h2>Your local runs</h2><p>Each run keeps a detached method snapshot. Changing the editor or publishing a new version does not rewrite an earlier run.</p>@if(Workspace.Runs.Count==0){<p>No runs yet. Open a starter or public method, then start a run.</p>}@foreach(var item in Workspace.Runs.OrderByDescending(item=>item.StartedAt)){<button class="run-choice @(Workspace.CurrentRunId==item.Id?"selected":"")" @onclick="()=>SelectRun(item.Id)" disabled="@Busy"><strong>@item.Snapshot.Title</strong><span>@item.State · @item.StartedAt.ToLocalTime().ToString("g")</span><span>@item.Steps.Count(step=>step.Done)/@item.Steps.Count declared checks</span></button>}</aside>
<section>
@if(CurrentRun is {} run)
{
<div class="run-heading"><div><span class="eyebrow">IMMUTABLE INSTRUCTIONS · PRIVATE EXECUTION RECORDS</span><h2>@run.Snapshot.Title</h2></div><strong>@run.State</strong></div><p>@ProcedureExchangeRules.SourceLabel(run.Source)</p>@if(run.DerivedFrom is not null){<p class="small">This editable draft was derived from @ProcedureExchangeRules.SourceLabel(run.DerivedFrom). It is not labelled an exact published run.</p>}<p>@run.Snapshot.Summary</p><details><summary>Snapshot identity</summary><code class="hash">@run.SnapshotHash</code><p class="small">A content hash detects accidental drift. It does not authenticate performance, identity or approval.</p></details>
<h3>Your inputs</h3>@for(var index=0;index<run.Snapshot.Inputs.Count;index++){var inputIndex=index;<label>@run.Snapshot.Inputs[inputIndex]<textarea @bind="run.InputValues[inputIndex]" rows="2" maxlength="4000" disabled="@(Busy||run.State!=ProcedureRunState.Active)"></textarea></label>}
<h3>Expected artifact</h3><p class="artifact-description">@run.Snapshot.Artifact</p>
@foreach(var step in run.Snapshot.Steps){var record=run.Steps.Single(item=>item.StepId==step.Id);<fieldset class="run-step"><legend>@step.Title</legend><p class="multiline">@step.Action</p><p class="done-check"><strong>Done when:</strong> @step.DoneWhen</p><label class="check"><input type="checkbox" @bind="record.Done" disabled="@(Busy||run.State!=ProcedureRunState.Active)">I observed this done check.</label><div class="two-fields"><label>Private note<textarea @bind="record.Note" rows="2" maxlength="4000" disabled="@(Busy||run.State!=ProcedureRunState.Active)"></textarea></label><label>Private evidence or output reference<textarea @bind="record.Evidence" rows="2" maxlength="4000" disabled="@(Busy||run.State!=ProcedureRunState.Active)"></textarea></label></div></fieldset>}
<label>Actual artifact text or a clear record of the files you produced<textarea @bind="run.ArtifactText" maxlength="16000" rows="7" disabled="@(Busy||run.State!=ProcedureRunState.Active)"></textarea></label><label>Your result note — what happened, what changed, what remains?<textarea @bind="run.ResultNote" maxlength="4000" rows="3" disabled="@(Busy||run.State!=ProcedureRunState.Active)"></textarea></label>
<div class="actions">@if(run.State==ProcedureRunState.Active){<button disabled="@Busy" @onclick="SaveCurrentRun">Save local run fields</button><button disabled="@Busy" @onclick="()=>FinishRun(ProcedureRunState.Completed)">Declare completed</button><button disabled="@Busy" @onclick="()=>FinishRun(ProcedureRunState.Partial)">Declare partial</button><button disabled="@Busy" @onclick="()=>FinishRun(ProcedureRunState.Blocked)">Declare blocked</button>}else{<button disabled="@Busy" @onclick="ReopenRun">Reopen this local run</button>}</div><p class="small">Completion requires each declared check, an actual artifact record and a result note. Partial and blocked are useful explicit results. These actions never submit a public outcome.</p>
<section class="run-exports"><h3>Take the work with you</h3><label class="check"><input type="checkbox" @bind="IncludePrivateReport" disabled="@Busy">Include private inputs, notes, evidence, artifact text and result note in the HTML run report.</label><div class="actions"><button @onclick="ExportRunAsync" disabled="@Busy">Download run report HTML</button><button @onclick="ExportArtifactAsync" disabled="@Busy">Download result text</button></div><p class="small">Inspect a report before sharing. The public outcome form is a separate explicit action, even for a run pinned to a public method.</p>@if(run.Source.Kind=="published"){<button disabled="@Busy" @onclick="()=>ReadPublicAsync(run.Source.Id,run.Source.Revision)">Open exact source revision and optional outcome form</button>}</section>
}
else{<h2>Work from explicit instructions</h2><p>Choose a method and start a local run to record actual inputs and output. No community participation is required.</p>}
</section></div>
}
else if(View=="public")
{
<div class="public-grid"><aside><h2>Published methods</h2><label>Search titles, summaries or tags<input @bind="Search" maxlength="120" disabled="@Busy"></label><label>Category<select @bind="SearchCategory" disabled="@Busy"><option value="">All categories</option>@foreach(var category in ProcedureExchangeRules.Categories){<option value="@category">@category</option>}</select></label><label class="check"><input type="checkbox" @bind="MineOnly" disabled="@Busy">My publications — account required</label><button @onclick="SearchPublicAsync" disabled="@Busy">Search / refresh</button>@if(DirectoryLoaded&&PublicItems.Count==0){<p>No matching methods. Try another search or adapt a starting method.</p>}@foreach(var item in PublicItems){<button class="public-choice" @onclick="()=>ReadPublicAsync(item.Id,item.Revision)" disabled="@Busy"><strong>@item.Title</strong><span>Revision @item.Revision · @item.Category</span><span>Alias: @item.AuthorAlias</span>@if(item.Withdrawn||item.Hidden){<span>Owner-only: @(item.Withdrawn?"withdrawn":"hidden")</span>}</button>}<div class="actions"><button disabled="@(Busy||SearchOffset==0)" @onclick="PreviousPageAsync">Previous 20</button><button disabled="@(Busy||!HasMore)" @onclick="NextPageAsync">Next 20</button></div><p class="small">Public methods are user-authored. Check suitability and permissions yourself. Reports are reviewed; submitting a report does not automatically hide a method.</p></aside>
<section>
@if(PublicDetail is {} detail)
{
var published=detail.Playbook;
<div class="published-heading"><div><span class="eyebrow">PUBLISHED REVISION @published.Revision</span><h2>@published.Document.Title</h2></div><span>Alias: @published.AuthorAlias</span></div><p>@published.Document.Summary</p><p>@published.Document.Category · @string.Join(", ",published.Document.Tags)</p><p class="small">ID: @published.Id · published @DateTimeOffset.FromUnixTimeMilliseconds(published.UpdatedAt).ToUniversalTime().ToString("u") · alias is not a verified real name.</p>
@if(published.Withdrawn||published.Hidden){<p class="target-notice">This record is visible to its owner only: @(published.Withdrawn?"withdrawn by author":"hidden by moderation"). New public forks and outcomes are unavailable.</p>}
@if(published.ParentId is not null){<p>Forked from <button class="inline" disabled="@Busy" @onclick="()=>ReadPublicAsync(published.ParentId,published.ParentRevision)">@published.ParentId · revision @published.ParentRevision</button>. Source attribution stays pinned.</p>}
<div class="actions"><button class="primary" @onclick="StartPublishedRun" disabled="@Busy">Run this exact published revision locally</button><button disabled="@(Busy||published.Withdrawn||published.Hidden)" @onclick="()=>UsePublicAsync(false)">Fork into my editable draft</button>@if(published.Owned&&!published.Withdrawn&&!published.Hidden){<button disabled="@Busy" @onclick="()=>UsePublicAsync(true)">Edit my publication as its next version</button><button disabled="@Busy" @onclick="ArmSelectedUpdateAsync">Use my current draft as an update to this publication</button>}</div>
<label>Share this pinned revision<input readonly value="@PublicLink" @onclick="CopyLinkAsync"></label><button @onclick="CopyLinkAsync" disabled="@Busy">Copy revision link</button>
<div class="revision-picker"><label>Read immutable revision<input type="number" @bind="RevisionToRead" min="1" disabled="@Busy"></label><button @onclick="ReadRevisionAsync" disabled="@(Busy||RevisionToRead<1)">Read revision</button><button @onclick="()=>ReadPublicAsync(published.Id,null)" disabled="@Busy">Read current version</button></div>
<h3>Required inputs</h3><ul>@foreach(var input in published.Document.Inputs){<li>@input</li>}</ul><h3>Expected artifact</h3><p>@published.Document.Artifact</p><ol class="published-steps">@foreach(var step in published.Document.Steps){<li><h3>@step.Title</h3><p class="multiline">@step.Action</p><p><strong>Done when:</strong> @step.DoneWhen</p><p class="small">Estimated @step.Minutes minutes</p></li>}</ol>
<section class="outcomes"><h3>Explicit account-reported outcomes for revision @published.Revision</h3><dl><div><dt>Completed</dt><dd>@detail.Outcomes.Completed</dd></div><div><dt>Partial</dt><dd>@detail.Outcomes.Partial</dd></div><div><dt>Blocked</dt><dd>@detail.Outcomes.Blocked</dd></div></dl><p class="small">Self-reports, not verified executions, people or a measured success rate. Each account has one report per revision; changing it replaces that report. No local run record is sent automatically.</p>@if(detail.MyOutcome is not null){<p>Your saved report: <strong>@detail.MyOutcome.Kind</strong></p><p>@detail.MyOutcome.Note</p>}<label>Your result<select @bind="OutcomeKind" disabled="@(Busy||published.Withdrawn||published.Hidden)"><option value="">Choose explicitly</option><option value="completed">Completed</option><option value="partial">Partial</option><option value="blocked">Blocked</option></select></label><label>Optional public outcome note — up to 1,000 characters<textarea @bind="OutcomeNote" maxlength="1000" rows="3" disabled="@(Busy||published.Withdrawn||published.Hidden)"></textarea></label><button disabled="@(Busy||OutcomeKind.Length==0||published.Withdrawn||published.Hidden)" @onclick="SubmitOutcomeAsync">Explicitly submit / replace my public outcome</button><p class="small">Requires your <a href="/uyelik/">account</a>. Only the selected revision, outcome and this note are sent. Do not put confidential execution details in the public note.</p></section>
<details><summary>Report this public method</summary><label>Reason<select @bind="ReportReason" disabled="@Busy"><option value="spam">Spam</option><option value="unsafe">Unsafe instructions</option><option value="rights">Rights concern</option><option value="privacy">Private information</option></select></label><label>What should be reviewed?<textarea @bind="ReportNote" maxlength="1000" rows="3" disabled="@Busy"></textarea></label><button disabled="@Busy" @onclick="ReportAsync">Submit report with my account</button></details>
@if(published.Owned&&!published.Withdrawn){<section class="withdraw"><h3>Publication owner</h3><p>Withdrawal hides this method from public reads and new forks. Copies people already downloaded are independent files.</p><button disabled="@Busy" @onclick="WithdrawAsync">Withdraw my publication</button></section>}
}
else{<h2>A method worth reusing</h2><p>Choose a method to follow, adapt or review.</p>}
</section></div>
}
else if(View=="private")
{
<section class="vault"><h2>Optional private account copy</h2><p>The complete method and local runs are private to the account holding the saved copy. This is owner-only storage, with no invitations or version history. Local editing, JSON downloads and all method/run exports remain usable without an account.</p><p><a href="/uyelik/">Open your account</a>. Free accounts share 3 private items; active memberships share 100. This vault allows 64 KiB per JSON body for either plan. Large projects can still be downloaded as local JSON, up to 4 MB.</p><label>Private vault label — separate from the full method title<input @bind="VaultLabel" maxlength="100" disabled="@Busy"></label><p class="small">A label has 1–100 characters. The method title inside the saved body keeps its full 120-character allowance.</p><div class="actions"><button disabled="@Busy" @onclick="ListVaultAsync">List my saved procedure projects</button><button disabled="@Busy" @onclick="SaveVaultNewAsync">Save a new private copy</button>@if(VaultId is not null){<button disabled="@Busy" @onclick="SaveVaultExistingAsync">Replace selected private copy</button><button disabled="@Busy" @onclick="DetachVault">Detach saved-copy target</button>}</div>@if(VaultId is not null){<p>Selected owner copy: @VaultId. Replacing it overwrites that saved JSON; there is no revision conflict protection here. Your local export remains separate.</p>}@if(VaultLoaded&&VaultItems.Count==0){<p>No procedure projects were returned for this account.</p>}<ul class="vault-list">@foreach(var item in VaultItems){<li><button disabled="@Busy" @onclick="()=>LoadVaultAsync(item.Id)">@item.Title</button><span>@DateTimeOffset.FromUnixTimeMilliseconds(item.UpdatedAt).ToUniversalTime().ToString("u")</span></li>}</ul></section>
}
</main><footer><details class="page-help"><summary>Privacy and safety</summary>Methods you publish are public. Work notes stay private unless you export and share them.</details></footer>
</div>
</PageSurface>
