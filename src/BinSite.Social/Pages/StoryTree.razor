@page "/hikaye-agaci/"
@inherits ProductComponent
<PageTitle>Story Tree — Write a story together</PageTitle>
<div class="story-page">
    <header>
        <nav aria-label="Navigation"><a href="/">Home</a><span>Story Tree</span><LanguageSwitch /></nav>
        <h1>Write a story together.</h1>
        <p>You write the beginning. Others add different continuations. Readers choose what happens next.</p>
        <button @onclick="ShowComposer" disabled="@Busy">Start a story</button>
    </header>
    @if (!string.IsNullOrEmpty(Status)) {
        <div class="status" data-error="@HasError.ToString().ToLowerInvariant()" role="status">@Status</div>
    }
    <div class="layout">
        <main>
        @if (Creating) {
            <section class="composer">
                <h2>How does your story begin?</h2>
                <form @onsubmit="CreateAsync" @onsubmit:preventDefault novalidate>
                    <label for="story-title">Title</label>
                    <input id="story-title" @bind="Title" @bind:event="oninput" maxlength="100" aria-invalid="@(TitleError.Length > 0 ? "true" : "false")" aria-describedby="title-error">
                    <p id="title-error" class="field-error">@TitleError</p>
                    <label for="story-opening">First paragraph</label>
                    <textarea id="story-opening" @bind="Opening" @bind:event="oninput" maxlength="1600" placeholder="Something unexpected happens…" aria-invalid="@(OpeningError.Length > 0 ? "true" : "false")" aria-describedby="opening-hint opening-error"></textarea>
                    <p id="opening-hint" class="hint">30–1,600 characters. Your story and its continuations will be public.</p>
                    <p id="opening-error" class="field-error">@OpeningError</p>
                    <div class="toolbar"><button type="submit" disabled="@Busy">@(Busy ? "Publishing…" : PendingStory is not null ? "Open published story" : "Publish story")</button><button type="button" class="secondary" @onclick="HideComposer" disabled="@Busy">Back to reading</button></div>
                </form>
                <details class="prompts"><summary>Need a starting idea?</summary>
                    @foreach (var prompt in EditorialPrompts.Stories) {
                        <button class="story-choice" @onclick="() => UsePrompt(prompt)"><strong>@prompt.Title</strong><span>@prompt.Opening</span></button>
                    }
                </details>
            </section>
        } else if (Current is null) {
            <section class="example" aria-label="Interactive story example">
                <div class="section-heading"><h2>Try a story</h2><span class="hint">Example</span></div>
                <h3>The last train</h3>
                <article class="paragraph"><p>@ExampleOpening</p></article>
                @if (ExampleChoice == 0) {
                    <h3>What happens next?</h3>
                    <div class="branches"><button class="branch" @onclick="() => ExampleChoice = 1"><strong>Board the train</strong><span>The doors open. Someone inside knows your name.</span><span aria-hidden="true">→</span></button><button class="branch" @onclick="() => ExampleChoice = 2"><strong>Follow the suitcase</strong><span>It rolls toward a staircase that wasn't there before.</span><span aria-hidden="true">→</span></button></div>
                } else {
                    <article class="paragraph current"><p>@(ExampleChoice == 1 ? "Every passenger is holding the same photograph: you, standing on this platform tomorrow. A child offers you the empty seat beside her. ‘We still have time to change it,’ she says." : "The staircase leads below the tracks to a room full of unopened letters. One has today's date and your handwriting. Inside is a single sentence: ‘Whatever happens, do not board the train.’")</p></article>
                    <p class="hint">One beginning, two different stories. You can add another path.</p>
                    <button class="secondary" @onclick="() => ExampleChoice = 0">Try the other path</button>
                }
                <div class="example-action"><button @onclick="UseExample">Start from this beginning</button></div>
            </section>
        } else {
            <section class="reading">
                <h2>@Current.Story.Title</h2>
                <div class="toolbar"><button class="secondary" disabled="@Busy" @onclick="() => CopyAsync(ShareLink())">Copy story link</button><button class="secondary" disabled="@Busy" @onclick="ReloadCurrentAsync">Refresh</button></div>
                @if (CopyFallback is not null) { <input class="copy-fallback" readonly value="@CopyFallback" aria-label="Story link"> }
                @foreach (var node in Trail()) {
                    <article @key="node.Id" class="@(node.Id == SelectedId ? "paragraph current" : "paragraph")"><p>@(node.Hidden == 1 ? "This paragraph is unavailable." : node.Body)</p>
                        @if (node.Id != SelectedId) { <button class="secondary" @onclick="() => SelectNodeAsync(node.Id)">Choose a different continuation here</button> }
                        @if (node.Hidden == 0) { <ReportBox Kind="node" TargetId="@node.Id" /> }
                    </article>
                }
                <h3>What happens next?</h3>
                <div class="branches">@foreach (var child in Current.Nodes.Where(node => node.ParentId == SelectedId)) {
                    <button class="branch" @onclick="() => SelectNodeAsync(child.Id)">@(child.Hidden == 1 ? "Read the next available paragraph →" : child.Body)</button>
                }</div>
                @if (!Current.Nodes.Any(node => node.ParentId == SelectedId)) { <p class="hint">No continuation yet. What would you write?</p> }
                @if (CanContinue()) {
                    <form class="continuation" @onsubmit="ContinueAsync" @onsubmit:preventDefault novalidate>
                        <label for="continuation">Add your continuation</label>
                        <textarea id="continuation" @bind="Continuation" @bind:event="oninput" maxlength="1600" aria-invalid="@(ContinuationError.Length > 0 ? "true" : "false")" aria-describedby="continuation-hint continuation-error"></textarea>
                        <p id="continuation-hint" class="hint">30–1,600 characters. This adds a new path for everyone to read.</p>
                        <p id="continuation-error" class="field-error">@ContinuationError</p>
                        <button type="submit" disabled="@Busy">@(Busy ? "Publishing…" : PendingContinuation is not null ? "Open published continuation" : "Publish continuation")</button>
                    </form>
                } else { <p class="hint">Choose an earlier paragraph to add a continuation.</p> }
                <ReportBox Kind="story" TargetId="@Current.Story.Id" />
            </section>
        }
        </main>
        <aside class="sidebar" aria-label="Find a story">
            <h2>Read a story</h2>
            <form class="search" @onsubmit="RefreshAsync" @onsubmit:preventDefault><label for="story-search">Find by title</label><div><input id="story-search" @bind="Search" type="search" maxlength="80"><button type="submit" class="secondary" disabled="@Busy">Search</button></div></form>
            <div class="story-list">
                @if (Stories.Count == 0) { <p class="hint">@(Busy ? "Loading stories…" : string.IsNullOrWhiteSpace(Search) ? "No stories published yet. Try the example or start your own." : "No stories match that title.")</p> }
                @foreach (var story in Stories) { <button class="story-choice" aria-current="@(Current?.Story.Id == story.Id ? "true" : null)" @onclick="() => OpenStoryAsync(story.Id)"><strong>@story.Title</strong><span>@story.NodeCount @(story.NodeCount == 1 ? "paragraph" : "paragraphs")</span></button> }
            </div>
        </aside>
    </div>
    <footer><details><summary>About publishing and privacy</summary><p>Only share writing you have permission to publish. Keep personal information, harassment and spam out of stories. Use Report on an inappropriate paragraph.</p><p>Stories allow up to 300 paragraphs and paths up to 24 continuations long. Content reported from three different network addresses is hidden automatically. Anonymous cookie identifiers, network-address hashes and report reasons help limit abuse. Reports are not reviewed by a human in this version.</p><a href="/privacy/">Privacy</a></details></footer>
</div>
@code {
    [SupplyParameterFromQuery(Name = "hikaye")] public string? StoryId { get; set; }
    [SupplyParameterFromQuery(Name = "dal")] public string? BranchId { get; set; }
    const string ExampleOpening = "At midnight, the station clock stopped. A train that wasn't on the timetable pulled in, and a red suitcase rolled out onto the empty platform.";
    List<StorySummary> Stories = [];
    StoryDetail? Current;
    string Search = "", Title = "", Opening = "", Continuation = "";
    string TitleError = "", OpeningError = "", ContinuationError = "";
    string? SelectedId;
    CreatedResponse? PendingStory, PendingContinuation;
    string? PendingContinuationStoryId;
    bool Creating;
    int ExampleChoice;

    protected override async Task OnParametersSetAsync() => await ExecuteAsync(async () => { await LoadListAsync(); if (!string.IsNullOrEmpty(StoryId)) await LoadStoryAsync(StoryId, BranchId); });
    async Task LoadListAsync() => Stories = (await Api.GetAsync<StoriesResponse>("stories?q=" + Uri.EscapeDataString(Search))).Stories;
    Task RefreshAsync() => ExecuteAsync(LoadListAsync);
    Task OpenStoryAsync(string id) => ExecuteAsync(() => LoadStoryAsync(id));
    async Task LoadStoryAsync(string id, string? selected = null)
    {
        var loaded = await Api.GetAsync<StoryDetail>("stories/" + id);
        Current = loaded;
        SelectedId = loaded.Nodes.Any(node => node.Id == selected) ? selected : loaded.Nodes.FirstOrDefault(node => node.ParentId is null)?.Id;
        Creating = false;
        await Javascript.InvokeVoidAsync("binSiteSocial.replaceUrl", ShareLink());
    }
    Task ReloadCurrentAsync() => Current is null ? Task.CompletedTask : ExecuteAsync(() => LoadStoryAsync(Current.Story.Id, SelectedId));
    void ShowComposer() { Creating = true; Status = ""; }
    void HideComposer() => Creating = false;
    void UsePrompt(StoryPrompt prompt) { if (PendingStory is not null) return; Title = prompt.Title; Opening = prompt.Opening; TitleError = OpeningError = ""; Creating = true; }
    void UseExample() { if (PendingStory is not null) { Creating = true; return; } Title = "The last train"; Opening = ExampleOpening; Creating = true; TitleError = OpeningError = ""; }
    async Task CreateAsync()
    {
        if (Busy) return;
        if (PendingStory is null) {
            TitleError = ValidateText(Title, "Title", 4, 100);
            OpeningError = ValidateText(Opening, "First paragraph", 30, 1600);
            if (TitleError.Length + OpeningError.Length > 0) return;
        }
        await ExecuteAsync(async () => {
            PendingStory ??= await Api.PostAsync<CreatedResponse>("stories", new { title = Title, body = Opening });
            await LoadStoryAsync(PendingStory.Id, PendingStory.NodeId);
            PendingStory = null;
            Title = Opening = "";
            await LoadListAsync();
        }, "Your story is published. Copy its link to invite someone to continue it.");
    }
    async Task ContinueAsync()
    {
        if (Busy || Current is null || SelectedId is null) return;
        if (PendingContinuation is null) {
            ContinuationError = ValidateText(Continuation, "Continuation", 30, 1600);
            if (ContinuationError.Length > 0) return;
        }
        await ExecuteAsync(async () => {
            if (PendingContinuation is null) {
                PendingContinuationStoryId = Current.Story.Id;
                PendingContinuation = await Api.PostAsync<CreatedResponse>($"stories/{Current.Story.Id}/nodes", new { parentId = SelectedId, body = Continuation });
            }
            await LoadStoryAsync(PendingContinuationStoryId!, PendingContinuation.Id);
            PendingContinuation = null;
            Continuation = "";
            await LoadListAsync();
        }, "Your continuation is published.");
    }
    static string ValidateText(string value, string label, int min, int max)
    {
        var clean = value.Trim().Normalize();
        if (clean.Length < min || clean.Length > max) return $"{label} must be {min:N0}–{max:N0} characters.";
        if (System.Text.RegularExpressions.Regex.IsMatch(clean, @"[\x00-\x08\x0B\x0C\x0E-\x1F]")) return $"Remove unsupported characters from {label.ToLowerInvariant()}.";
        if (System.Text.RegularExpressions.Regex.IsMatch(clean, @"(.)\1{39,}")) return $"Remove long runs of repeated characters from {label.ToLowerInvariant()}.";
        if (System.Text.RegularExpressions.Regex.Matches(clean, @"https?://", System.Text.RegularExpressions.RegexOptions.IgnoreCase).Count > 2) return $"Use no more than two links in {label.ToLowerInvariant()}.";
        return "";
    }
    async Task SelectNodeAsync(string id) { SelectedId = id; await Javascript.InvokeVoidAsync("binSiteSocial.replaceUrl", ShareLink()); }
    List<StoryNode> Trail()
    {
        List<StoryNode> trail = []; HashSet<string> seen = [];
        var node = Current?.Nodes.FirstOrDefault(item => item.Id == SelectedId);
        while (node is not null && seen.Add(node.Id)) { trail.Insert(0, node); node = Current?.Nodes.FirstOrDefault(item => item.Id == node.ParentId); }
        return trail;
    }
    bool CanContinue() => Current is not null && Current.Nodes.Count < 300 && Current.Nodes.Any(node => node.Id == SelectedId && node.Hidden == 0 && node.Depth < 24);
    string ShareLink() => new Uri(new Uri(Navigation.BaseUri), $"hikaye-agaci/?hikaye={Current?.Story.Id}&dal={SelectedId}").AbsoluteUri;
}
