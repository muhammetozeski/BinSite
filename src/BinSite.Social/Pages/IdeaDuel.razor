@page "/fikir-duellosu/"
@inherits ProductComponent
<PageTitle>@T("Fikir Düellosu — İki fikir, bir seçim", "Idea Duel — Two ideas, one choice")</PageTitle>
<PageSurface>
<div class="duel-page"><header><div class="topbar"><LanguageSwitch /></div><h1>@T("Fikir Düellosu", "Idea Duel")</h1><p>Ask a question with two choices, then share it for people to vote.</p><div class="topbar">@if (!Creating) { <button disabled="@Busy" @onclick="() => Creating = true">@T("Bir düello kur", "Ask a question")</button> }<button class="quiet" disabled="@Busy" @onclick="RefreshAsync">@T("Güncel düellolar", "Refresh")</button></div></header>
@if (!string.IsNullOrEmpty(Status)) { <div class="status" data-error="@HasError.ToString().ToLowerInvariant()" role="status">@Status</div> }
<main>
@if (Creating) { <section class="composer"><h2>@T("Hangisi kazansın?", "Which should win?")</h2><form @onsubmit="CreateAsync" @onsubmit:preventDefault><label for="duel-question">@T("İki fikri karşılaştıran soru", "A question comparing two ideas")</label><textarea id="duel-question" @bind="Question" required minlength="8" maxlength="240"></textarea><div class="two"><div><label for="duel-a">@T("A fikri", "Idea A")</label><input id="duel-a" @bind="OptionA" required minlength="2" maxlength="140"></div><div><label for="duel-b">@T("B fikri", "Idea B")</label><input id="duel-b" @bind="OptionB" required minlength="2" maxlength="140"></div></div><p class="small">@T("Soru ve öneriler herkese açık yayımlanır. Oy sayısı sıfırdan başlar.", "Your question and choices will be public.")</p><div class="actions"><button type="submit" disabled="@Busy">@T("Düelloyu yayımla", "Publish question")</button><button type="button" class="quiet" @onclick="() => Creating = false">@T("Vazgeç", "Cancel")</button></div></form></section> }
<div class="board" hidden="@Creating"><section class="arena">
@if (Current is null) { <div class="placeholder"><h2>@T("İlk karşılaşmayı seç.", "Choose a matchup.")</h2><p class="small">@T("Bir düelloya katıl veya iki fikrini kendin karşılaştır. Başlangıç önerileri aşağıda.", "Choose a duel or create one.")</p></div> }
else { <h2>@Current.Poll.Question</h2><div class="contestants">@for (var index = 0; index < 2; index++) { var choice = index; var votes = choice == 0 ? Current.Totals.A : Current.Totals.B; <button class="@(choice == 0 ? "contender a" : "contender b")" disabled="@(Busy || Current.MyVote is not null)" aria-pressed="@(Current.MyVote == choice ? "true" : "false")" @onclick="() => VoteAsync(choice)"><small>@(choice == 0 ? "A" : "B") @(Current.MyVote == choice ? T("· SENİN SEÇİMİN", "· YOUR CHOICE") : "")</small><span>@(choice == 0 ? Current.Poll.OptionA : Current.Poll.OptionB)</span><strong class="vote-count">@votes @T("oy", "votes")</strong></button> }</div><div class="result-bar" role="img" aria-label="@ResultLabel()"><span class="part-a" style="@($"width:{PercentA()}%")"></span><span class="part-b" style="@($"width:{(TotalVotes() == 0 ? 0 : 100 - PercentA())}%")"></span></div><p class="small">@ResultLabel()</p><p class="small">@(Current.MyVote is null ? T("Oy vermek için bir fikir seç. Bu tarayıcı kimliğiyle bir kez oy kaydedilir.", "Choose an idea to vote.") : T("Oyun sunucuda kaydedildi. Sonuçları yenileyebilir veya düelloyu paylaşabilirsin.", "Your choice is marked above."))</p><div class="actions"><button disabled="@Busy" @onclick="() => CopyAsync(ShareLink())">@T("Düelloyu paylaş", "Copy voting link")</button></div>@if (CopyFallback is not null) { <input class="copy-fallback" readonly value="@CopyFallback" aria-label="@T("Düello bağlantısı", "Duel link")"> }<ReportBox Kind="poll" TargetId="@Current.Poll.Id" /> }
</section><aside><h2>@T("Açık meydan", "Questions")</h2><div class="list">@if (Polls.Count == 0) { <p class="small">@T("Henüz bir düello yok. İlk iki fikri sen karşılaştır.", "No duels yet. Compare the first two ideas.")</p> }@foreach (var poll in Polls) { <button class="poll-link" disabled="@Busy" @onclick="() => OpenPollAsync(poll.Id)"><strong>@poll.Question</strong><span>@poll.VoteCount @T("oy", "votes") · @DateLabel(poll.CreatedAt)</span></button> }</div></aside></div>
<details class="suggestions"><summary>@T("15 editoryal düello önerisi", "Question ideas")</summary><p class="small">@T("Bu sorular gerçek kullanıcı gönderileri değildir. Birini seçip düzenledikten sonra kendin yayımlarsın. Metinler Türkçedir.", "Examples you can edit before publishing.")</p><div class="suggestion-grid">@foreach (var prompt in EditorialPrompts.Polls) { <button class="poll-link" @onclick="() => UsePrompt(prompt)"><strong>@prompt.Question</strong><span>A: @prompt.OptionA</span><span>B: @prompt.OptionB</span></button> }</div></details>
</main><footer><details class="page-help"><summary>Privacy and safety</summary><p class="small">@T("Bir düelloda anonim tarayıcı kimliği başına bir oy saklanır. Aynı çerez kimliğiyle ikinci oy sunucuda reddedilir. Çerezi silmek veya farklı tarayıcı kullanmak yeni kimlik oluşturabilir; kişi doğrulaması ve resmî oylama güvencesi sunulmaz. Ağ adresinin özetiyle de işlem hızı sınırlanır. Gönderiler ve oylar Cloudflare veritabanında saklanır.", "Questions and vote totals are public. You can vote once in this browser; switching browsers can allow another vote. These polls do not verify who votes.")</p><p class="small">@T("Kişisel bilgi, taciz, nefret söylemi, izinsiz eser ve spam paylaşma. Üç farklı ağ adresinden raporlanan düello otomatik gizlenir. Rapor gerekçeleri saklanır; bu sürümde insan inceleme hizmeti sunulmaz.", "No personal information, harassment, hate, unauthorized works or spam. Reports may hide a question automatically and are not reviewed by a person.")</p></details></footer></div>
</PageSurface>
@code {
    [SupplyParameterFromQuery(Name = "duello")] public string? PollId { get; set; }
    List<PollSummary> Polls = [];
    PollDetail? Current;
    string Question = "", OptionA = "", OptionB = "";
    bool Creating;

    /// <summary>Loads the actual public poll directory and an optional shared poll.</summary>
    protected override Task OnParametersSetAsync() => ExecuteAsync(async () => { await LoadListAsync(); if (!string.IsNullOrEmpty(PollId)) await LoadPollAsync(PollId); else if (Polls.Count == 0) Creating = true; });
    /// <summary>Retrieves the latest visible polls and actual vote totals.</summary>
    async Task LoadListAsync() => Polls = (await Api.GetAsync<PollsResponse>("polls")).Polls;
    /// <summary>Refreshes the directory within the final UI action boundary.</summary>
    Task RefreshAsync() => ExecuteAsync(async () => { await LoadListAsync(); if (Current is not null) await LoadPollAsync(Current.Poll.Id); });
    /// <summary>Opens a selected actual poll from the directory.</summary>
    Task OpenPollAsync(string id) => ExecuteAsync(() => LoadPollAsync(id));
    /// <summary>Reads a poll and updates its independent share address.</summary>
    async Task LoadPollAsync(string id) { Current = await Api.GetAsync<PollDetail>("polls/" + id); await Javascript.InvokeVoidAsync("binSiteSocial.replaceUrl", ShareLink()); }
    /// <summary>Requests the latest aggregate results from the server.</summary>
    Task ReloadCurrentAsync() => Current is null ? Task.CompletedTask : ExecuteAsync(() => LoadPollAsync(Current.Poll.Id));
    /// <summary>Fills an unpublished draft from a clearly labelled editorial suggestion.</summary>
    void UsePrompt(PollPrompt prompt) { Question = prompt.Question; OptionA = prompt.OptionA; OptionB = prompt.OptionB; Creating = true; }
    /// <summary>Publishes one actual poll with zero initial votes.</summary>
    Task CreateAsync() => ExecuteAsync(async () => { var created = await Api.PostAsync<CreatedResponse>("polls", new { question = Question, optionA = OptionA, optionB = OptionB }); await LoadPollAsync(created.Id); Creating = false; Question = OptionA = OptionB = ""; await LoadListAsync(); }, T("Düellon açıldı. Bağlantısını paylaşarak oy toplayabilirsin.", "Question published."));
    /// <summary>Records one vote without retrying the mutation; the server enforces cookie-level uniqueness.</summary>
    Task VoteAsync(int choice) => ExecuteAsync(async () => { if (Current is null) return; Current = await Api.PostAsync<PollDetail>($"polls/{Current.Poll.Id}/votes", new { choice }); await LoadListAsync(); }, T("Oyun sunucuya kaydedildi.", "Vote saved."));
    /// <summary>Returns actual recorded votes for both options.</summary>
    int TotalVotes() => Current is null ? 0 : Current.Totals.A + Current.Totals.B;
    /// <summary>Calculates an integer percentage without inventing activity when the count is zero.</summary>
    int PercentA() => TotalVotes() == 0 || Current is null ? 0 : (int)Math.Round(Current.Totals.A * 100.0 / TotalVotes());
    /// <summary>Describes current server results accessibly in the chosen language.</summary>
    string ResultLabel() => TotalVotes() == 0 ? T("Henüz oy yok. İlk seçimi sen yap.", "No votes yet. Make the first choice.") : $"{TotalVotes()} {T("gerçek oy", "votes")} · A {PercentA()}% / B {100 - PercentA()}%";
    /// <summary>Builds the current poll's independently usable share URL.</summary>
    string ShareLink() => new Uri(new Uri(Navigation.BaseUri), "fikir-duellosu/?duello=" + Current?.Poll.Id).AbsoluteUri;
}
