@page "/fikir-duellosu/"
@inherits ProductComponent
<PageTitle>@T("Fikir Düellosu — İki fikir, bir seçim", "Idea Duel — Two ideas, one choice")</PageTitle>
<div class="duel-page"><header><div class="topbar"><span class="tag">@T("FİKİRLERİ KONUŞTUR", "LET THE IDEAS COMPETE")</span><LanguageSwitch /></div><h1>@T("Fikir Düellosu", "Idea Duel")</h1><p>@T("Bir şehirde tek bir eğlence hakkın olsa hangisini kurardın? İki öneriyi karşı karşıya getir; kararı gerçek oylar versin.", "If your city could add only one new experience, which would you build? Put two ideas against one another and let actual votes decide.")</p><div class="topbar"><button @onclick="() => Creating = true">@T("Bir düello kur", "Create a duel")</button><button class="quiet" disabled="@Busy" @onclick="RefreshAsync">@T("Güncel düellolar", "Refresh duels")</button></div></header>
@if (!string.IsNullOrEmpty(Status)) { <div class="status" data-error="@HasError.ToString().ToLowerInvariant()" role="status">@Status</div> }
<main>
@if (Creating) { <section class="composer"><h2>@T("Hangisi kazansın?", "Which should win?")</h2><form @onsubmit="CreateAsync" @onsubmit:preventDefault><label for="duel-question">@T("İki fikri karşılaştıran soru", "A question comparing two ideas")</label><textarea id="duel-question" @bind="Question" required minlength="8" maxlength="240"></textarea><div class="two"><div><label for="duel-a">@T("A fikri", "Idea A")</label><input id="duel-a" @bind="OptionA" required minlength="2" maxlength="140"></div><div><label for="duel-b">@T("B fikri", "Idea B")</label><input id="duel-b" @bind="OptionB" required minlength="2" maxlength="140"></div></div><p class="small">@T("Soru ve öneriler herkese açık yayımlanır. Oy sayısı sıfırdan başlar.", "The question and options are published publicly. The vote count starts at zero.")</p><div class="actions"><button type="submit" disabled="@Busy">@T("Düelloyu yayımla", "Publish duel")</button><button type="button" class="quiet" @onclick="() => Creating = false">@T("Vazgeç", "Cancel")</button></div></form></section> }
<div class="board"><section class="arena">
@if (Current is null) { <div class="placeholder"><h2>@T("İlk karşılaşmayı seç.", "Choose a matchup.")</h2><p class="small">@T("Bir düelloya katıl veya iki fikrini kendin karşılaştır. Başlangıç önerileri aşağıda.", "Join an actual duel or compare two ideas yourself. Editorial suggestions are below.")</p></div> }
else { <span class="tag">@T("A MI, B Mİ?", "A OR B?")</span><h2>@Current.Poll.Question</h2><div class="contestants">@for (var index = 0; index < 2; index++) { var choice = index; var votes = choice == 0 ? Current.Totals.A : Current.Totals.B; <button class="@(choice == 0 ? "contender a" : "contender b")" disabled="@(Busy || Current.MyVote is not null)" aria-pressed="@(Current.MyVote == choice ? "true" : "false")" @onclick="() => VoteAsync(choice)"><small>@(choice == 0 ? "A" : "B") @(Current.MyVote == choice ? T("· SENİN SEÇİMİN", "· YOUR CHOICE") : "")</small><span>@(choice == 0 ? Current.Poll.OptionA : Current.Poll.OptionB)</span><strong class="vote-count">@votes @T("oy", "votes")</strong></button> }</div><div class="result-bar" role="img" aria-label="@ResultLabel()"><span class="part-a" style="@($"width:{PercentA()}%")"></span><span class="part-b" style="@($"width:{(TotalVotes() == 0 ? 0 : 100 - PercentA())}%")"></span></div><p class="small">@ResultLabel()</p><p class="small">@(Current.MyVote is null ? T("Oy vermek için bir fikir seç. Bu tarayıcı kimliğiyle bir kez oy kaydedilir.", "Choose an idea to vote. One vote is recorded for this browser identity.") : T("Oyun sunucuda kaydedildi. Sonuçları yenileyebilir veya düelloyu paylaşabilirsin.", "Your vote is saved on the server. Refresh results or share the duel."))</p><div class="actions"><button disabled="@Busy" @onclick="() => CopyAsync(ShareLink())">@T("Düelloyu paylaş", "Share duel")</button><button disabled="@Busy" class="quiet" @onclick="ReloadCurrentAsync">@T("Sonuçları yenile", "Refresh results")</button></div>@if (CopyFallback is not null) { <input class="copy-fallback" readonly value="@CopyFallback" aria-label="@T("Düello bağlantısı", "Duel link")"> }<ReportBox Kind="poll" TargetId="@Current.Poll.Id" /> }
</section><aside><h2>@T("Açık meydan", "Open arena")</h2><p class="small">@T("Son 24 düello. Sonuçlar paylaşılan sunucuda saklanır.", "Latest 24 duels. Results are stored on the shared server.")</p><div class="list">@if (Polls.Count == 0) { <p class="small">@T("Henüz bir düello yok. İlk iki fikri sen karşılaştır.", "No duels yet. Compare the first two ideas.")</p> }@foreach (var poll in Polls) { <button class="poll-link" disabled="@Busy" @onclick="() => OpenPollAsync(poll.Id)"><strong>@poll.Question</strong><span>@poll.VoteCount @T("oy", "votes") · @DateLabel(poll.CreatedAt)</span></button> }</div></aside></div>
<details class="suggestions"><summary>@T("15 editoryal düello önerisi", "15 editorial duel suggestions")</summary><p class="small">@T("Bu sorular gerçek kullanıcı gönderileri değildir. Birini seçip düzenledikten sonra kendin yayımlarsın. Metinler Türkçedir.", "These English questions are editorial suggestions, not user posts. Select, edit and publish one yourself.")</p><div class="suggestion-grid">@foreach (var prompt in EditorialPrompts.Polls) { <button class="poll-link" @onclick="() => UsePrompt(prompt)"><strong>@prompt.Question</strong><span>A: @prompt.OptionA</span><span>B: @prompt.OptionB</span></button> }</div></details>
</main><footer><h2>@T("Gerçek oylar, açık sınırlar", "Real votes, explicit limits")</h2><p class="small">@T("Bir düelloda anonim tarayıcı kimliği başına bir oy saklanır. Aynı çerez kimliğiyle ikinci oy sunucuda reddedilir. Çerezi silmek veya farklı tarayıcı kullanmak yeni kimlik oluşturabilir; kişi doğrulaması ve resmî oylama güvencesi sunulmaz. Ağ adresinin özetiyle de işlem hızı sınırlanır. Gönderiler ve oylar Cloudflare veritabanında saklanır.", "One vote is stored per anonymous browser identity in each duel. The server rejects a second vote from the same cookie identity. Clearing cookies or using another browser can create another identity. This is not person verification or an official voting guarantee. Hashed network addresses also limit request rates. Posts and votes are stored in a Cloudflare database.")</p><p class="small">@T("Kişisel bilgi, taciz, nefret söylemi, izinsiz eser ve spam paylaşma. Üç farklı ağ adresinden raporlanan düello otomatik gizlenir. Rapor gerekçeleri saklanır; bu sürümde insan inceleme hizmeti sunulmaz.", "No personal information, harassment, hate, unauthorized works or spam. A duel reported by three distinct network addresses is automatically hidden. Report reasons are stored; this version does not provide human review.")</p></footer></div>
@code {
    [SupplyParameterFromQuery(Name = "duello")] public string? PollId { get; set; }
    List<PollSummary> Polls = [];
    PollDetail? Current;
    string Question = "", OptionA = "", OptionB = "";
    bool Creating;

    /// <summary>Loads the actual public poll directory and an optional shared poll.</summary>
    protected override Task OnParametersSetAsync() => ExecuteAsync(async () => { await LoadListAsync(); if (!string.IsNullOrEmpty(PollId)) await LoadPollAsync(PollId); });
    /// <summary>Retrieves the latest visible polls and actual vote totals.</summary>
    async Task LoadListAsync() => Polls = (await Api.GetAsync<PollsResponse>("polls")).Polls;
    /// <summary>Refreshes the directory within the final UI action boundary.</summary>
    Task RefreshAsync() => ExecuteAsync(LoadListAsync);
    /// <summary>Opens a selected actual poll from the directory.</summary>
    Task OpenPollAsync(string id) => ExecuteAsync(() => LoadPollAsync(id));
    /// <summary>Reads a poll and updates its independent share address.</summary>
    async Task LoadPollAsync(string id) { Current = await Api.GetAsync<PollDetail>("polls/" + id); await Javascript.InvokeVoidAsync("binSiteSocial.replaceUrl", ShareLink()); }
    /// <summary>Requests the latest aggregate results from the server.</summary>
    Task ReloadCurrentAsync() => Current is null ? Task.CompletedTask : ExecuteAsync(() => LoadPollAsync(Current.Poll.Id));
    /// <summary>Fills an unpublished draft from a clearly labelled editorial suggestion.</summary>
    void UsePrompt(PollPrompt prompt) { Question = prompt.Question; OptionA = prompt.OptionA; OptionB = prompt.OptionB; Creating = true; }
    /// <summary>Publishes one actual poll with zero initial votes.</summary>
    Task CreateAsync() => ExecuteAsync(async () => { var created = await Api.PostAsync<CreatedResponse>("polls", new { question = Question, optionA = OptionA, optionB = OptionB }); await LoadPollAsync(created.Id); Creating = false; Question = OptionA = OptionB = ""; await LoadListAsync(); }, T("Düellon açıldı. Bağlantısını paylaşarak oy toplayabilirsin.", "Your duel is open. Share the link to collect votes."));
    /// <summary>Records one vote without retrying the mutation; the server enforces cookie-level uniqueness.</summary>
    Task VoteAsync(int choice) => ExecuteAsync(async () => { if (Current is null) return; Current = await Api.PostAsync<PollDetail>($"polls/{Current.Poll.Id}/votes", new { choice }); await LoadListAsync(); }, T("Oyun sunucuya kaydedildi.", "Your vote was recorded on the server."));
    /// <summary>Returns actual recorded votes for both options.</summary>
    int TotalVotes() => Current is null ? 0 : Current.Totals.A + Current.Totals.B;
    /// <summary>Calculates an integer percentage without inventing activity when the count is zero.</summary>
    int PercentA() => TotalVotes() == 0 || Current is null ? 0 : (int)Math.Round(Current.Totals.A * 100.0 / TotalVotes());
    /// <summary>Describes current server results accessibly in the chosen language.</summary>
    string ResultLabel() => TotalVotes() == 0 ? T("Henüz oy yok. İlk seçimi sen yap.", "No votes yet. Make the first choice.") : $"{TotalVotes()} {T("gerçek oy", "actual votes")} · A %{PercentA()} / B %{100 - PercentA()}";
    /// <summary>Builds the current poll's independently usable share URL.</summary>
    string ShareLink() => new Uri(new Uri(Navigation.BaseUri), "fikir-duellosu/?duello=" + Current?.Poll.Id).AbsoluteUri;
}
