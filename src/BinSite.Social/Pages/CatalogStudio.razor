@page "/catalog-studio/"
@using System.Globalization
@implements IAsyncDisposable
@inject IJSRuntime Javascript
@inject ILogger<CatalogStudio> Logger
@inject SocialApi Api
<PageTitle>Catalog Studio — Import, repair and publish a product catalog</PageTitle>
<PageSurface>

<div class="catalog-studio">
    <header>
        <h1>Catalog Studio</h1><p>Turn product data and photos into a searchable catalog.</p><p class="privacy">Save a project file before closing this tab.</p>


    </header>
    <p class="status @(HasError ? "error" : "")" role="status" aria-live="polite">@Status</p>
    <fieldset disabled="@Busy">
        <details><summary>Catalog settings</summary><section class="workspace-settings" aria-label="Catalog settings">
            <label>Catalog title<input @bind="Project.Title" @bind:after="RefreshIssues" maxlength="120" /></label>
            <label>Currency<input @bind="Project.Currency" @bind:after="NormalizeCurrency" maxlength="3" placeholder="USD" /></label>
            <label>Price decimal separator<select @bind="Project.DecimalSeparator" @bind:after="RefreshIssues"><option value=".">Dot: 1234.50</option><option value=",">Comma: 1234,50</option></select></label>
            <label class="wide">Catalog introduction<textarea @bind="Project.Description" maxlength="4000" rows="2"></textarea></label>
        </section></details>

        <details class="panel" open>
            <summary>1. Import CSV and map its columns</summary>

            <div class="toolbar">
                <label>Open CSV · up to 5 MB<input type="file" accept=".csv,.tsv,text/csv,text/plain" @ref="CsvInput" @onchange="ReadCsvAsync" disabled="@(!ModuleReady)" /></label>

                <button @onclick="StageExampleCsv">Use sample CSV</button>

            </div>
            <details><summary>Paste a list or change import options</summary><label>Column separator<select @bind="Delimiter"><option value="auto">Detect automatically</option><option value=",">Comma</option><option value=";">Semicolon</option><option value="tab">Tab</option></select></label><label>Paste CSV<textarea class="csv-source" @bind="CsvText" rows="5" maxlength="5000000" spellcheck="false" placeholder="SKU,Name,Price,Category,Description,Stock,Image Filename"></textarea></label><button @onclick="AnalyzeCsv" disabled="@(CsvText.Length == 0)">Read this list</button></details>
            @if (CsvTable is not null)
            {
                <p>@CsvTable.Rows.Count products · @CsvSourceName</p>
                <div class="column-map">
                    <label>Product code · required<select @bind="Mapping.Sku">@ColumnOptions()</select></label>
                    <label>Product name · required<select @bind="Mapping.Name">@ColumnOptions()</select></label>
                    <label>Price · required<select @bind="Mapping.Price">@ColumnOptions()</select></label>
                    <label>Description<select @bind="Mapping.Description">@ColumnOptions()</select></label>
                    <label>Category<select @bind="Mapping.Category">@ColumnOptions()</select></label>
                    <label>Stock<select @bind="Mapping.Stock">@ColumnOptions()</select></label>
                    <label>Image filename<select @bind="Mapping.Image">@ColumnOptions()</select></label>
                </div>
                @if (CsvTable.Issues.Count > 0)
                {
                    <ul class="import-errors">@foreach (var issue in CsvTable.Issues.Take(100)) { <li>Line @issue.Row: @issue.Message</li> }</ul>
                }
                <div class="table-scroll">
                    <table class="source-preview"><caption>Preview of your file</caption><thead><tr><th>Line</th>@foreach (var header in CsvTable.Headers) { <th>@header</th> }</tr></thead>
                    <tbody>@foreach (var row in CsvTable.Rows.Take(6)) { <tr><th>@row.Line</th>@foreach (var cell in row.Cells) { <td>@cell</td> }</tr> }</tbody></table>
                </div>
                <button @onclick="ImportCsv" disabled="@(CsvTable.Issues.Any(issue => issue.IsError) || ParsedCsv != CsvText || ParsedDelimiter != Delimiter)">Use these products</button>
                <p class="small">This replaces the current product list. You can undo the import.</p>
            }
        </details>

        <details class="panel" aria-label="Product photos"><summary>2. Add photos (optional)</summary>

            <div class="toolbar">
                <label>PNG, JPEG or WebP · up to 8 MB each<input type="file" accept="image/png,image/jpeg,image/webp" multiple @ref="ImageInput" @onchange="ReadImagesAsync" disabled="@(!ModuleReady)" /></label>
                <button @onclick="MatchImages" disabled="@(Project.Images.Count==0 || Project.Products.Count==0)">Match photos again</button>
            </div>
            <p class="small">Name photos after product codes, such as <code>ST-001.jpg</code>. Choose any unmatched photo in the product details.</p>
            @if (ImageErrors.Count > 0) { <ul class="import-errors">@foreach (var error in ImageErrors) { <li>@error</li> }</ul> }
        </details>

        @{
            var filtered = FilteredProducts();
            var rows = filtered.Skip(Page * PageSize).Take(PageSize).ToArray();
            var exportProject = ExportProject();
            var exportIssues = CatalogStudioWorkspace.Validate(exportProject);
            var exportIds = exportProject.Products.Where(product => product.Included).Select(product => product.Id).ToHashSet();
            var exportErrors = exportIssues.Count(issue => issue.IsError && (issue.ProductId is null || exportIds.Contains(issue.ProductId)));
        }
        <section class="panel">
            <h2>3. Check and edit products</h2>
            <div class="counts"><strong>@Project.Products.Count rows</strong><span>@Project.Products.Count(product => product.Included) included</span><span>@Issues.Count(issue => issue.IsError) errors</span><span>@Issues.Count(issue => !issue.IsError) image warnings</span><span>@Selected.Count selected</span></div>
            <div class="toolbar filters">
                <label>Search<input @bind="Search" @bind:event="oninput" @bind:after="ResetPage" placeholder="Product code, name or category" /></label>
                <label>Category<select @bind="Category" @bind:after="ResetPage"><option value="">All categories</option>@foreach (var category in Project.Products.Select(product => product.Category).Where(value => value.Length > 0).Distinct().Order()) { <option value="@category">@category</option> }</select></label>
                <label class="inline"><input type="checkbox" @bind="OnlyErrors" @bind:after="ResetPage" /> Rows with errors only</label>
                <label class="inline"><input type="checkbox" @bind="OnlyMissingImages" @bind:after="ResetPage" /> Missing photos only</label>
                <button @onclick="SelectFiltered" disabled="@(filtered.Count==0)">Select all matching rows</button><button @onclick="() => Selected.Clear()" disabled="@(Selected.Count==0)">Clear selection</button>
            </div>
            <details class="bulk">
                <summary>Edit selected products</summary>
                <div class="column-map">
                    <label class="inline"><input type="checkbox" @bind="UseCategory" /> Set category<input @bind="BulkCategory" maxlength="100" /></label>
                    <label class="inline"><input type="checkbox" @bind="UseStock" /> Set stock<input @bind="BulkStock" maxlength="12" placeholder="Blank means not specified" /></label>
                    <label class="inline"><input type="checkbox" @bind="UsePercent" /> Adjust prices by %<input @bind="BulkPercent" placeholder="-10 or 5.5" /></label>
                </div>
                <div class="toolbar"><button @onclick="ApplyBulk" disabled="@(Selected.Count==0 || !UseCategory && !UseStock && !UsePercent)">Apply selected changes</button><button @onclick="() => SetIncluded(true)" disabled="@(Selected.Count==0)">Include selected</button><button @onclick="() => SetIncluded(false)" disabled="@(Selected.Count==0)">Exclude selected</button></div>
                <p class="small">Use a dot in percentages. Prices round to two decimals. Excluded products stay in the project.</p>
            </details>
            <div class="table-scroll">
                <table class="products"><caption>@filtered.Count matching products · edit cells, then leave the field to validate</caption>
                    <thead><tr><th>Select</th><th>Export</th><th>Row</th><th>Product code</th><th>Name</th><th>Price</th><th>Category</th><th>Stock</th><th>Photo</th><th>Details</th></tr></thead>
                    <tbody>@foreach (var product in rows)
                    {
                        <tr id="@("catalog-row-"+product.Id)" tabindex="-1" @key="product.Id" class="@(Issues.Any(issue => issue.ProductId == product.Id && issue.IsError) ? "invalid-row" : "")">
                            <td><input type="checkbox" checked="@Selected.Contains(product.Id)" @onchange="eventArgs => ToggleSelection(product.Id, eventArgs)" aria-label="@($"Select row {product.SourceRow}")" /></td>
                            <td><input type="checkbox" @bind="product.Included" @bind:after="RefreshIssues" aria-label="@($"Include row {product.SourceRow} in export")" /></td>
                            <th>@product.SourceRow</th>
                            <td><input @bind="product.Sku" @bind:after="RefreshIssues" maxlength="80" aria-label="@($"SKU on row {product.SourceRow}")" /></td>
                            <td><input @bind="product.Name" @bind:after="RefreshIssues" maxlength="160" aria-label="@($"Name on row {product.SourceRow}")" /></td>
                            <td><input @bind="product.Price" @bind:after="RefreshIssues" maxlength="50" aria-label="@($"Price on row {product.SourceRow}")" /></td>
                            <td><input @bind="product.Category" @bind:after="RefreshIssues" maxlength="100" aria-label="@($"Category on row {product.SourceRow}")" /></td>
                            <td><input @bind="product.Stock" @bind:after="RefreshIssues" maxlength="12" aria-label="@($"Stock on row {product.SourceRow}")" /></td>
                            <td class="photo-cell">@if (ImageFor(product) is { Attached: true } image) { <img src="@image.DataUrl" alt="@product.Name" loading="lazy" /> } else { <span>No photo</span> }</td>
                            <td><button @onclick="() => OpenDetails(product.Id)">Edit details</button></td>
                        </tr>
                    }</tbody>
                </table>
            </div>
            <div class="toolbar"><button @onclick="PreviousPage" disabled="@(Page == 0)">Previous rows</button><span>Page @(Page + 1) / @Math.Max(1, (int)Math.Ceiling(filtered.Count / (double)PageSize))</span><button @onclick="NextPage" disabled="@((Page + 1) * PageSize >= filtered.Count)">Next rows</button></div>
            @if (Project.Products.FirstOrDefault(product => product.Id == DetailId) is { } detail)
            {
                <section class="detail-editor">
                    <h3>Details · @detail.Sku · row @detail.SourceRow</h3>
                    <label>Description<textarea id="catalog-detail-description" @bind="detail.Description" @bind:after="RefreshIssues" maxlength="4000" rows="4"></textarea></label>
                    <label>Photo filename<input @bind="detail.ImageHint" @bind:after="RefreshIssues" maxlength="200" /></label>
                    <label>Photo<select value="@detail.ImageId" @onchange="args => SetImage(detail, args.Value?.ToString())"><option value="">No image</option>@foreach (var image in Project.Images) { <option value="@image.Id">@image.Name · @(image.Attached ? "attached" : "reattach photo")</option> }</select></label>
                    <button @onclick="() => DetailId = null">Close details</button>
                </section>
            }
        </section>

        @if(Issues.Count>0){<section class="panel issues">
            <h2>Fix products</h2>
            @if (Issues.Count == 0) { <p>No validation issues.</p> }
            else
            {
                <p>Showing the first @Math.Min(100, Issues.Count) of @Issues.Count issues. Download the complete report if there are more.</p>
                <table><thead><tr><th>Row</th><th>Field</th><th>Level</th><th>Issue</th><th>Repair</th></tr></thead><tbody>@foreach (var issue in Issues.Take(100)) { <tr><td>@(issue.Row == 0 ? "Workspace" : issue.Row)</td><td>@issue.Field</td><td>@(issue.IsError ? "Error" : "Warning")</td><td>@issue.Message</td><td>@if (issue.ProductId is not null) { <button @onclick="() => OpenIssue(issue.ProductId)">Find row</button> }</td></tr> }</tbody></table>
                <button @onclick="DownloadIssuesAsync" disabled="@(!ModuleReady)">Download complete issue report</button>
            }
        </section>}

        <section class="panel">
            <h2>4. Save or export</h2>
            @if(exportErrors > 0){<p><strong>@exportErrors issues to fix before exporting.</strong></p>}else if(exportIds.Count == 0){<p>Include products to export.</p>}
            <label class="inline"><input type="checkbox" @bind="ExportMatchingOnly" /> Export only matching rows</label>
            <div class="toolbar">
                <button @onclick="DownloadHtmlAsync" disabled="@(!ModuleReady || exportErrors > 0 || exportIds.Count == 0)">Download catalog page (.html)</button>
                <button @onclick="PrintAsync" disabled="@(!ModuleReady || exportErrors > 0 || exportIds.Count == 0)">Open printable catalog</button>
                <button @onclick="SaveProjectAsync" disabled="@(!ModuleReady)">Save project file</button>
                <label>Open project file · up to 45 MB<input type="file" accept=".json,application/json" @ref="ProjectInput" @onchange="RestoreProjectAsync" disabled="@(!ModuleReady)" /></label>
                @if(UndoJson is not null){<button @onclick="Undo" title="Restores the whole catalog to before that action.">@UndoLabel</button>}
                <button @onclick="LoadDemo">Open sample catalog</button>
            </div>

            <p class="small">Save a project file to keep the list and photos for later editing.</p>
            <div class="catalog-preview">@foreach (var product in exportProject.Products.Where(product => product.Included).Take(4)) { <article>@if (ImageFor(product) is { Attached: true } image) { <img src="@image.DataUrl" alt="@product.Name" /> }<p class="small">@product.Sku</p><h3>@product.Name</h3><p>@CatalogStudioWorkspace.PriceLabel(product, Project)</p></article> }</div>
        </section>
        <details class="panel cloud">
            <summary>Save online or work with others</summary>
            <p>Online copies save product details and photo filenames. Keep a project file to carry the photos. Everyone invited can read all product text and filenames.</p>
            <label>Saved copy name<input @bind="CloudLabel" maxlength="100" /></label>

            <div class="toolbar"><button @onclick="LoadCloudListAsync">Show saved catalogs</button><button @onclick="CreateCloudAsync">Save a new online copy</button></div>
            @if (CloudNeedsAccount) { <p><a href="/uyelik/">Sign in or create an account</a>, then return to your saved catalogs.</p> }
            @if (CloudDirectory is not null)
            {
                <p>Saved projects: @CloudDirectory.Account.UsedProjects / @CloudDirectory.Account.ProjectLimit</p>
                <div class="toolbar"><label>Saved catalog<select @bind="CloudSelection"><option value="">Choose a saved catalog</option>@foreach (var item in CloudDirectory.Workspaces.Where(item => item.Kind == "catalog")) { <option value="@item.Id">@item.Title · @item.Role</option> }</select></label><button @onclick="OpenCloudAsync" disabled="@(CloudSelection.Length == 0)">Open catalog</button></div>
            }
            @if (CloudWorkspace is not null)
            {
                <p><strong>@CloudWorkspace.Title</strong> · @CloudWorkspace.Role</p>
                <button @onclick="SaveCloudAsync" disabled="@(CloudWorkspace.Role is not ("owner" or "editor"))">Save changes online</button>
                @if (CloudWorkspace.Role == "viewer") { <p class="small">You can edit this local copy. Save a new online copy to keep your changes.</p> }
                @if (CloudWorkspace.Role == "owner")
                {
                    <div class="toolbar"><label>Invite role<select @bind="InviteRole"><option value="viewer">Viewer</option><option value="editor">Editor</option></select></label><button @onclick="CreateInviteAsync">Create invitation code</button></div>
                    @if (InviteToken.Length > 0) { <label>Invitation code<input readonly value="@InviteToken" /></label><p class="small">Expires @(DateTimeOffset.FromUnixTimeMilliseconds(InviteExpires).ToString("u", CultureInfo.InvariantCulture)). Send this code to the person you want to invite.</p> }
                }
            }
            <div class="toolbar"><label>Invitation code<input @bind="JoinToken" maxlength="300" autocomplete="off" /></label><button @onclick="JoinCloudAsync" disabled="@(JoinToken.Trim().Length==0)">Join catalog</button></div>
            <p class="small">Opening a saved copy replaces the list. Keep a project file if you want to preserve your current list and photos.</p>
        </details>
    </fieldset>
</div>

</PageSurface>
@code {
    const bool IsLogEnabled = true;
    const int PageSize = 25;
    CatalogStudioProject Project = CatalogStudioSamples.Create();
    List<CatalogStudioIssue> Issues = [];
    readonly HashSet<string> Selected = new(StringComparer.Ordinal);
    List<string> ImageErrors = [];
    IJSObjectReference? Module;
    ElementReference CsvInput, ImageInput, ProjectInput;
    CatalogStudioCsvTable? CsvTable;
    CatalogStudioColumnMap Mapping = new();
    string CsvText = "", ParsedCsv = "", ParsedDelimiter = "", CsvSourceName = "pasted text", Delimiter = "auto";
    string Search = "", Category = "", BulkCategory = "", BulkStock = "", BulkPercent = "";
    string Status = "Example catalog. Import your product list to replace it.";
    string? DetailId, UndoJson, FocusTarget;
    string UndoLabel = "Undo change";
    bool Busy, HasError, ModuleReady, OnlyErrors, OnlyMissingImages, UseCategory, UseStock, UsePercent, ExportMatchingOnly;
    int Page;
    CatalogStudioCloudClient? CloudClient;
    CatalogStudioCloudDirectory? CloudDirectory;
    CatalogStudioCloudWorkspace? CloudWorkspace;
    string CloudSelection = "", InviteRole = "viewer", InviteToken = "", JoinToken = "";
    string CloudLabel = "My catalog";
    bool CloudNeedsAccount;
    long InviteExpires;

    /// <summary>Validates the bundled local project before its first render.</summary>
    protected override void OnInitialized() { RefreshIssues(); CloudClient = new(Api); }

    /// <summary>Loads the product's own file bridge; no account or network data API is contacted.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(FocusTarget is not null){var target=FocusTarget;FocusTarget=null;await Javascript.InvokeVoidAsync("binSiteSocial.focusField",target);}
        if (!firstRender) return;
        await ExecuteAsync(async () => { Module = await Javascript.InvokeAsync<IJSObjectReference>("import", "/catalog-studio.js"); ModuleReady = true; });
        StateHasChanged();
    }

    /// <summary>Renders source-column choices without exposing header text as markup.</summary>
    RenderFragment ColumnOptions() => builder =>
    {
        builder.OpenElement(0, "option"); builder.AddAttribute(1, "value", -1); builder.AddContent(2, "Not mapped"); builder.CloseElement();
        if (CsvTable is null) return;
        for (var index = 0; index < CsvTable.Headers.Count; index++)
        {
            builder.OpenElement(3, "option"); builder.AddAttribute(4, "value", index); builder.AddContent(5, $"{index + 1}. {CsvTable.Headers[index]}"); builder.CloseElement();
        }
    };

    /// <summary>Returns repairable issues and bounds the visible row page after mutations.</summary>
    void RefreshIssues() { Issues = CatalogStudioWorkspace.Validate(Project); Page = Math.Min(Page, Math.Max(0, (FilteredProducts().Count - 1) / PageSize)); }

    /// <summary>Normalizes only the catalog's currency label, never converting product amounts.</summary>
    void NormalizeCurrency() { Project.Currency = Project.Currency.Trim().ToUpperInvariant(); RefreshIssues(); }

    /// <summary>Filters products without changing their included/export state.</summary>
    List<CatalogStudioProduct> FilteredProducts()
    {
        var terms = Search.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        var errors = Issues.Where(issue => issue.IsError && issue.ProductId is not null).Select(issue => issue.ProductId).ToHashSet();
        return Project.Products.Where(product => (Category.Length == 0 || product.Category.Equals(Category, StringComparison.OrdinalIgnoreCase))
            && (!OnlyErrors || errors.Contains(product.Id)) && (!OnlyMissingImages || ImageFor(product) is not { Attached: true })
            && terms.All(term => string.Join(' ', product.Sku, product.Name, product.Description, product.Category).Contains(term, StringComparison.OrdinalIgnoreCase))).ToList();
    }

    /// <summary>Builds a read-only export view so current filters do not silently delete project rows.</summary>
    CatalogStudioProject ExportProject() => new()
    {
        Title = Project.Title, Description = Project.Description, Currency = Project.Currency, DecimalSeparator = Project.DecimalSeparator,
        Products = ExportMatchingOnly ? FilteredProducts() : Project.Products, Images = Project.Images
    };

    /// <summary>Finds a local photo or metadata-only reference for one product.</summary>
    CatalogStudioImage? ImageFor(CatalogStudioProduct product) => Project.Images.FirstOrDefault(image => image.Id == product.ImageId);

    /// <summary>Resets pagination after the user changes a filter.</summary>
    void ResetPage() => Page = 0;
    /// <summary>Shows the preceding bounded page of editable rows.</summary>
    void PreviousPage() => Page = Math.Max(0, Page - 1);
    /// <summary>Shows the following bounded page of editable rows.</summary>
    void NextPage() => Page = Math.Min(Page + 1, Math.Max(0, (FilteredProducts().Count - 1) / PageSize));

    /// <summary>Records an explicit row-selection checkbox change.</summary>
    void ToggleSelection(string id, ChangeEventArgs args) { if (args.Value is true) Selected.Add(id); else Selected.Remove(id); }
    /// <summary>Selects the full filtered set, including rows outside the visible page.</summary>
    void SelectFiltered() { foreach (var product in FilteredProducts()) Selected.Add(product.Id); }

    /// <summary>Applies a manual image association without reading another local file.</summary>
    void SetImage(CatalogStudioProduct product, string? id) { product.ImageId = string.IsNullOrEmpty(id) ? null : id; RefreshIssues(); }

    /// <summary>Brings an issue's product into view and opens its extended fields.</summary>
    void OpenDetails(string id){DetailId=id;FocusTarget="catalog-detail-description";}
    void OpenIssue(string id)
    {
        Search = Category = ""; OnlyErrors = OnlyMissingImages = false;
        var index = Project.Products.FindIndex(product => product.Id == id); Page = Math.Max(0, index / PageSize); DetailId = id; FocusTarget="catalog-row-"+id;
    }

    /// <summary>Stages a locally selected CSV without replacing any active product rows.</summary>
    Task ReadCsvAsync() => ExecuteAsync(async () =>
    {
        var file = await Bridge().InvokeAsync<CatalogStudioTextFile?>("readText", CsvInput, 5_000_000);
        if (file is null) return;
        CsvText = file.Text; CsvSourceName = file.Name; AnalyzeCsvCore();
    });

    /// <summary>Analyzes pasted text and initializes revisable header mapping.</summary>
    Task AnalyzeCsv() => ExecuteAsync(() => { AnalyzeCsvCore(); return Task.CompletedTask; });
    /// <summary>Builds the source table and preserves structural errors for the import preview.</summary>
    void AnalyzeCsvCore()
    {
        char? delimiter = Delimiter == "auto" ? null : Delimiter == "tab" ? '\t' : Delimiter[0];
        CsvTable = CatalogStudioCsv.Parse(CsvText, delimiter); Mapping = CatalogStudioCsv.SuggestMapping(CsvTable.Headers); ParsedCsv = CsvText; ParsedDelimiter = Delimiter;
        Status = $"Read {CsvTable.Rows.Count} products from the file.";
    }

    /// <summary>Stages the editorial sheet so the user can inspect its real header mapping and quoting.</summary>
    void StageExampleCsv() { CsvText = CatalogStudioSamples.Csv(); CsvSourceName = "original-demo-products.csv"; Delimiter = "auto"; AnalyzeCsvCore(); }

    /// <summary>Imports mapped rows atomically while retaining the current local image bank.</summary>
    Task ImportCsv() => ExecuteAsync(() =>
    {
        if (CsvTable is null || ParsedCsv != CsvText || ParsedDelimiter != Delimiter) throw new FormatException("Select Read this list after changing the text or column separator.");
        var products = CatalogStudioCsv.Import(CsvTable, Mapping);
        var snapshot = CatalogStudioWorkspace.Serialize(Project);
        Project.Products = products; CatalogStudioWorkspace.MatchImages(Project); UndoJson = snapshot; UndoLabel="Undo import"; Selected.Clear(); DetailId = null; Page = 0; RefreshIssues();
        Status = $"Imported {products.Count} products.";
        return Task.CompletedTask;
    });

    /// <summary>Reads resized local photos, rebinds references and reports per-file failures without uploading data.</summary>
    Task ReadImagesAsync() => ExecuteAsync(async () =>
    {
        var batch = await Bridge().InvokeAsync<CatalogStudioImageBatch>("readImages", ImageInput);
        var snapshot = CatalogStudioWorkspace.Serialize(Project);
        var matched = CatalogStudioWorkspace.AttachImages(Project, batch.Images); UndoJson = snapshot; UndoLabel="Undo photo changes"; ImageErrors = batch.Errors; RefreshIssues();
        Status = $"{batch.Images.Count} local images processed; {matched} additional rows matched; {batch.Errors.Count} files need attention.";
    });

    /// <summary>Retries deterministic filename associations after the user repairs SKUs or image hints.</summary>
    void MatchImages() { var count = CatalogStudioWorkspace.MatchImages(Project); RefreshIssues(); Status = $"Matched {count} additional products."; }

    /// <summary>Applies all requested bulk fields only after every proposed value has passed validation.</summary>
    Task ApplyBulk() => ExecuteAsync(() =>
    {
        if (!UseCategory && !UseStock && !UsePercent) throw new FormatException("Choose at least one bulk field to change.");
        decimal? percent = null;
        if (UsePercent)
        {
            if (!decimal.TryParse(BulkPercent, NumberStyles.AllowLeadingSign | NumberStyles.AllowDecimalPoint, CultureInfo.InvariantCulture, out var value))
                throw new FormatException("Enter a percentage such as -10 or 5.5 using a dot decimal.");
            percent = value;
        }
        var snapshot = CatalogStudioWorkspace.Serialize(Project);
        var count = CatalogStudioWorkspace.BulkEdit(Project, Selected, UseCategory ? BulkCategory : null, UseStock ? BulkStock : null, percent);
        UndoJson = snapshot; UndoLabel="Undo bulk edit"; RefreshIssues(); Status = $"Updated {count} selected products."; return Task.CompletedTask;
    });

    /// <summary>Includes or excludes selected rows without discarding their source data.</summary>
    void SetIncluded(bool included)
    {
        if (Selected.Count == 0) { Status = "Select at least one row."; return; }
        UndoJson = CatalogStudioWorkspace.Serialize(Project); UndoLabel="Undo export selection";
        foreach (var product in Project.Products.Where(product => Selected.Contains(product.Id))) product.Included = included;
        RefreshIssues(); Status = included ? "Selected rows are included." : "Selected rows are excluded from exports.";
    }

    /// <summary>Downloads the validated standalone catalog with its attached photos and actual browser search.</summary>
    Task DownloadHtmlAsync() => ExecuteAsync(async () =>
    {
        var html = CatalogStudioExporter.Html(ExportProject()); await Bridge().InvokeVoidAsync("download", "product-catalog.html", html, "text/html;charset=utf-8");
        Status = "Catalog download started.";
    });

    /// <summary>Opens the same printable catalog, falling back to a downloaded print document if popups are blocked.</summary>
    Task PrintAsync() => ExecuteAsync(async () =>
    {
        var html = CatalogStudioExporter.Html(ExportProject()); var opened = await Bridge().InvokeAsync<bool>("printPreview", html);
        Status = opened ? "Print preview opened. Select Print results in that window." : "The popup was blocked. A printable catalog file was downloaded instead.";
    });

    /// <summary>Saves all rows, settings and attached local image copies into an explicit portable download.</summary>
    Task SaveProjectAsync() => ExecuteAsync(async () =>
    {
        await Bridge().InvokeVoidAsync("download", "catalog-studio-project.json", CatalogStudioWorkspace.Serialize(Project), "application/json");
        Status = "Project download started.";
    });

    /// <summary>Restores a bounded validated project only after the complete file is accepted.</summary>
    Task RestoreProjectAsync() => ExecuteAsync(async () =>
    {
        var file = await Bridge().InvokeAsync<CatalogStudioTextFile?>("readText", ProjectInput, 45_000_000);
        if (file is null) return;
        var restored = CatalogStudioWorkspace.Deserialize(file.Text); UndoJson = CatalogStudioWorkspace.Serialize(Project); UndoLabel="Undo opening project"; Project = restored;
        Selected.Clear(); Search = Category = ""; OnlyErrors = OnlyMissingImages = false; DetailId = null; Page = 0; DetachCloud(); RefreshIssues(); Status = "Project opened.";
    });

    /// <summary>Downloads all current validation records, not only the first hundred shown in the page.</summary>
    Task DownloadIssuesAsync() => ExecuteAsync(async () => await Bridge().InvokeVoidAsync("download", "catalog-issues.json", System.Text.Json.JsonSerializer.Serialize(Issues, CatalogStudioWorkspace.JsonOptions), "application/json"));
    /// <summary>Downloads the original twenty-product CSV as a real import example.</summary>
    Task DownloadSampleCsvAsync() => ExecuteAsync(async () => await Bridge().InvokeVoidAsync("download", "original-demo-products.csv", CatalogStudioSamples.Csv(), "text/csv;charset=utf-8"));

    /// <summary>Restores the snapshot preceding the most recent import, bulk change or demo reset.</summary>
    void Undo()
    {
        if (UndoJson is null) return;
        Project = CatalogStudioWorkspace.Deserialize(UndoJson); UndoJson = null; Selected.Clear(); DetailId = null; Search = Category = ""; Page = 0; DetachCloud(); RefreshIssues(); Status = "Previous catalog restored.";
    }

    /// <summary>Loads the authored demonstration while retaining one reversible snapshot.</summary>
    void LoadDemo()
    {
        UndoJson = CatalogStudioWorkspace.Serialize(Project); UndoLabel="Undo example reset"; Project = CatalogStudioSamples.Create(); Selected.Clear(); Search = Category = ""; Page = 0; DetailId = null; DetachCloud(); RefreshIssues();
        Status = "Example catalog loaded.";
    }

    /// <summary>Loads real account workspace headers only after the user requests optional cloud access.</summary>
    Task LoadCloudListAsync() => ExecuteAsync(async () =>
    {
        CloudDirectory = await CloudBridge().ListAsync(); CloudNeedsAccount = false;
        Status = "Saved catalogs loaded.";
    });

    /// <summary>Creates a real metadata-only server project without transferring local image bytes.</summary>
    Task CreateCloudAsync() => ExecuteAsync(async () =>
    {
        CloudWorkspace = await CloudBridge().CreateAsync(Project, CloudLabel); CloudSelection = CloudWorkspace.Id; CloudLabel = CloudWorkspace.Title; CloudDirectory = null; CloudNeedsAccount = false; InviteToken = "";
        Status = "Catalog saved online. Keep a project file to transfer the photos.";
    });

    /// <summary>Opens selected authorized metadata and rebinds device-local photos by fingerprint.</summary>
    Task OpenCloudAsync() => ExecuteAsync(async () => await OpenCloudCoreAsync(CloudSelection));

    /// <summary>Replaces local product state only after the remote body validates successfully.</summary>
    async Task OpenCloudCoreAsync(string id)
    {
        var workspace = await CloudBridge().OpenAsync(id); var restored = CatalogStudioCloudClient.Rebind(workspace.Body, Project);
        UndoJson = CatalogStudioWorkspace.Serialize(Project); UndoLabel="Undo opening project"; Project = restored; CloudWorkspace = workspace; CloudSelection = workspace.Id; CloudLabel = workspace.Title;
        Selected.Clear(); Search = Category = ""; Page = 0; DetailId = null; InviteToken = ""; CloudNeedsAccount = false; RefreshIssues();
        Status = "Catalog opened. Reattach any missing photos or open a project file that includes them.";
    }

    /// <summary>Saves one known revision without retrying a mutation or overwriting a conflict.</summary>
    Task SaveCloudAsync() => ExecuteAsync(async () =>
    {
        if (CloudWorkspace is null) throw new FormatException("Open or save a catalog first.");
        CloudWorkspace = await CloudBridge().SaveAsync(CloudWorkspace, Project, CloudLabel); CloudLabel = CloudWorkspace.Title; CloudNeedsAccount = false;
        Status = "Product details saved online.";
    });

    /// <summary>Creates an owner-authorized token and leaves all actual sharing to the user.</summary>
    Task CreateInviteAsync() => ExecuteAsync(async () =>
    {
        if (CloudWorkspace is null) throw new FormatException("Open a catalog you own first.");
        var invitation = await CloudBridge().InviteAsync(CloudWorkspace, InviteRole); InviteToken = invitation.Token; InviteExpires = invitation.ExpiresAt;
        Status = "Invitation code ready. Send it to your viewer or editor.";
    });

    /// <summary>Accepts a real invitation, then opens the resulting metadata using current server permissions.</summary>
    Task JoinCloudAsync() => ExecuteAsync(async () =>
    {
        var joined = await CloudBridge().JoinAsync(JoinToken); JoinToken = ""; await OpenCloudCoreAsync(joined.WorkspaceId);
    });

    /// <summary>Returns this page's typed adapter over the existing same-origin API client.</summary>
    CatalogStudioCloudClient CloudBridge() => CloudClient ?? throw new InvalidOperationException("Cloud tools are still initializing.");

    /// <summary>Stops a restored or demo local project from silently remaining bound to a previous server workspace.</summary>
    void DetachCloud() { CloudWorkspace = null; CloudSelection = ""; InviteToken = ""; CloudLabel = "My catalog"; }

    /// <summary>Requires the loaded file bridge and returns a useful browser-action failure instead of a null reference.</summary>
    IJSObjectReference Bridge() => Module ?? throw new InvalidOperationException("File controls are still loading. Refresh if they remain unavailable.");

    /// <summary>Contains each whole local action and logs only action metadata, never CSV, photos or product contents.</summary>
    async Task ExecuteAsync(Func<Task> operation)
    {
        if (Busy) return; Busy = true; HasError = false;
        try
        {
            await operation();
            if (IsLogEnabled) Logger.LogInformation("Catalog local action completed; products={Products}; images={Images}", Project.Products.Count, Project.Images.Count);
        }
        catch (ApiFailure error)
        {
            HasError = true; CloudNeedsAccount = error.Status == System.Net.HttpStatusCode.Unauthorized;
            Status = CloudNeedsAccount ? "Sign in to save a catalog online. Your current catalog is still here." : error.Message;
        }
        catch (Exception error)
        {
            HasError = true;
            Status = error is FormatException or ArgumentException or InvalidOperationException ? error.Message : "The browser could not complete that file operation. Your current data is retained; you can retry or download a project.";
            if (IsLogEnabled) Logger.LogError("Catalog action failed; errorType={ErrorType}; products={Products}", error.GetType().Name, Project.Products.Count);
        }
        finally { Busy = false; }
    }

    /// <summary>Releases only this page's imported module; user files are never deleted.</summary>
    public async ValueTask DisposeAsync()
    {
        if (Module is not null)
            try { await Module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
            catch (JSException error) { if (IsLogEnabled) Logger.LogWarning("Catalog module disposal failed; errorType={ErrorType}", error.GetType().Name); }
        GC.SuppressFinalize(this);
    }
}
