@page "/zaman-pazari/"
@inherits CommunityComponent
<PageTitle>@T("Zaman Pazarı — Beceri paylaş, zaman ayır", "Time Market — Share a skill, make time")</PageTitle>
<div class="market-page"><header><div class="masthead"><span class="eyebrow">@T("PARA YERİNE KARŞILIKLI ZAMAN", "MUTUAL TIME INSTEAD OF MONEY")</span><LanguageSwitch /></div><h1>@T("Zaman Pazarı", "Time Market")</h1><p>@T("Bir şeyi öğretebilirsin. Bir şeyi öğrenmek istiyorsun. Süresi belli bir teklif bırak, site içinden konuş, iki taraf da kabul ettiğinde takası başlat.", "You can teach something and want to learn something. Publish a time-bounded offer, discuss it on the site, and start when both sides agree.")</p><div class="toolbar"><button @onclick="()=>Creating=true">@T("Teklif / istek oluştur", "Create an offer / request")</button><button class="quiet" disabled="@Busy" @onclick="RefreshAsync">@T("İlanları ve konuşmaları yenile", "Refresh listings and conversations")</button></div></header>
@if(Status.Length>0){<p class="status" role="status">@Status</p>}
<main>
@if(Creating){<section class="composer"><h2>@T("Ne paylaşmak veya öğrenmek istiyorsun?", "What would you like to share or learn?")</h2><form @onsubmit="CreateAsync" @onsubmit:preventDefault><div class="fields"><div><label for="exchange-kind">@T("İlan türü", "Listing type")</label><select id="exchange-kind" @bind="Kind"><option value="offer">@T("Öğretebilirim / paylaşabilirim", "I can teach / share")</option><option value="request">@T("Öğrenmek / yardım almak istiyorum", "I want to learn / get help")</option></select></div><div><label for="exchange-minutes">@T("Bir oturumun süresi", "One session length")</label><select id="exchange-minutes" @bind="Minutes">@foreach(var duration in Durations){<option value="@duration">@duration @T("dakika", "minutes")</option>}</select></div></div><label for="exchange-title">@T("Somut bir başlık", "A concrete title")</label><input id="exchange-title" @bind="Title" required minlength="6" maxlength="120"><label for="exchange-skill">@T("Beceri", "Skill")</label><input id="exchange-skill" @bind="Skill" required minlength="3" maxlength="80"><label for="exchange-description">@T("Ne yapılacak, karşılığında ne istersin?", "What will you do, and what would you like in return?")</label><textarea id="exchange-description" @bind="Description" required minlength="30" maxlength="1400"></textarea><p class="small">@T("Yalnız gerçek becerini veya ihtiyacını yaz. E-posta, telefon, adres, ödeme veya hassas bilgi paylaşma; site içi konuşmayı kullan. İlanın herkese açık olur.", "Describe only your actual skill or need. Do not share email, phone, addresses, payments or sensitive data; use on-site conversation. The listing will be public.")</p><div class="toolbar"><button type="submit" disabled="@Busy">@T("İlanı yayımla", "Publish listing")</button><button class="quiet" type="button" @onclick="()=>Creating=false">@T("Vazgeç", "Cancel")</button></div></form></section>}
<div class="market-layout"><section><div class="filter-row"><h2>@T("Beceri panosu", "Skill board")</h2><select aria-label="@T("İlan filtresi", "Listing filter")" @bind="Filter"><option value="all">@T("Açık ilanların hepsi", "All open listings")</option><option value="offer">@T("Paylaşım teklifleri", "Offers to share")</option><option value="request">@T("Öğrenme istekleri", "Learning requests")</option><option value="mine">@T("Kendi ilanlarım", "My listings")</option></select></div><div class="listing-grid">@foreach(var item in VisibleListings()){<article class="listing"><div class="chips"><span>@(item.Kind=="offer"?T("PAYLAŞIYOR", "OFFER"):T("ARIYOR", "REQUEST"))</span><span>@item.Minutes @T("dk", "min")</span><span>@StateLabel(item.Status)</span></div><h3>@item.Title</h3><strong>@item.Skill</strong><p>@item.Description</p>@if(item.Mine==1){<p class="small">@T("Bu ilan bu tarayıcı kimliğine ait.", "This listing belongs to this browser identity.")</p>@if(item.Status=="open"){<button class="quiet" disabled="@Busy" @onclick="()=>CloseAsync(item.Id)">@T("Yeni tekliflere kapat", "Close to new proposals")</button>}}else if(item.Status=="open"){<button @onclick="()=>Proposing=item">@T("Site içinden yanıt ver", "Reply on the site")</button>}<ReportBox Kind="exchange" TargetId="@item.Id" Endpoint="community/reports" /></article>}</div>@if(!VisibleListings().Any()){<p class="empty">@T("Bu filtrede ilan yok. Bir teklif veya öğrenme isteği yayımlayabilirsin.", "No listings match this filter. Publish an offer or learning request.")</p>}</section>
<aside class="inbox"><h2>@T("Konuşmalarım", "My conversations")</h2><p class="small">@T("Yalnız bu tarayıcı kimliğinin taraf olduğu konuşmalar görünür. Çerezi silersen erişimini kaybedersin; hesap kurtarma yok.", "Only conversations involving this browser identity are visible. Clearing the cookie loses access; there is no account recovery.")</p>@foreach(var thread in Threads){<button class="thread-link" disabled="@Busy" @onclick="()=>OpenThreadAsync(thread.Id)"><strong>@thread.Title</strong><span>@StateLabel(thread.Status) · @(thread.IsOwner==1?T("İlan sahibi", "Listing owner"):T("Yanıt veren", "Respondent"))</span></button>}
@if(Current is not null){<section class="conversation"><h3>@Current.Thread.Title</h3><p class="small">@Current.Thread.Minutes @T("dakika", "minutes") · @StateLabel(Current.Thread.Status)</p><div class="message-list">@foreach(var message in Current.Messages){<article class="@(message.Mine==1?"message mine":"message")"><span>@(message.Mine==1?T("Sen", "You"):T("Karşı taraf", "Other participant")) · @DateLabel(message.CreatedAt)</span><p>@message.Body</p></article>}</div>
@if(Current.Thread.Status=="proposed"){<div class="toolbar">@if(Current.Thread.IsOwner==1){<button disabled="@Busy" @onclick='()=>DecisionAsync("accept")'>@T("Bu teklifi kabul et", "Accept this proposal")</button><button class="quiet" disabled="@Busy" @onclick='()=>DecisionAsync("decline")'>@T("Reddet", "Decline")</button>}else{<button class="quiet" disabled="@Busy" @onclick='()=>DecisionAsync("withdraw")'>@T("Teklifimi geri çek", "Withdraw proposal")</button>}</div>}
@if(Current.Thread.Status is "proposed" or "accepted"){<form @onsubmit="SendAsync" @onsubmit:preventDefault><label for="private-message">@T("Site içi özel mesaj", "Private on-site message")</label><textarea id="private-message" @bind="Reply" required minlength="2" maxlength="1200"></textarea><button type="submit" disabled="@Busy">@T("Mesajı gönder", "Send message")</button></form>}
@if(Current.Thread.Status=="accepted"){<p class="small">@T("Takas tamamlandığında iki taraf da ayrı ayrı onay verir. Tek kişinin onayı tamamlandı durumuna geçirmez.", "Both participants independently confirm completion. One confirmation alone does not complete the exchange.")</p><p>@T("İlan sahibi:", "Listing owner:") @(Current.Thread.OwnerDone==1?"✓":"—") · @T("Yanıt veren:", "Respondent:") @(Current.Thread.RequesterDone==1?"✓":"—")</p><button disabled="@(Busy||(Current.Thread.IsOwner==1?Current.Thread.OwnerDone==1:Current.Thread.RequesterDone==1))" @onclick="CompleteAsync">@T("Kendi tarafımda tamamlandı", "Completed on my side")</button>}
</section>}</aside></div>
@if(Proposing is not null){<section class="proposal composer"><h2>@T("Yanıt verdiğin ilan:", "Responding to:") @Proposing.Title</h2><form @onsubmit="ProposeAsync" @onsubmit:preventDefault><label for="proposal-message">@T("Ne paylaşabilirsin, hangi beklentiyle başlamak istersin?", "What can you share, and what would you like to agree on first?")</label><textarea id="proposal-message" @bind="Proposal" required minlength="20" maxlength="1000"></textarea><p class="small">@T("Bu mesaj yalnız sen ve ilan sahibi arasında saklanır. İletişim veya ödeme bilgisi isteme; site içinden konuş.", "This message is stored for you and the listing owner only. Do not request contact or payment data; discuss on the site.")</p><div class="toolbar"><button disabled="@Busy" type="submit">@T("Yanıtı gönder", "Send proposal")</button><button class="quiet" type="button" @onclick="()=>Proposing=null">@T("Vazgeç", "Cancel")</button></div></form></section>}
<details class="editorial"><summary>@T("16 beceri takası alıştırması", "16 skill-exchange exercises")</summary><p class="small">@T("Bunlar editoryal fikirlerdir, gerçek ilan veya yeterlilik iddiası değildir. Birini seçmek yalnız beceri alanını doldurur; kendi yetkinliğini ve beklentini sen yazarsın.", "These are editorial ideas, not actual listings or claims of expertise. Selecting one only fills the skill field; describe your actual ability and expectations yourself.")</p><div class="exercise-grid">@foreach(var pair in SkillIdeas()){<button class="exercise" @onclick="()=>ChooseSkill(pair.Skill)"><strong>@pair.Skill</strong><span>@pair.Task</span></button>}</div></details>
</main><footer>@T("İlanlar herkese açıktır; konuşmalar yalnız tarafların çerez kimliklerine sunucuda açılır. İçerik Cloudflare veritabanında tutulur ve işletmeci tarafından erişilebilir; uçtan uca şifreleme yoktur. Platform para, ödeme, meslek yeterliliği veya kimlik doğrulaması yönetmez. Kişisel bilgi, taciz, nefret, izinsiz eser ve spam paylaşma. Üç farklı ağ raporu ilanı gizler; otomatik hız ve rapor sınırları uygulanır. İnsan incelemesi sunulmaz.", "Listings are public; the server restricts conversations to the participants' cookie identities. Content is stored in a Cloudflare database and accessible to its operator; there is no end-to-end encryption. The platform does not manage money, payments, professional credentials or person verification. No personal information, harassment, hate, unauthorized works or spam. Three distinct-network reports hide a listing; automated rate and report limits apply. No human review service is provided.")</footer></div>
@code{
 List<ExchangeInfo> Listings=[];List<ThreadSummary> Threads=[];ThreadDetail? Current;ExchangeInfo? Proposing;bool Creating;string Kind="offer",Title="",Skill="",Description="",Filter="all",Proposal="",Reply="";int Minutes=45;static readonly int[] Durations=[15,30,45,60,90,120,180,240];
 /// <summary>Loads public listings and only this anonymous identity's private conversation headers.</summary>
 protected override Task OnInitializedAsync()=>RefreshAsync();
 /// <summary>Refreshes both public and identity-filtered lists.</summary>
 Task RefreshAsync()=>ExecuteAsync(LoadListsAsync);
 /// <summary>Retrieves real listings and conversation headers sequentially with the same browser cookie.</summary>
 async Task LoadListsAsync(){Listings=(await ReadAsync<ExchangeList>("exchanges")).Exchanges;Threads=(await ReadAsync<ThreadList>("my-threads")).Threads;}
 /// <summary>Returns listings matching the current actual-state filter.</summary>
 IEnumerable<ExchangeInfo> VisibleListings()=>Listings.Where(item=>Filter=="mine"?item.Mine==1:item.Status=="open"&&(Filter=="all"||item.Kind==Filter));
 /// <summary>Publishes an actual skill offer or request without requesting personal contact fields.</summary>
 Task CreateAsync()=>ExecuteAsync(async()=>{await WriteAsync<CreatedResponse>("exchanges",new{kind=Kind,title=Title,skill=Skill,description=Description,minutes=Minutes});Title=Skill=Description="";Creating=false;await LoadListsAsync();},T("İlanın yayımlandı.","Your listing was published."));
 /// <summary>Starts one private proposal thread as the responding browser identity.</summary>
 Task ProposeAsync()=>ExecuteAsync(async()=>{if(Proposing is null)return;var created=await WriteAsync<CreatedResponse>($"exchanges/{Proposing.Id}/proposals",new{message=Proposal});Current=await ReadAsync<ThreadDetail>("threads/"+created.Id);Proposing=null;Proposal="";await LoadListsAsync();},T("Yanıtın özel konuşmaya kaydedildi.","Your proposal was saved to a private conversation."));
 /// <summary>Opens a conversation only after server-side participant authorization.</summary>
 Task OpenThreadAsync(string id)=>ExecuteAsync(async()=>{Current=await ReadAsync<ThreadDetail>("threads/"+id);Reply="";});
 /// <summary>Submits a participant-authorized acceptance, rejection or withdrawal transition.</summary>
 Task DecisionAsync(string decision)=>ExecuteAsync(async()=>{if(Current is null)return;Current=await WriteAsync<ThreadDetail>($"threads/{Current.Thread.Id}/decision",new{decision});await LoadListsAsync();});
 /// <summary>Records one private message without automatic write retries.</summary>
 Task SendAsync()=>ExecuteAsync(async()=>{if(Current is null)return;Current=await WriteAsync<ThreadDetail>($"threads/{Current.Thread.Id}/messages",new{message=Reply});Reply="";});
 /// <summary>Records this party's completion flag; the server requires both flags to finish.</summary>
 Task CompleteAsync()=>ExecuteAsync(async()=>{if(Current is null)return;Current=await WriteAsync<ThreadDetail>($"threads/{Current.Thread.Id}/complete",new{});await LoadListsAsync();});
 /// <summary>Closes an owner-authorized open listing and rejects its outstanding proposals.</summary>
 Task CloseAsync(string id)=>ExecuteAsync(async()=>{await WriteAsync<object>($"exchanges/{id}/close",new{});await LoadListsAsync();});
 /// <summary>Fills only a draft skill field without claiming the visitor has that skill.</summary>
 void ChooseSkill(string skill){Skill=skill;Creating=true;}
 /// <summary>Maps authoritative workflow states into interface text.</summary>
 string StateLabel(string state)=>state switch{"open"=>T("Açık", "Open"),"matched"=>T("Eşleşti", "Matched"),"proposed"=>T("Yanıt bekliyor", "Awaiting decision"),"accepted"=>T("Kabul edildi", "Accepted"),"completed"=>T("İki taraf da tamamladı", "Completed by both"),"declined"=>T("Kabul edilmedi", "Declined"),"withdrawn"=>T("Geri çekildi", "Withdrawn"),_=>T("Kapalı", "Closed")};
 /// <summary>Provides bounded editorial exercise ideas rather than fabricated offers.</summary>
 (string Skill,string Task)[] SkillIdeas()=>[("Story editing","Exchange feedback on one short paragraph."),("Rhythm reading","Teach a four-beat pattern and ask for another skill."),("Photography","Compare the framing of one ordinary object."),("Knitting","Show one basic stitch through a written guide."),("Sketching","Practice describing shapes before drawing."),("Spreadsheets","Build a small personal reading tracker."),("Programming","Explain one tiny function and its inputs."),("Community hosting","Plan a 20-minute group introduction."),("Prototyping","Turn a paper interface into a task flow."),("Logic puzzles","Explain a solving strategy, not only the answer."),("Sound editing","Discuss the structure of a short original recording."),("Clear writing","Rewrite one dense message into plain language."),("Video planning","Create a six-shot storyboard."),("Map reading","Explain a route using landmarks."),("Color composition","Describe a three-color palette and its purpose."),("Presentations","Reorder three slides around one clear point.")];
}
