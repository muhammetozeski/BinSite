@page "/ortak-muze/"
@inherits CommunityComponent
<PageTitle>@T("Ortak Müze — Nesnelerin anlattığı", "Shared Museum — What objects can tell")</PageTitle>
<PageSurface>
<div class="museum-page"><header><div class="museum-mark"><LanguageSwitch /></div><h1>@T("Ortak Müze", "Shared Museum")</h1><p>Create an exhibition of object stories and choose what to display.</p><div class="toolbar"><button @onclick="()=>Creating=true">@T("Sergi kur", "Create an exhibition")</button><button class="quiet" disabled="@Busy" @onclick="RefreshAsync">@T("Sergileri yenile", "Refresh exhibitions")</button></div></header>
@if(Status.Length>0){<p class="status" role="status">@Status</p>}
<main>
<nav class="exhibitions" aria-label="@T("Sergi seçimi", "Exhibition selection")">@foreach(var item in Museums){<button class="exhibition-link" disabled="@Busy" @onclick="()=>OpenAsync(item.Id)"><span>@item.Theme</span><strong>@item.Title</strong><small>@item.ObjectCount @T("sergilenen nesne", "exhibited objects")</small></button>}</nav>
@if(Creating){<section class="composer"><h2>@T("Küratör notunla başla", "Begin with a curator's note")</h2><form @onsubmit="CreateAsync" @onsubmit:preventDefault><label for="museum-title">@T("Sergi adı", "Exhibition title")</label><input id="museum-title" @bind="Title" required minlength="4" maxlength="100"><label for="museum-theme">@T("Birleştiren tema", "Connecting theme")</label><input id="museum-theme" @bind="Theme" required minlength="3" maxlength="80"><label for="museum-description">@T("Bu nesneler birlikte ne anlatacak?", "What will these objects tell together?")</label><textarea id="museum-description" @bind="Description" required minlength="30" maxlength="1600"></textarea><p class="small">@T("Sergiyi oluşturan tarayıcı kimliği küratör olur. Çerez silinirse bu yetki kaybolur; hesap kurtarma yoktur.", "Clearing cookies loses curator access; it cannot be recovered.")</p><div class="toolbar"><button type="submit" disabled="@Busy">@T("Boş sergiyi yayımla", "Publish empty exhibition")</button><button class="quiet" type="button" @onclick="()=>Creating=false">@T("Vazgeç", "Cancel")</button></div></form></section>}
@if(Current is not null){<section class="gallery"><div class="collection-heading"><span>@Current.Museum.Theme</span><h2>@Current.Museum.Title</h2><p>@Current.Museum.Description</p><div class="toolbar"><button class="quiet" disabled="@Busy" @onclick="ReloadAsync">@T("Katkıları yenile", "Refresh contributions")</button><button class="quiet" disabled="@Busy" @onclick="()=>CopyAsync(Link())">@T("Sergiyi paylaş", "Share exhibition")</button></div>@if(CopyFallback is not null){<input readonly class="copy-fallback" value="@CopyFallback">}@if(Current.Museum.Mine==1){<p class="curator">@T("Bu serginin küratörüsün. Bekleyen nesneleri incele; onaylı nesneleri okuma sırasına koy.", "You curate this exhibition. Review pending objects and arrange approved objects in reading order.")</p>}</div><div class="objects">@foreach(var item in Current.Objects){<article class="object-card" @key="item.Id"><span class="era">@item.Era</span><h3>@item.Title</h3><p>@item.Story</p><span class="object-status">@ObjectStatus(item.Status)</span>@if(Current.Museum.Mine==1){<div class="toolbar">@if(item.Status=="pending"){<button disabled="@Busy" @onclick='()=>DecideAsync(item.Id,"approved")'>@T("Sergiye al", "Approve for exhibition")</button><button class="quiet" disabled="@Busy" @onclick='()=>DecideAsync(item.Id,"rejected")'>@T("Uygun bulmadım", "Reject submission")</button>}@if(item.Status=="approved"){<button class="quiet" disabled="@Busy" @onclick="()=>MoveAsync(item.Id,-1)">@T("Öne al", "Move earlier")</button><button class="quiet" disabled="@Busy" @onclick="()=>MoveAsync(item.Id,1)">@T("Sona doğru al", "Move later")</button>}</div>}<ReportBox Kind="object" TargetId="@item.Id" Endpoint="community/reports" /></article>}</div><section class="contribute"><h3>@T("Bu sergiye bir nesne öner", "Propose an object for this exhibition")</h3><form @onsubmit="ContributeAsync" @onsubmit:preventDefault><label for="object-title">@T("Nesnenin adı", "Object title")</label><input id="object-title" @bind="ObjectTitle" required minlength="3" maxlength="100"><label for="object-era">@T("Dönem veya bağlam", "Period or context")</label><input id="object-era" @bind="Era" required minlength="2" maxlength="100"><label for="object-story">@T("Nesnenin kısa hikâyesi", "The object's short story")</label><textarea id="object-story" @bind="Story" required minlength="40" maxlength="2200"></textarea><p class="small">@T("Katkı önce sana ve küratöre görünür. Küratör onaylarsa herkese açılır. Küratörün kendi katkıları doğrudan sergilenir. Paylaşmaya yetkili olduğun metinleri yaz; gerçek kişiler hakkında hassas bilgi verme.", "A contribution is initially visible to you and the curator. Curator approval makes it public; the curator's own contributions are exhibited immediately. Use text you have permission to share and avoid sensitive information about real people.")</p><button type="submit" disabled="@Busy">@T("Nesne hikâyesini gönder", "Submit object story")</button></form></section><ReportBox Kind="museum" TargetId="@Current.Museum.Id" Endpoint="community/reports" /></section>}
<details class="editorial-gallery"><summary>Example exhibitions</summary><div class="editorial-heading"><span>@T("KURMACA EDİTORYAL ÖRNEK SERGİLER", "EXAMPLE EXHIBITIONS")</span><h2>@T("Bir sergi fikri görmek ister misin?", "Explore an example")</h2><p class="small">@T("Üç özgün sergi, 18 nesne anlatısı. Bunlar gerçek kullanıcı sergileri, tarihsel bulgular veya gerçek kişi hatıraları değildir. Metinler Türkçedir.", "Fictional stories, not historical records or user collections.")</p><select @bind="ExampleIndex" aria-label="@T("Editoryal sergi", "Example exhibition")">@for(var index=0;index<CommunityEditorial.Exhibits.Length;index++){<option value="@index">@CommunityEditorial.Exhibits[index].Title</option>}</select></div>@{var example=CommunityEditorial.Exhibits[ExampleIndex];}<h3>@example.Title</h3><p>@example.Description</p><div class="objects editorial-objects">@foreach(var item in example.Objects){<article class="object-card"><span class="era">@item.Era</span><h3>@item.Title</h3><p>@item.Story</p></article>}</div><button class="quiet" @onclick="()=>UseExample(example)">@T("Bu temadan bir sergi taslağı başlat", "Use this theme")</button></details>
</main><footer><details class="page-help"><summary>Privacy and safety</summary>@T("Sergiler ve onaylı nesneler herkese açıktır. Bekleyen katkılar sunucuda yalnız yazarı ve küratörün çerez kimliğine döner. Veriler Cloudflare veritabanında tutulur. Kişisel bilgi, taciz, nefret, izinsiz eser ve spam paylaşma. Üç farklı ağ raporu ilgili içeriği otomatik gizler; hız sınırları uygulanır. İnsan incelemesi hizmeti sunulmaz.", "Exhibitions and approved stories are public. Pending stories are shown to their author and curator. The site operator can read stored text. Do not share private information, abuse, spam or work you lack permission to share. Three reports from different networks hide content automatically. Reports are not reviewed by a person.")</details></footer></div>
</PageSurface>
@code{
 [SupplyParameterFromQuery(Name="sergi")]public string? MuseumId{get;set;}
 List<MuseumSummary> Museums=[];MuseumDetail? Current;bool Creating;int ExampleIndex;string Title="",Theme="",Description="",ObjectTitle="",Era="",Story="";
 /// <summary>Loads actual collection headers and an optional shared collection.</summary>
 protected override Task OnParametersSetAsync()=>ExecuteAsync(async()=>{await LoadListAsync();if(!string.IsNullOrEmpty(MuseumId))await LoadAsync(MuseumId);});
 /// <summary>Reads actual public exhibition metadata and published object counts.</summary>
 async Task LoadListAsync()=>Museums=(await ReadAsync<MuseumList>("museums")).Museums;
 /// <summary>Refreshes actual exhibitions.</summary>
 Task RefreshAsync()=>ExecuteAsync(LoadListAsync);
 /// <summary>Opens a selected museum under this identity's visibility permissions.</summary>
 Task OpenAsync(string id)=>ExecuteAsync(()=>LoadAsync(id));
 /// <summary>Loads approved and authorized pending stories, then updates the share address.</summary>
 async Task LoadAsync(string id){Current=await ReadAsync<MuseumDetail>("museums/"+id);await ReplaceAsync(Link());}
 /// <summary>Refreshes submissions and the server's ordering revision.</summary>
 Task ReloadAsync()=>Current is null?Task.CompletedTask:ExecuteAsync(()=>LoadAsync(Current.Museum.Id));
 /// <summary>Creates an actual empty exhibition and binds curator authority to the cookie identity.</summary>
 Task CreateAsync()=>ExecuteAsync(async()=>{var created=await WriteAsync<CreatedResponse>("museums",new{title=Title,theme=Theme,description=Description});await LoadAsync(created.Id);Title=Theme=Description="";Creating=false;await LoadListAsync();});
 /// <summary>Submits one object; only the server decides whether curator approval is required.</summary>
 Task ContributeAsync()=>ExecuteAsync(async()=>{if(Current is null)return;await WriteAsync<CreatedResponse>($"museums/{Current.Museum.Id}/objects",new{title=ObjectTitle,era=Era,story=Story});ObjectTitle=Era=Story="";await LoadAsync(Current.Museum.Id);await LoadListAsync();},T("Nesne hikâyen kaydedildi. Yayın durumu kartında görünüyor.","Your object story was saved. Its publication state is shown on its card."));
 /// <summary>Submits an owner-authorized moderation decision for one contribution.</summary>
 Task DecideAsync(string id,string status)=>ExecuteAsync(async()=>{await WriteAsync<object>($"objects/{id}/decision",new{status});if(Current is not null)await LoadAsync(Current.Museum.Id);await LoadListAsync();});
 /// <summary>Reorders the complete approved set with an expected server revision.</summary>
 Task MoveAsync(string id,int direction)=>ExecuteAsync(async()=>{if(Current is null)return;var ids=Current.Objects.Where(item=>item.Status=="approved").Select(item=>item.Id).ToList();var index=ids.IndexOf(id);var target=index+direction;if(index<0||target<0||target>=ids.Count)return;(ids[index],ids[target])=(ids[target],ids[index]);Current=await WriteAsync<MuseumDetail>($"museums/{Current.Museum.Id}/order",new{revision=Current.Museum.Revision,ids});});
 /// <summary>Copies an explicitly fictional editorial theme into an unpublished exhibition draft.</summary>
 void UseExample(EditorialExhibit exhibit){Title=exhibit.Title;Theme=exhibit.Theme;Description=exhibit.Description;Creating=true;}
 /// <summary>Translates the server's authoritative contribution status.</summary>
 string ObjectStatus(string state)=>state switch{"approved"=>T("Sergileniyor", "Exhibited"),"pending"=>T("Küratör onayı bekliyor", "Awaiting curator approval"),_=>T("Sergiye alınmadı", "Not selected for exhibition")};
 /// <summary>Builds a shareable independent collection URL.</summary>
 string Link()=>ContentLink("ortak-muze","sergi",Current?.Museum.Id??"");
}
