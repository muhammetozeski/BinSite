@page "/uretim-ortakligi/"
@inherits CollaborationComponent
<PageTitle>@T("Üretim Ortaklığı — Bir fikri birlikte bitir", "Creative Partnership — Finish an idea together")</PageTitle>
<PageSurface>
<div class="jam-page"><header><div class="topline"><LanguageSwitch /></div><h1>@T("Üretim Ortaklığı", "Creative Partnership")</h1><p>Start a project, share tasks and review the finished work.</p></header>
@if(Status.Length>0){<p role="status" class="status">@Status</p>}
<main><aside><h2>@T("Jam başlat", "Start a jam")</h2><form @onsubmit="CreateAsync" @onsubmit:preventDefault><label>@T("Proje adı", "Project title")<input @bind="Title" required minlength="4" maxlength="140"></label><label>@T("Tema", "Theme")<input @bind="Theme" required minlength="3" maxlength="100"></label><label>@T("Ne üretilecek?", "What will be created?")<textarea @bind="Brief" required minlength="40" maxlength="2000"></textarea></label><label>@T("Süre (gün)", "Duration (days)")<input type="number" @bind="Days" min="1" max="14" required></label><button type="submit" disabled="@Busy">@T("Projeyi aç", "Open project")</button></form><button class="quiet" @onclick="ListAsync" disabled="@Busy">@T("Projeleri yenile", "Refresh projects")</button>@foreach(var item in Items){<button class="project-link" disabled="@Busy" @onclick="()=>OpenAsync(item.Id)">@item.Title</button>}</aside><section>
@if(Current is null){<section class="empty"><h2>@T("Bir fikir, tek kişiye sığmak zorunda değil.","Choose a project or start one.")</h2><p>@T("Aşağıdaki özgün görev fikirleri bir hikâye oyunu jam'i içindir. Gerçek görev oluşturmaz; proje sahibi taslağı seçip düzenleyerek yayımlar.","Task examples are below. Edit a draft before publishing it.")</p></section>}
else{<h2>@Current.Title</h2><p class="theme">@Current.State.Theme</p><p>@Current.State.Brief</p><p class="small">@T("Teslim sonu:","Submission deadline:") @DateLabel(Current.State.Deadline)</p><div class="toolbar"><button class="quiet" @onclick="ReloadAsync" disabled="@Busy">@T("Durumu yenile", "Refresh state")</button><button class="quiet" @onclick="()=>CopyAsync(SpaceLink(Kind,Current.Id))">@T("Katılımcı davet et", "Invite collaborators")</button></div>@if(CopyFallback is not null){<input readonly value="@CopyFallback">}@if(Current.MemberId is null){<form @onsubmit="JoinAsync" @onsubmit:preventDefault><label>@T("Gönüllü takma adın", "Volunteer handle")<input @bind="Name" required minlength="2" maxlength="24"></label><button type="submit" disabled="@Busy">@T("Üretime katıl", "Join project")</button></form>}<div class="members">@foreach(var participant in Current.State.Members){<span>@participant.Name</span>}</div>
@if(Current.Mine==1){<details class="task-author"><summary>@T("Teslimi belli bir görev ekle", "Add a task with a defined deliverable")</summary><form @onsubmit="AddTaskAsync" @onsubmit:preventDefault><label>@T("Görev adı", "Task title")<input @bind="TaskTitle" required minlength="5" maxlength="120"></label><label>@T("Nasıl tamamlanmış sayılacak?", "What will count as finished?")<textarea @bind="Spec" required minlength="30" maxlength="1600"></textarea></label><button type="submit" disabled="@Busy">@T("Görevi aç", "Publish task")</button></form></details>}
<div class="task-columns">@foreach(var state in TaskStates){<section><h3>@TaskLabel(state)</h3>@foreach(var task in Current.State.Tasks.Where(item=>item.Status==state)){<article class="task"><h4>@task.Title</h4><p>@task.Spec</p>@if(task.Assignee is not null){<p class="small">@T("Görevi alan:","Claimed by:") @Handle(Current.State.Members,task.Assignee)</p>}@if(task.Review.Length>0){<p class="review">@task.Review</p>}@if(task.Status=="open"&&Current.MemberId is not null){<button disabled="@Busy" @onclick="()=>ClaimAsync(task.Id)">@T("Bu görevi al", "Claim task")</button>}@if(task.Status=="claimed"&&Current.MemberId==task.Assignee){<button class="quiet" @onclick="()=>Submitting=task.Id">@T("Teslim hazırla", "Prepare delivery")</button>}@if(task.Submission is not null){<section class="submission"><p>@task.Submission.Body</p>@if(task.Submission.Link.Length>0){<a href="@task.Submission.Link" target="_blank" rel="noopener noreferrer nofollow">@T("Teslim bağlantısı", "Delivery link")</a>}</section>}@if(task.Status=="submitted"&&Current.Mine==1){<label>@T("İnceleme notu", "Review note")<textarea value="@Reviews.GetValueOrDefault(task.Id,"")" @onchange="e=>Reviews[task.Id]=e.Value?.ToString()??string.Empty" minlength="10" maxlength="1000"></textarea></label><div class="toolbar"><button disabled="@Busy" @onclick="()=>ReviewAsync(task.Id,true)">@T("Onayla", "Approve")</button><button class="quiet" disabled="@Busy" @onclick="()=>ReviewAsync(task.Id,false)">@T("Düzeltme iste", "Request revision")</button></div>}</article>}</section>}</div>
@if(Submitting is not null){<section class="delivery"><h3>@T("Görev teslimi", "Task delivery")</h3><form @onsubmit="SubmitAsync" @onsubmit:preventDefault><label>@T("Ne ürettin, nasıl incelenebilir?", "What did you create, and how can it be reviewed?")<textarea @bind="Submission" required minlength="30" maxlength="3000"></textarea></label><label>@T("İsteğe bağlı çalışma bağlantısı", "Optional work link")<input @bind="WorkLink" type="url" maxlength="800"></label><button type="submit" disabled="@Busy">@T("İncelemeye gönder", "Submit for review")</button></form></section>}<ReportBox Kind="@Kind" TargetId="@Current.Id" Endpoint="collaboration/reports" />}
<details class="editorial"><summary>@T("8 özgün jam görevi taslağı", "Task ideas")</summary><p class="small">@T("Editoryal öneriler; yayımlanmış görev veya gerçek teslim değildir. Proje sahibi seçip kendi taslağına alabilir. Metinler Türkçedir.","Examples for your draft, not published tasks.")</p>@foreach(var draft in Drafts){<button class="task-draft" @onclick="()=>UseDraft(draft)"><strong>@draft.Title</strong><span>@draft.Spec</span></button>}</details>
</section></main><footer><p class="small">@T("Görev ve teslimler herkese açıktır. Platform çalışma sözleşmesi, ücret veya telif devri düzenlemez; katkının kullanım koşullarını ekipçe açıkça konuşun. Son tarih sunucu saatiyle yeni görev, alma ve teslim işlemlerini kapatır; sahip incelemesi daha sonra yapılabilir.","Tasks and deliveries are public. Agree on payment and rights yourselves. After the deadline, only owner reviews remain open.")</p><CollaborationRules /></footer></div>
</PageSurface>
@code{
 const string Kind="uretim-ortakligi";[SupplyParameterFromQuery(Name="alan")]public string? Area{get;set;}Space<JamState>? Current;List<SpaceItem> Items=[];string Title="",Theme="",Brief="",Name="",TaskTitle="",Spec="",Submission="",WorkLink="";int Days=3;string? Submitting;readonly Dictionary<string,string> Reviews=[];static readonly string[] TaskStates=["open","claimed","submitted","approved"];
 static readonly (string Title,string Spec)[] Drafts=[
("Write a Three-Scene Opening","Divide the opening into three short scenes. State what the player learns and which choice appears in each. Deliver a draft that can be reviewed as a whole."),
("Build a Decision Map","Create at most six nodes leading from a beginning to two endings. Label each connection with the player's choice and mark dead ends explicitly."),
("Draft a Sound Identity","Describe three original sound ideas in words. Give each sound's function, duration and intended mood. Do not use unauthorized recordings or commercial works."),
("Run a First-Reader Review","Read the opening flow and record three unclear points. Separate observation from interpretation and make one concrete suggestion for each issue."),
("Create an Object Glossary","Give five game objects a name, function and one-sentence story. Identify objects that duplicate the same job."),
("Check Accessible Instructions","Find three instructions relying on color or sound alone. Propose an explicit text alternative communicating the same information."),
("Explain One Ending","Choose an ending and explain in two paragraphs why its preceding decisions matter. Show that its result follows from information already given."),
("Organize the Delivery","Arrange the team's existing texts into a named reading order. Add a review summary containing no personal data or access keys.")];
 /// <summary>Loads actual projects and an optional shared task board.</summary>
 protected override Task OnParametersSetAsync()=>ExecuteAsync(async()=>{await LoadListAsync();if(Area is not null)await LoadAsync(Area);});
 /// <summary>Retrieves public project headers.</summary>
 async Task LoadListAsync()=>Items=(await DirectoryAsync(Kind)).Items;
 /// <summary>Refreshes project discovery.</summary>
 Task ListAsync()=>ExecuteAsync(LoadListAsync);
 /// <summary>Reads actual task assignments and owner decisions.</summary>
 async Task LoadAsync(string id){Current=await ReadSpaceAsync<JamState>(Kind,id);await RememberAsync(Kind,id);}
 /// <summary>Opens a selected project board.</summary>
 Task OpenAsync(string id)=>ExecuteAsync(()=>LoadAsync(id));
 /// <summary>Refreshes the current task board.</summary>
 Task ReloadAsync()=>Current is null?Task.CompletedTask:OpenAsync(Current.Id);
 /// <summary>Creates a time-bounded creative project without fabricated tasks.</summary>
 Task CreateAsync()=>ExecuteAsync(async()=>{Current=await CreateSpaceAsync<JamState>(Kind,new{title=Title,theme=Theme,brief=Brief,days=Days});await RememberAsync(Kind,Current.Id);await LoadListAsync();});
 /// <summary>Registers this volunteer handle.</summary>
 Task JoinAsync()=>ExecuteAsync(async()=>{if(Current is not null)Current=await ActionAsync(Kind,Current,"join",new{name=Name});});
 /// <summary>Copies an explicitly editorial task into the owner's unpublished fields.</summary>
 void UseDraft((string Title,string Spec) draft){TaskTitle=draft.Title;Spec=draft.Spec;}
 /// <summary>Adds an owner-authorized task with an explicit deliverable.</summary>
 Task AddTaskAsync()=>ExecuteAsync(async()=>{if(Current is not null){Current=await ActionAsync(Kind,Current,"task",new{title=TaskTitle,spec=Spec});TaskTitle=Spec="";}});
 /// <summary>Atomically claims an unassigned task for this joined member.</summary>
 Task ClaimAsync(string taskId)=>ExecuteAsync(async()=>{if(Current is not null)Current=await ActionAsync(Kind,Current,"claim",new{taskId});});
 /// <summary>Submits work only for a task assigned to the current member.</summary>
 Task SubmitAsync()=>ExecuteAsync(async()=>{if(Current is not null&&Submitting is not null){Current=await ActionAsync(Kind,Current,"submit",new{taskId=Submitting,body=Submission,link=WorkLink});Submission=WorkLink="";Submitting=null;}});
 /// <summary>Records an owner-only approval or request for revision.</summary>
 Task ReviewAsync(string taskId,bool approved)=>ExecuteAsync(async()=>{if(Current is not null)Current=await ActionAsync(Kind,Current,"review",new{taskId,approved,review=Reviews.GetValueOrDefault(taskId,"")});});
 /// <summary>Translates the task workflow columns.</summary>
 string TaskLabel(string state)=>state switch{"open"=>T("Açık görevler", "Open tasks"),"claimed"=>T("Üzerinde çalışılıyor", "In progress"),"submitted"=>T("İncelemede", "Awaiting review"),_=>T("Onaylandı", "Approved")};
}
