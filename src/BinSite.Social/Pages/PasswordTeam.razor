@page "/parola-ekibi/"
@inherits CommunityComponent
<PageTitle>@T("Parola Ekibi — Dört kart, tek kilit", "Password Team — Four cards, one lock")</PageTitle>
<PageSurface>
<div class="team-page"><header><div class="masthead"><LanguageSwitch /></div><h1>@T("Parola Ekibi", "Password Team")</h1><p>Four players get one clue each. Work together to decode the lock.</p></header>
@if(Status.Length>0){<p class="status" role="status">@Status</p>}
<main>
@if(Current is null){<div class="setup-layout"><section class="control-panel"><h2>@T("Takım odasını kur", "Create a team room")</h2><form @onsubmit="CreateAsync" @onsubmit:preventDefault><label for="room-title">@T("Oda adı", "Room title")</label><input id="room-title" @bind="Title" required minlength="4" maxlength="100"><button type="submit" disabled="@Busy">@T("Odayı aç ve ilk kartı al", "Open room and take the first card")</button></form><p class="small">@T("Oda 24 saat açık kalır. Bağlantıyı üç arkadaşına gönder. Dört ayrı tarayıcı kimliği gerekir; aynı kimlik iki rolü alamaz. Çerez silmek yeni kimlik oluşturabileceği için bu kişi doğrulaması değildir.", "Invite three friends on separate browsers. The room stays open for 24 hours.")</p><details><summary>@T("Elimde oda bağlantısı var", "I have a room link")</summary><form @onsubmit="OpenLinkAsync" @onsubmit:preventDefault><label for="team-link">@T("Bağlantıyı yapıştır", "Paste room link")</label><input id="team-link" @bind="ExistingLink" type="url" required><button type="submit" class="quiet" disabled="@Busy">@T("Odaya git", "Go to room")</button></form></details></section><details class="how-it-works"><summary>How the four cards work</summary>@for(var index=0;index<4;index++){<article><span>@(index+1)</span><div><h3>@RoleName(index)</h3><p>@RoleDescription(index)</p></div></article>}<p class="small">@T("Örnek: SOLA döndürmek, ilk rakamları aynı sırayla sona taşımaktır. 1234 dizisini 2 basamak sola döndürürsen 3412 olur. Bu örnek gerçek odanın kodu değildir.", "Example: rotating LEFT moves the first digits to the end in the same order. Rotating 1234 left by 2 gives 3412.")</p></details></div>}
else{<section class="mission"><span class="eyebrow">@T(Scenarios[Current.Room.Scenario].Name,ScenarioEnglish[Current.Room.Scenario].Name)</span><h2>@Current.Room.Title</h2><p>@T(Scenarios[Current.Room.Scenario].Story,ScenarioEnglish[Current.Room.Scenario].Story)</p><div class="toolbar"><button class="quiet" disabled="@Busy" @onclick="RefreshAsync">@T("Odayı / mesajları yenile", "Refresh")</button><button class="quiet" disabled="@Busy" @onclick="()=>CopyAsync(Link())">@T("Takım bağlantısını paylaş", "Copy room link")</button><button class="quiet" disabled="@Busy" @onclick="NewRoomAsync">@T("Yeni oda", "New room")</button></div>@if(CopyFallback is not null){<input readonly class="copy-fallback" value="@CopyFallback">}<p class="small">@T("Son sunucu saati:", "Updated:") @DateLabel(Current.ServerNow) · @T("Oda sonu:", "Room expires:") @DateLabel(Current.Room.ExpiresAt)</p></section>
<section class="roles" aria-label="@T("Rol durumu", "Role occupancy")">@for(var index=0;index<4;index++){var player=Current.Players.FirstOrDefault(item=>item.Role==index);<article class="@(player is null?"role empty-role":"role occupied")"><strong>@RoleName(index)</strong><span>@(player is null?T("Boş", "Available"):player.Mine==1?T("Senin kartın", "Your card"):T("Takım arkadaşı katıldı", "Teammate joined"))</span></article>}</section>
@if(Current.Room.ExpiresAt<=Current.ServerNow){<div class="finished"><h2>@T("Odanın süresi doldu.", "This room has expired.")</h2><p>@T("Yeni bir odada yeni kartlarla tekrar oynayabilirsiniz.", "Create another room to play again with fresh cards.")</p></div>}
else if(Current.Room.Status=="solved"){<div class="finished"><h2>@T("Kilit açıldı. Takım tamamladı!", "The lock is open. Your team solved it!")</h2><p>@T("Dört ayrı bilgi, tek bir ortak sonuca dönüştü. Sonraki odada rolleri değiştirmeyi deneyin.", "Try switching roles in your next room.")</p></div>}
else if(Current.Clue is null){<section class="join-panel"><h2>@T("Bir özel kart sana ayrılabilir.", "Join the team")</h2><p>@T("Katılmadan özel ipuçları ve takım konuşması görünmez. Sunucu boş olan bir rolü bu tarayıcı kimliğine bağlar.", "Join to receive an available clue card and read team messages.")</p><button disabled="@(Busy||Current.Players.Count>=4)" @onclick="JoinAsync">@T("Boş role katıl", "Join an available role")</button></section>}
@if(Current.Clue is not null){<div class="play-layout"><section><article class="private-card"><span class="eyebrow">@T("YALNIZ SANA GÖNDERİLEN KART", "YOUR PRIVATE CARD")</span><h3>@RoleName(Current.Clue.Role)</h3><p>@Current.Clue.Clue</p><p class="small">@T("İstersen bilgini takım sohbetinde açıklayabilirsin. Diğer kartların değerleri bu yanıtın içinde bulunmaz.", "Share your clue with the team.")</p></article>@if(Current.Room.Status=="open"&&Current.Room.ExpiresAt>Current.ServerNow){<section class="answer-panel"><h3>@T("Ortak kodu dene", "Try the shared code")</h3><p class="small">@T("Dört rol dolduğunda sırayı, iki anahtarı ve dönüşümü birleştir. Baştaki sıfır da bir rakamdır. Denemeler sunucuda sınırlanır.", "Use the symbol order, both keys and the rotation. Keep leading zeros.")</p><form @onsubmit="AnswerAsync" @onsubmit:preventDefault><label for="team-answer">@T("Dört haneli kod", "Four-digit code")</label><input id="team-answer" @bind="Answer" pattern="[0-9]{4}" maxlength="4" minlength="4" inputmode="numeric" autocomplete="off" required><button type="submit" disabled="@(Busy||Current.Players.Count!=4)">@T("Kilidi dene", "Try the lock")</button></form></section>}</section><section class="chat"><h3>@T("Takım masası", "Team chat")</h3><p class="small">@T("Mesajlar bu odaya katılan kimliklerce okunur; otomatik yenilenmez. Kişisel iletişim veya hassas bilgi paylaşma.", "Use Refresh to see new team messages. Keep personal information out of the chat.")</p><div class="chat-messages">@foreach(var message in Current.Messages){<article><span>@RoleName(message.Role) · @DateLabel(message.CreatedAt)</span><p>@message.Body</p></article>}</div>@if(Current.Room.ExpiresAt>Current.ServerNow){<form @onsubmit="SendAsync" @onsubmit:preventDefault><label for="team-message">@T("Takıma mesaj", "Message the team")</label><textarea id="team-message" @bind="Message" required minlength="2" maxlength="800"></textarea><button type="submit" disabled="@Busy">@T("Mesajı gönder", "Send message")</button></form>}</section></div>}
<ReportBox Kind="room" TargetId="@Current.Room.Id" Endpoint="community/reports" />}
</main><footer><details class="page-help"><summary>Privacy and safety</summary>Anyone with the link can claim an available role. Clearing site data loses your card. The site operator can read room text and messages; do not share sensitive information, abuse, hate or spam. Reports are not reviewed by a person.</details></footer></div>
</PageSurface>
@code{
 [SupplyParameterFromQuery(Name="oda")]public string? RoomId{get;set;}
 RoomDetail? Current;string Title="",ExistingLink="",Answer="",Message="";const int Scenario=0;
 static (string Name,string Story)[] Scenarios=>ScenarioEnglish;
 static readonly (string Name,string Story)[] ScenarioEnglish=[("The Last Station","The night train doors are locked. Four control cards have been assigned to separate operators: the sequence, two halves of a symbol key, and a final transformation. Combine all four pieces at the team table to unlock departure."),("Lighthouse Archive","The old archive waits for the lighthouse beam. One keeper holds the symbol sequence, two hold different halves of the digit key, and the lookout holds the final transformation. Read them together to restore the light."),("The Missing Broadcast","The studio is silent behind a four-part access puzzle. One card holds the sequence, two map symbols to digits, and the last explains how to rotate the result. Agree on one code to open the broadcast."),("The Sky Greenhouse","The greenhouse awaits four operators: a sequence card, two maintenance keys and a final climate transformation. The four-digit password is determined by combining all cards in order."),("The Clock Tower Table","The tower has four pieces of knowledge instead of four keyholes. A sequence keeper reads symbols, two apprentices hold the key halves and a clockmaker rotates the resulting digits. Clear communication gives one final code."),("The Moon Map Room","The imaginary observatory awaits a four-person team. A cartographer knows the symbol path, two researchers hold symbol values, and a navigator holds the final transformation. Build the answer together without changing the order.")];
 /// <summary>Loads only an explicitly shared room; no public room directory is created.</summary>
 protected override Task OnParametersSetAsync()=>string.IsNullOrEmpty(RoomId)?Task.CompletedTask:ExecuteAsync(()=>LoadAsync(RoomId));
 /// <summary>Reads the current room with only this participant's private clue and permitted conversation.</summary>
 async Task LoadAsync(string id){Current=await ReadAsync<RoomDetail>("rooms/"+id);RoomId=id;await ReplaceAsync(Link());}
 /// <summary>Creates a solvable generated puzzle and claims the first role on the server.</summary>
 Task CreateAsync()=>ExecuteAsync(async()=>{var created=await WriteAsync<CreatedResponse>("rooms",new{title=Title,scenario=Scenario});await LoadAsync(created.Id);Title="";},T("Oda kuruldu. Bağlantıyı diğer üç rol için paylaş.","Room created. Share the link for the other three roles."));
 /// <summary>Claims one remaining role; the server enforces room capacity and identity uniqueness.</summary>
 Task JoinAsync()=>ExecuteAsync(async()=>{if(Current is null)return;Current=await WriteAsync<RoomDetail>($"rooms/{Current.Room.Id}/join",new{});});
 /// <summary>Refreshes actual role occupancy, chat and solve status.</summary>
 Task RefreshAsync()=>Current is null?Task.CompletedTask:ExecuteAsync(()=>LoadAsync(Current.Room.Id));
 /// <summary>Submits one authoritative solve attempt without returning the stored solution.</summary>
 Task AnswerAsync()=>ExecuteAsync(async()=>{if(Current is null)return;var result=await WriteAsync<AnswerResult>($"rooms/{Current.Room.Id}/answer",new{answer=Answer});Status=result.Solved?T("Kilit açıldı!", "The lock opened!"):T("Kod eşleşmedi. Sıra, sembol değerleri ve sola dönüşüm adımını birlikte kontrol edin.","The code did not match. Recheck the sequence, symbol values and left rotation together.");await LoadAsync(Current.Room.Id);});
 /// <summary>Sends a role-authorized team message and reads the resulting shared conversation.</summary>
 Task SendAsync()=>ExecuteAsync(async()=>{if(Current is null)return;Current=await WriteAsync<RoomDetail>($"rooms/{Current.Room.Id}/messages",new{message=Message});Message="";});
 /// <summary>Validates a pasted same-origin room link before opening it.</summary>
 Task OpenLinkAsync()=>ExecuteAsync(async()=>{if(!Uri.TryCreate(ExistingLink,UriKind.Absolute,out var url)||url.GetLeftPart(UriPartial.Authority)!=new Uri(Navigation.BaseUri).GetLeftPart(UriPartial.Authority)){HasError=true;Status="Paste a Password Team room link from this site.";return;}var pair=url.Query.TrimStart('?').Split('&').Select(item=>item.Split('=',2)).FirstOrDefault(item=>item.Length==2&&item[0]=="oda");if(pair is null||!Guid.TryParse(Uri.UnescapeDataString(pair[1]),out _)){HasError=true;Status="This link does not contain a room. Paste the complete invitation.";return;}await LoadAsync(Uri.UnescapeDataString(pair[1]));});
 /// <summary>Starts another room draft without deleting a previous room.</summary>
 async Task NewRoomAsync(){Current=null;RoomId=null;Answer=Message=Status="";CopyFallback=null;await ReplaceAsync(new Uri(new Uri(Navigation.BaseUri),"parola-ekibi/").AbsoluteUri);}
 /// <summary>Translates the public role label without exposing another card's values.</summary>
 string RoleName(int role)=>role switch{0=>T("Sıra sorumlusu", "Sequence keeper"),1=>T("Anahtar A", "Key A"),2=>T("Anahtar B", "Key B"),_=>T("Dönüşüm sorumlusu", "Transformation keeper")};
 /// <summary>Explains each role's public responsibility, excluding all generated secret values.</summary>
 string RoleDescription(int role)=>role switch{0=>T("Semboller hangi sırayla okunacak? Bu kart yalnız sırayı bilir.","In which order should symbols be read? This card knows only the order."),1=>T("İlk iki sembolün rakam karşılığını bilir.","Knows the digit values for the first two symbol types."),2=>T("Diğer iki sembolün rakam karşılığını bilir.","Knows the digit values for the other two symbol types."),_=>T("Ham diziyi son koda dönüştüren sola döndürme adımını bilir.","Knows the left-rotation step that transforms the raw sequence into the final code.")};
 /// <summary>Builds the independently usable unlisted room invite.</summary>
 string Link()=>ContentLink("parola-ekibi","oda",Current?.Room.Id??RoomId??"");
}
