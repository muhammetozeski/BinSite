@page "/parola-ekibi/"
@inherits CommunityComponent
<PageTitle>@T("Parola Ekibi — Dört kart, tek kilit", "Password Team — Four cards, one lock")</PageTitle>
<div class="team-page"><header><div class="masthead"><span class="eyebrow">@T("GERÇEK İŞBİRLİKLİ BULMACA", "A SHARED COOPERATIVE PUZZLE")</span><LanguageSwitch /></div><h1>@T("Parola Ekibi", "Password Team")</h1><p>@T("Dört rolün her biri farklı bir bilgi parçası alır. Sembollerin sırası, iki yarım anahtar ve son dönüşüm. Kartları konuşarak birleştirin; sunucu her çerez kimliğine yalnız kendi özel kartını gönderir.", "Four roles each receive a different piece: a symbol sequence, two halves of a key, and a final transformation. Combine them by talking; the server returns only the current cookie identity's private card.")</p></header>
@if(Status.Length>0){<p class="status" role="status">@Status</p>}
<main>
@if(Current is null){<div class="setup-layout"><section class="control-panel"><h2>@T("Takım odasını kur", "Create a team room")</h2><form @onsubmit="CreateAsync" @onsubmit:preventDefault><label for="room-title">@T("Oda adı", "Room title")</label><input id="room-title" @bind="Title" required minlength="4" maxlength="100"><label for="room-scenario">@T("Görevin sahnesi", "Mission setting")</label><select id="room-scenario" @bind="Scenario">@for(var index=0;index<Scenarios.Length;index++){<option value="@index">@T(Scenarios[index].Name,ScenarioEnglish[index].Name)</option>}</select><p class="mission-preview">@T(Scenarios[Scenario].Story,ScenarioEnglish[Scenario].Story)</p><button type="submit" disabled="@Busy">@T("Odayı aç ve ilk kartı al", "Open room and take the first card")</button></form><p class="small">@T("Oda 24 saat açık kalır. Bağlantıyı üç arkadaşına gönder. Dört ayrı tarayıcı kimliği gerekir; aynı kimlik iki rolü alamaz. Çerez silmek yeni kimlik oluşturabileceği için bu kişi doğrulaması değildir.", "The room stays open for 24 hours. Send the link to three friends. Four browser identities are required; one identity cannot occupy two roles. Clearing a cookie can create another identity, so this is not person verification.")</p><details><summary>@T("Elimde oda bağlantısı var", "I have a room link")</summary><form @onsubmit="OpenLinkAsync" @onsubmit:preventDefault><label for="team-link">@T("Bağlantıyı yapıştır", "Paste room link")</label><input id="team-link" @bind="ExistingLink" type="url" required><button type="submit" class="quiet" disabled="@Busy">@T("Odaya git", "Go to room")</button></form></details></section><section class="how-it-works"><h2>@T("Dört bilgi, dört farklı sorumluluk", "Four pieces, four responsibilities")</h2>@for(var index=0;index<4;index++){<article><span>@(index+1)</span><div><h3>@RoleName(index)</h3><p>@RoleDescription(index)</p></div></article>}<p class="small">@T("Örnek: SOLA döndürmek, ilk rakamları aynı sırayla sona taşımaktır. 1234 dizisini 2 basamak sola döndürürsen 3412 olur. Bu örnek gerçek odanın kodu değildir.", "Example: rotating LEFT moves the first digits to the end in the same order. Rotating 1234 left by 2 gives 3412. This example is not a real room's code.")</p></section></div>}
else{<section class="mission"><span class="eyebrow">@T(Scenarios[Current.Room.Scenario].Name,ScenarioEnglish[Current.Room.Scenario].Name)</span><h2>@Current.Room.Title</h2><p>@T(Scenarios[Current.Room.Scenario].Story,ScenarioEnglish[Current.Room.Scenario].Story)</p><div class="toolbar"><button class="quiet" disabled="@Busy" @onclick="RefreshAsync">@T("Odayı / mesajları yenile", "Refresh room / messages")</button><button class="quiet" disabled="@Busy" @onclick="()=>CopyAsync(Link())">@T("Takım bağlantısını paylaş", "Share team link")</button><button class="quiet" @onclick="NewRoomAsync">@T("Yeni oda", "New room")</button></div>@if(CopyFallback is not null){<input readonly class="copy-fallback" value="@CopyFallback">}<p class="small">@T("Son sunucu saati:", "Last server time:") @DateLabel(Current.ServerNow) · @T("Oda sonu:", "Room expires:") @DateLabel(Current.Room.ExpiresAt)</p></section>
<section class="roles" aria-label="@T("Rol durumu", "Role occupancy")">@for(var index=0;index<4;index++){var player=Current.Players.FirstOrDefault(item=>item.Role==index);<article class="@(player is null?"role empty-role":"role occupied")"><strong>@RoleName(index)</strong><span>@(player is null?T("Boş", "Available"):player.Mine==1?T("Senin kartın", "Your card"):T("Takım arkadaşı katıldı", "Teammate joined"))</span></article>}</section>
@if(Current.Room.ExpiresAt<=Current.ServerNow){<div class="finished"><h2>@T("Odanın süresi doldu.", "This room has expired.")</h2><p>@T("Yeni bir odada yeni kartlarla tekrar oynayabilirsiniz.", "Create another room to play again with fresh cards.")</p></div>}
else if(Current.Room.Status=="solved"){<div class="finished"><h2>@T("Kilit açıldı. Takım tamamladı!", "The lock is open. Your team solved it!")</h2><p>@T("Dört ayrı bilgi, tek bir ortak sonuca dönüştü. Sonraki odada rolleri değiştirmeyi deneyin.", "Four separate pieces became one shared result. Try switching roles in your next room.")</p></div>}
else if(Current.Clue is null){<section class="join-panel"><h2>@T("Bir özel kart sana ayrılabilir.", "A private card could be yours.")</h2><p>@T("Katılmadan özel ipuçları ve takım konuşması görünmez. Sunucu boş olan bir rolü bu tarayıcı kimliğine bağlar.", "Private clues and team conversation are hidden until you join. The server assigns one available role to this browser identity.")</p><button disabled="@(Busy||Current.Players.Count>=4)" @onclick="JoinAsync">@T("Boş role katıl", "Join an available role")</button></section>}
@if(Current.Clue is not null){<div class="play-layout"><section><article class="private-card"><span class="eyebrow">@T("YALNIZ SANA GÖNDERİLEN KART", "THE CARD SENT ONLY TO YOU")</span><h3>@RoleName(Current.Clue.Role)</h3><p>@Current.Clue.Clue</p><p class="small">@T("İstersen bilgini takım sohbetinde açıklayabilirsin. Diğer kartların değerleri bu yanıtın içinde bulunmaz.", "You can choose to explain this information in team chat. Other cards' private values are not included in this response.")</p></article>@if(Current.Room.Status=="open"&&Current.Room.ExpiresAt>Current.ServerNow){<section class="answer-panel"><h3>@T("Ortak kodu dene", "Try the shared code")</h3><p class="small">@T("Dört rol dolduğunda sırayı, iki anahtarı ve dönüşümü birleştir. Baştaki sıfır da bir rakamdır. Denemeler sunucuda sınırlanır.", "When all four roles are filled, combine the sequence, both keys and the transformation. A leading zero is still a digit. The server limits attempts.")</p><form @onsubmit="AnswerAsync" @onsubmit:preventDefault><label for="team-answer">@T("Dört haneli kod", "Four-digit code")</label><input id="team-answer" @bind="Answer" pattern="[0-9]{4}" maxlength="4" minlength="4" inputmode="numeric" autocomplete="off" required><button type="submit" disabled="@(Busy||Current.Players.Count!=4)">@T("Kilidi dene", "Try the lock")</button></form></section>}</section><section class="chat"><h3>@T("Takım masası", "Team table")</h3><p class="small">@T("Mesajlar bu odaya katılan kimliklerce okunur; otomatik yenilenmez. Kişisel iletişim veya hassas bilgi paylaşma.", "Messages are visible to identities that joined the room and refresh on request. Do not share personal contact or sensitive information.")</p><div class="chat-messages">@foreach(var message in Current.Messages){<article><span>@RoleName(message.Role) · @DateLabel(message.CreatedAt)</span><p>@message.Body</p></article>}</div>@if(Current.Room.ExpiresAt>Current.ServerNow){<form @onsubmit="SendAsync" @onsubmit:preventDefault><label for="team-message">@T("Takıma mesaj", "Message the team")</label><textarea id="team-message" @bind="Message" required minlength="2" maxlength="800"></textarea><button type="submit" disabled="@Busy">@T("Mesajı gönder", "Send message")</button></form>}</section></div>}
<ReportBox Kind="room" TargetId="@Current.Room.Id" Endpoint="community/reports" />}
</main><footer>@T("Oda bağlantısını bilenler boş role katılabilir; en fazla dört rol vardır. Özel ipuçları sunucuda rol ve çerez kimliğiyle denetlenir. Çerezi kaybedersen rol erişimi kaybolur. Oda metni ve sohbet Cloudflare veritabanında saklanır; işletmeci erişebilir, uçtan uca şifreleme yoktur. Kişisel bilgi, taciz, nefret ve spam paylaşma. Üç farklı ağ raporu odayı gizler; işlem hız sınırları uygulanır. İnsan incelemesi hizmeti sunulmaz.", "Anyone with the room link can claim an available role, up to four. The server checks role and cookie identity before returning private clues. Losing the cookie loses role access. Room text and chat are stored in a Cloudflare database accessible to its operator, without end-to-end encryption. No personal information, harassment, hate or spam. Three distinct-network reports hide a room; request limits apply. No human review service is provided.")</footer></div>
@code{
 [SupplyParameterFromQuery(Name="oda")]public string? RoomId{get;set;}
 RoomDetail? Current;string Title="",ExistingLink="",Answer="",Message="";int Scenario;
 static readonly (string Name,string Story)[] Scenarios=[("Son İstasyon","Gece treninin otomatik kapıları kapanmış. Kontrol masasındaki dört kart farklı görevlilere dağıtılmış. Sıra kartı rayların işaretlerini, iki anahtar kartı işaretlerin rakamlarını, dönüşüm kartı son anahtarlamayı biliyor. Dört bilgiyi ortak masada birleştirip kalkış kilidini açın."),("Deniz Feneri Arşivi","Fenerin eski arşiv odasında ışık bir kez daha yanmayı bekliyor. Arşivci sembollerin sırasını, iki bekçi kod anahtarlarının yarısını, gözcü ise son dönüşümü taşıyor. Her kartın bilgisi eksik; ışığı tek kişinin tahmini değil, ortak okuma geri getirecek."),("Kayıp Radyo Frekansı","Stüdyodaki sessizlik bir arıza değil, dört parçaya bölünmüş bir erişim bulmacası. Bir kart işaret sırasını tutuyor, iki kart işaretleri rakamlara çeviriyor, son kart dizinin nasıl döndürüleceğini biliyor. Yayını açmak için aynı kod üzerinde anlaşın."),("Gökyüzü Serası","Seranın koruma sistemi dört ayrı görevlinin bilgisini bekliyor. Bitkilerin etiketleri sırayı saklıyor; iki bakım kartı rakamları paylaşıyor; iklim kartı son dönüşümü açıklıyor. Serayı açacak dört haneli parola bütün kartların birlikte okunmasıyla oluşuyor."),("Saat Kulesinin Masası","Kulenin kapısında dört anahtar deliği yerine dört düşünce parçası var. Sıra ustası sembolleri okuyor, iki çırak anahtarları paylaşıyor, saatçi ise diziyi çeviriyor. Herkes kendi bilgisini açıkça anlattığında tek bir dört haneli sonuç elde edilebilir."),("Ay Haritası Odası","Hayalî gözlemevinin harita odası dört kişilik ekibi bekliyor. Haritacı sembol yolunu, iki araştırmacı sembollerin değerlerini, rota sorumlusu ise son dönüşümü taşıyor. Kartları ve sırayı karıştırmadan çözümü ortak masada kurun.")];
 static readonly (string Name,string Story)[] ScenarioEnglish=[("The Last Station","The night train doors are locked. Four control cards have been assigned to separate operators: the sequence, two halves of a symbol key, and a final transformation. Combine all four pieces at the team table to unlock departure."),("Lighthouse Archive","The old archive waits for the lighthouse beam. One keeper holds the symbol sequence, two hold different halves of the digit key, and the lookout holds the final transformation. Read them together to restore the light."),("The Missing Broadcast","The studio is silent behind a four-part access puzzle. One card holds the sequence, two map symbols to digits, and the last explains how to rotate the result. Agree on one code to open the broadcast."),("The Sky Greenhouse","The greenhouse awaits four operators: a sequence card, two maintenance keys and a final climate transformation. The four-digit password is determined by combining all cards in order."),("The Clock Tower Table","The tower has four pieces of knowledge instead of four keyholes. A sequence keeper reads symbols, two apprentices hold the key halves and a clockmaker rotates the resulting digits. Clear communication gives one final code."),("The Moon Map Room","The imaginary observatory awaits a four-person team. A cartographer knows the symbol path, two researchers hold symbol values, and a navigator holds the final transformation. Build the answer together without changing the order.")];
 /// <summary>Loads only an explicitly shared room; no public room directory is created.</summary>
 protected override Task OnParametersSetAsync()=>string.IsNullOrEmpty(RoomId)?Task.CompletedTask:ExecuteAsync(()=>LoadAsync(RoomId));
 /// <summary>Reads the current room with only this participant's private clue and permitted conversation.</summary>
 async Task LoadAsync(string id){Current=await ReadAsync<RoomDetail>("rooms/"+id);RoomId=id;await ReplaceAsync(Link());}
 /// <summary>Creates a solvable generated puzzle and claims the first role on the server.</summary>
 Task CreateAsync()=>ExecuteAsync(async()=>{var created=await WriteAsync<CreatedResponse>("rooms",new{title=Title,scenario=Scenario});await LoadAsync(created.Id);Title="";},T("Oda kuruldu. Bağlantıyı diğer üç rol için paylaş.","Room created. Share the link for the other three roles."));
 /// <summary>Claims one remaining role; the server enforces room capacity and identity uniqueness.</summary>
 Task JoinAsync()=>ExecuteAsync(async()=>{if(Current is null)return;Current=await WriteAsync<RoomDetail>($"rooms/{Current.Room.Id}/join",new{});});
 /// <summary>Refreshes actual role occupancy, chat and solve status.</summary>
 Task RefreshAsync()=>Current is null?Task.CompletedTask:ExecuteAsync(()=>LoadAsync(Current.Room.Id));
 /// <summary>Submits one authoritative solve attempt without returning the stored solution.</summary>
 Task AnswerAsync()=>ExecuteAsync(async()=>{if(Current is null)return;var result=await WriteAsync<AnswerResult>($"rooms/{Current.Room.Id}/answer",new{answer=Answer});Status=result.Solved?T("Kilit açıldı!", "The lock opened!"):T("Kod eşleşmedi. Sıra, sembol değerleri ve sola dönüşüm adımını birlikte kontrol edin.","The code did not match. Recheck the sequence, symbol values and left rotation together.");await LoadAsync(Current.Room.Id);});
 /// <summary>Sends a role-authorized team message and reads the resulting shared conversation.</summary>
 Task SendAsync()=>ExecuteAsync(async()=>{if(Current is null)return;Current=await WriteAsync<RoomDetail>($"rooms/{Current.Room.Id}/messages",new{message=Message});Message="";});
 /// <summary>Validates a pasted same-origin room link before opening it.</summary>
 Task OpenLinkAsync()=>ExecuteAsync(async()=>{var url=new Uri(ExistingLink,UriKind.Absolute);if(url.GetLeftPart(UriPartial.Authority)!=new Uri(Navigation.BaseUri).GetLeftPart(UriPartial.Authority))throw new InvalidOperationException("Foreign room origin.");var pair=url.Query.TrimStart('?').Split('&').Select(item=>item.Split('=',2)).FirstOrDefault(item=>item.Length==2&&item[0]=="oda");if(pair is null)throw new InvalidOperationException("Missing room identity.");await LoadAsync(Uri.UnescapeDataString(pair[1]));});
 /// <summary>Starts another room draft without deleting a previous room.</summary>
 async Task NewRoomAsync(){Current=null;RoomId=null;Answer=Message=Status="";CopyFallback=null;await ReplaceAsync(new Uri(new Uri(Navigation.BaseUri),"parola-ekibi/").AbsoluteUri);}
 /// <summary>Translates the public role label without exposing another card's values.</summary>
 string RoleName(int role)=>role switch{0=>T("Sıra sorumlusu", "Sequence keeper"),1=>T("Anahtar A", "Key A"),2=>T("Anahtar B", "Key B"),_=>T("Dönüşüm sorumlusu", "Transformation keeper")};
 /// <summary>Explains each role's public responsibility, excluding all generated secret values.</summary>
 string RoleDescription(int role)=>role switch{0=>T("Semboller hangi sırayla okunacak? Bu kart yalnız sırayı bilir.","In which order should symbols be read? This card knows only the order."),1=>T("İlk iki sembolün rakam karşılığını bilir.","Knows the digit values for the first two symbol types."),2=>T("Diğer iki sembolün rakam karşılığını bilir.","Knows the digit values for the other two symbol types."),_=>T("Ham diziyi son koda dönüştüren sola döndürme adımını bilir.","Knows the left-rotation step that transforms the raw sequence into the final code.")};
 /// <summary>Builds the independently usable unlisted room invite.</summary>
 string Link()=>ContentLink("parola-ekibi","oda",Current?.Room.Id??RoomId??"");
}
