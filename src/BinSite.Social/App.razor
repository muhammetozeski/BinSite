<ErrorBoundary>
    <ChildContent>
        <Router AppAssembly="@typeof(App).Assembly">
            <Found Context="routeData"><RouteView RouteData="routeData" /></Found>
            <NotFound><main class="route-message"><h1>Page not found</h1><a href="/">Product directory</a></main></NotFound>
        </Router>
    </ChildContent>
    <ErrorContent><main class="route-message"><h1>Page could not load</h1><p>Refresh the page to try again.</p><a href="/">Product directory</a></main></ErrorContent>
</ErrorBoundary>
